// Collections, repayments and inflows. SYNTHETIC SEEDS PENDING REVIEW BY PEOPLE (needs-people AI2). Never copy into a prompt.
{"id":"collect-mono-direct-debit","request":"On each loan's repayment date stored in Postgres, debit the borrower's Mono mandate for the instalment due and mark the instalment paid or overdue in the database.","expect":{"connectors":["postgres@1","mono@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["idempotency","bounded_concurrency"]},"tags":["collections","lending","database","schedule"],"difficulty":"hard"}
{"id":"collect-virtual-account-moniepoint","request":"When a customer is onboarded through our webhook, create a Moniepoint reserved account for them and send them the account number by SMS with Termii.","expect":{"connectors":["moniepoint@1","termii@1"],"steps":["connector"],"trigger":"webhook","properties":["webhook_auth","idempotency"]},"tags":["collections","onboarding","messaging"],"difficulty":"medium"}
{"id":"collect-remita-invoice","request":"For each new tuition invoice our school system posts, generate a Remita invoice (RRR) and email it to the parent, then update the invoice in MySQL with the RRR.","expect":{"connectors":["remita@1","gmail@1","mysql@1"],"steps":["connector"],"trigger":"webhook","properties":["webhook_auth"]},"tags":["collections","education","database"],"difficulty":"medium"}
{"id":"collect-remita-paid","request":"When Remita notifies us that an RRR has been paid, mark the matching invoice as paid in MySQL and send the payer a thank-you email.","expect":{"connectors":["remita@1","mysql@1","gmail@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["collections","education","database"],"difficulty":"easy"}
{"id":"collect-overdue-sms-ladder","request":"Every morning, find loans that are 1, 7 and 30 days overdue in Postgres and send each borrower an SMS with Africa's Talking whose tone gets firmer the later they are.","expect":{"connectors":["postgres@1","africastalking@1"],"steps":["foreach","branch","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["collections","lending","messaging","schedule"],"difficulty":"hard"}
{"id":"collect-opay-checkout-link","request":"When a sales rep creates an order in our CRM webhook, create an OPay cashier payment for the order total and WhatsApp the customer the checkout link with our approved payment-link template.","expect":{"connectors":["opay@1","whatsapp@1"],"steps":["connector"],"trigger":"webhook","properties":["webhook_auth"]},"tags":["collections","messaging","sales"],"difficulty":"medium"}
{"id":"collect-flutterwave-verify","request":"When Flutterwave reports a completed charge, verify it with Flutterwave before giving value, then credit the customer's balance in Postgres; ignore charges whose amount or currency does not match the order.","expect":{"connectors":["flutterwave@1","postgres@1"],"steps":["branch","connector"],"trigger":"connector_event","properties":["dedup"]},"tags":["collections","verification","database"],"difficulty":"hard"}
{"id":"collect-mandate-cancel","request":"When a borrower fully repays their loan according to our loan system's webhook, cancel their Mono direct debit mandate and email them a closure letter.","expect":{"connectors":["mono@1","gmail@1"],"steps":["connector"],"trigger":"webhook","properties":["webhook_auth"]},"tags":["collections","lending"],"difficulty":"easy"}
{"id":"collect-partial-payment","request":"When an Anchor inflow arrives into a customer's repayment account, apply it to their oldest unpaid instalment in Postgres, and if it covers less than the instalment, text them the balance still due.","expect":{"connectors":["anchor@1","postgres@1","termii@1"],"steps":["branch","connector"],"trigger":"connector_event"},"tags":["collections","lending","database"],"difficulty":"hard"}
{"id":"collect-mandate-balance-check","request":"Two days before each debit date, check whether the borrower's Mono-linked account has enough balance for the instalment, and if it does not, send them a WhatsApp reminder template to fund it.","expect":{"connectors":["mono@1","whatsapp@1"],"steps":["branch","connector"],"trigger":"schedule"},"tags":["collections","lending","messaging","schedule"],"difficulty":"hard"}
{"id":"collect-lenco-inflow-match","request":"When Lenco reports money received, match the narration to an open invoice in MySQL by invoice number; if found mark it paid, otherwise post the unmatched credit to the finance Slack channel.","expect":{"connectors":["lenco@1","mysql@1","slack@1"],"steps":["branch","connector"],"trigger":"connector_event"},"tags":["collections","reconciliation","database"],"difficulty":"hard"}
{"id":"collect-iswallet-credit-notify","request":"When iswallet credits a customer's wallet, send them a push through our notifications API and an SMS with Termii at the same time.","expect":{"connectors":["iswallet@1","termii@1"],"steps":["parallel","http","connector"],"trigger":"connector_event"},"tags":["collections","messaging"],"difficulty":"medium"}
{"id":"collect-rent-reminder","request":"Five days before rent is due each month, remind every tenant in the rent sheet by WhatsApp template, and on the due date text the ones who still have not paid.","expect":{"connectors":["googlesheets@1","whatsapp@1","termii@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["collections","property","messaging","schedule"],"difficulty":"hard"}
{"id":"collect-bank-transfer-opay","request":"Create an OPay bank transfer payment for each invoice our billing system sends, so the customer gets a one-time account to pay into, and store the account details on the invoice through our billing API.","expect":{"connectors":["opay@1"],"steps":["connector","http"],"trigger":"webhook","properties":["webhook_auth"]},"tags":["collections","billing"],"difficulty":"medium"}
{"id":"collect-esusu-contributions","request":"Every Saturday morning, read who has paid their weekly esusu contribution from the group's sheet and send a WhatsApp reminder template to members who have not.","expect":{"connectors":["googlesheets@1","whatsapp@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["collections","savings","messaging","schedule"],"difficulty":"medium"}
{"id":"collect-paystack-charge-ledger","request":"Record every successful Paystack charge in our Postgres ledger with the reference, amount in kobo, channel and customer email, exactly once per reference.","expect":{"connectors":["paystack@1","postgres@1"],"steps":["connector"],"trigger":"connector_event","properties":["dedup"]},"tags":["collections","database"],"difficulty":"easy"}
{"id":"collect-debt-recovery-escalation","request":"For loans 60 days overdue in Postgres, open a case with our recovery agency's API, and ask the head of collections to approve before we report the borrower to the credit bureau API.","expect":{"connectors":["postgres@1"],"steps":["foreach","http","approval"],"trigger":"schedule","properties":["approval_timeout","bounded_concurrency"]},"tags":["collections","lending","approval","schedule"],"difficulty":"hard"}
{"id":"collect-subscription-renewal","request":"On each subscriber's renewal date, charge their saved card through our billing API and, if it fails, email them a payment link with Gmail and retry the charge after 3 days.","expect":{"connectors":["gmail@1"],"steps":["http","branch","wait"],"trigger":"schedule"},"tags":["collections","subscriptions","wait"],"difficulty":"hard"}
{"id":"collect-airtime-airtime-status","request":"When Africa's Talking reports the status of an airtime top-up we sent as a loyalty reward, update the reward row in Postgres, and alert the growth team on Telegram if it failed.","expect":{"connectors":["africastalking@1","postgres@1","telegram@1"],"steps":["branch","connector"],"trigger":"connector_event"},"tags":["collections","rewards","database"],"difficulty":"medium"}
{"id":"collect-pos-settlement-check","request":"Every afternoon, compare yesterday's POS settlement from Moniepoint with our MySQL transactions and email finance the totals and any difference.","expect":{"connectors":["moniepoint@1","mysql@1","gmail@1"],"steps":["connector"],"trigger":"schedule"},"tags":["collections","reconciliation","reporting","schedule"],"difficulty":"medium"}
