// Notifications and alerting. SYNTHETIC SEEDS PENDING REVIEW BY PEOPLE (needs-people AI2). Never copy into a prompt.
{"id":"notify-large-inflow","request":"When Paystack confirms a charge of more than 2 million naira, post it to the treasury Slack channel with the customer email and reference.","expect":{"connectors":["paystack@1","slack@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["notifications","payments"],"difficulty":"easy"}
{"id":"notify-otp-delivery-failures","request":"When Africa's Talking reports an SMS delivery failure for an OTP, retry it through Termii and log both attempts in Postgres.","expect":{"connectors":["africastalking@1","termii@1","postgres@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["notifications","messaging","database"],"difficulty":"medium"}
{"id":"notify-sms-balance-low","request":"Every morning, check our Termii SMS balance and email the growth team if it is under 50,000 units.","expect":{"connectors":["termii@1","gmail@1"],"steps":["connector"],"trigger":"schedule"},"tags":["notifications","monitoring","schedule"],"difficulty":"easy"}
{"id":"notify-api-health","request":"Every 5 minutes, call our payments API health endpoint and alert the on-call engineer by SMS with Termii if it does not answer 200 twice in a row.","expect":{"connectors":["termii@1"],"steps":["http","branch","connector"],"trigger":"schedule","properties":["no_hardcoded_contacts"]},"tags":["notifications","monitoring","schedule"],"difficulty":"hard"}
{"id":"notify-dojah-wallet","request":"Every day check our Dojah wallet balance and post to Slack when it falls below 100,000 naira so KYC checks do not stop.","expect":{"connectors":["dojah@1","slack@1"],"steps":["connector"],"trigger":"schedule"},"tags":["notifications","kyc","schedule"],"difficulty":"easy"}
{"id":"notify-prembly-wallet","request":"Each morning check the Prembly wallet balance and the Africa's Talking balance and send one combined Telegram message to the ops group.","expect":{"connectors":["prembly@1","africastalking@1","telegram@1"],"steps":["connector"],"trigger":"schedule"},"tags":["notifications","monitoring","schedule"],"difficulty":"medium"}
{"id":"notify-transfer-success-sms","request":"When a Paystack transfer succeeds, text the beneficiary a confirmation with the amount and our reference using Africa's Talking.","expect":{"connectors":["paystack@1","africastalking@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["notifications","payouts","messaging"],"difficulty":"easy"}
{"id":"notify-new-loan-application","request":"Whenever our app sends a new loan application to the webhook, post the applicant's requested amount and tenor to the credit team's Slack channel and add a row to the applications sheet.","expect":{"connectors":["slack@1","googlesheets@1"],"steps":["connector"],"trigger":"webhook","properties":["webhook_auth"]},"tags":["notifications","lending","productivity"],"difficulty":"easy"}
{"id":"notify-telegram-commands","request":"When someone sends /balance to our ops Telegram bot, reply with the current Paystack and Flutterwave balances.","expect":{"connectors":["telegram@1","paystack@1","flutterwave@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["notifications","chatops"],"difficulty":"medium"}
{"id":"notify-slack-reaction-approve","request":"Post each pending manual payout to Slack and treat a white_check_mark reaction from a finance lead as the approval to pay it with Lenco.","expect":{"connectors":["slack@1","lenco@1"],"steps":["signal","connector"],"properties":["idempotency"]},"tags":["notifications","chatops","payouts"],"difficulty":"hard"}
{"id":"notify-email-digest-failed-runs","request":"Every weekday at 5pm, email the operations manager a list of today's failed transfers from MySQL with their reasons.","expect":{"connectors":["mysql@1","gmail@1"],"steps":["connector"],"trigger":"schedule"},"tags":["notifications","reporting","schedule"],"difficulty":"easy"}
{"id":"notify-merchant-settlement-email","request":"After each merchant settlement transfer completes on Flutterwave, email the merchant a settlement advice with the amount, fee and date.","expect":{"connectors":["flutterwave@1","gmail@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["notifications","payouts"],"difficulty":"easy"}
{"id":"notify-whatsapp-delivery-status","request":"When WhatsApp reports that one of our template messages failed to deliver, fall back to an SMS with the same text via Termii.","expect":{"connectors":["whatsapp@1","termii@1"],"steps":["branch","connector"],"trigger":"connector_event"},"tags":["notifications","messaging"],"difficulty":"medium"}
{"id":"notify-fx-rate-change","request":"Every hour, fetch the USD/NGN rate from our pricing API and post to Slack if it has moved more than 2% since the last value stored in Postgres, then store the new value.","expect":{"connectors":["postgres@1","slack@1"],"steps":["http","branch","connector"],"trigger":"schedule"},"tags":["notifications","fx","schedule","database"],"difficulty":"hard"}
{"id":"notify-reversal-customer","request":"When Anchor reports a transfer reversal, tell the customer by SMS that the money is back in their account and post the reversal to Slack.","expect":{"connectors":["anchor@1","termii@1","slack@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["notifications","payouts"],"difficulty":"easy"}
{"id":"notify-birthday-voucher","request":"Every morning, send a birthday SMS with a discount code to customers whose birthday is today according to our MySQL customers table.","expect":{"connectors":["mysql@1","termii@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["notifications","marketing","schedule"],"difficulty":"medium"}
{"id":"notify-incoming-sms-keyword","request":"When a customer texts BAL to our Africa's Talking shortcode, look up their wallet balance in Postgres and reply by SMS.","expect":{"connectors":["africastalking@1","postgres@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["notifications","messaging","database"],"difficulty":"medium"}
{"id":"notify-s3-upload-ready","request":"When our reporting job posts that a monthly statement has been generated, create a presigned S3 link valid for 24 hours and email it to the customer.","expect":{"connectors":["s3@1","gmail@1"],"steps":["connector"],"trigger":"webhook","properties":["webhook_auth"]},"tags":["notifications","storage"],"difficulty":"medium"}
{"id":"notify-gmail-label-forward","request":"Every 10 minutes, check the support mailbox for unread emails labelled chargeback, post each one's subject to the disputes Slack channel and mark it read.","expect":{"connectors":["gmail@1","slack@1"],"steps":["foreach","connector"],"properties":["bounded_concurrency"]},"tags":["notifications","support"],"difficulty":"medium"}
{"id":"notify-mono-reauth","request":"When Mono tells us a customer's account connection needs reauthorisation, start a reauthorisation and send the customer the link by email.","expect":{"connectors":["mono@1","gmail@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["notifications","open_banking"],"difficulty":"medium"}
