// Reconciliation and settlement. SYNTHETIC SEEDS PENDING REVIEW BY PEOPLE (needs-people AI2). Never copy into a prompt.
{"id":"recon-paystack-pending","request":"Every 30 minutes, take Paystack transfers our Postgres payouts table still shows as pending after an hour, verify each with Paystack and update the row to success, failed or reversed.","expect":{"connectors":["postgres@1","paystack@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["reconciliation","payouts","database","schedule"],"difficulty":"hard"}
{"id":"recon-flutterwave-by-reference","request":"Every hour, for each Flutterwave transfer in MySQL without a final status, look it up by reference with Flutterwave and record the final status and fee.","expect":{"connectors":["mysql@1","flutterwave@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["reconciliation","payouts","database","schedule"],"difficulty":"medium"}
{"id":"recon-sftp-bank-statement","request":"Each morning, download yesterday's bank statement CSV from the bank's SFTP server, parse it in a code step, and insert any credits we have not recorded into Postgres.","expect":{"connectors":["sftp@1","postgres@1"],"steps":["code","connector"],"trigger":"schedule"},"tags":["reconciliation","storage","code","schedule"],"difficulty":"hard"}
{"id":"recon-settlement-archive","request":"Every night, copy the settlement files in the bank's SFTP outbox to our S3 bucket under the date, then move them to an archive folder on the SFTP server.","expect":{"connectors":["sftp@1","s3@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["reconciliation","storage","schedule"],"difficulty":"medium"}
{"id":"recon-wallet-vs-ledger","request":"Every day at 1am, compare each iswallet wallet balance with the balance in our Postgres ledger and post any wallets that differ to the reconciliation Slack channel.","expect":{"connectors":["iswallet@1","postgres@1","slack@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["reconciliation","wallets","database","schedule"],"difficulty":"hard"}
{"id":"recon-anchor-transfer-status","request":"When Anchor reports a NIP transfer as failed or reversed, look up the transfer by its reference, mark the payout failed in Postgres and refund the customer's wallet balance there.","expect":{"connectors":["anchor@1","postgres@1"],"steps":["connector"],"trigger":"connector_event","properties":["dedup"]},"tags":["reconciliation","payouts","database"],"difficulty":"medium"}
{"id":"recon-interswitch-unknown","request":"When an Interswitch transfer times out in our payouts service webhook, check Interswitch for the transfer; if it succeeded mark it paid, if it is not found mark it safe to retry, and otherwise ask an operations lead to decide.","expect":{"connectors":["interswitch@1"],"steps":["branch","approval","connector"],"trigger":"webhook","properties":["webhook_auth"]},"tags":["reconciliation","payouts","approval"],"difficulty":"hard"}
{"id":"recon-daily-summary-email","request":"At 7am every day, total yesterday's successful, failed and pending payouts from MySQL and email the summary to the finance mailing list with Gmail.","expect":{"connectors":["mysql@1","gmail@1"],"steps":["connector"],"trigger":"schedule"},"tags":["reconciliation","reporting","schedule"],"difficulty":"easy"}
{"id":"recon-remita-bulk-status","request":"Six hours after we submit a Remita bulk transfer, check the batch status and post a count of successful and failed items to Slack, listing the failed beneficiaries.","expect":{"connectors":["remita@1","slack@1"],"steps":["wait","connector"]},"tags":["reconciliation","payouts","wait"],"difficulty":"medium"}
{"id":"recon-moniepoint-disbursement-events","request":"When Moniepoint reports a disbursement as failed or reversed, update the payout row in MySQL and text the operations lead with Termii.","expect":{"connectors":["moniepoint@1","mysql@1","termii@1"],"steps":["connector"],"trigger":"connector_event","properties":["no_hardcoded_contacts"]},"tags":["reconciliation","payouts","database"],"difficulty":"easy"}
{"id":"recon-breet-withdrawal-check","request":"Every 20 minutes, check Breet withdrawals our MySQL table marks as processing and update them to completed or failed; alert Telegram for any stuck longer than 2 hours.","expect":{"connectors":["mysql@1","breet@1","telegram@1"],"steps":["foreach","branch","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["reconciliation","crypto","database","schedule"],"difficulty":"hard"}
{"id":"recon-lenco-statement-sheet","request":"Every Monday, pull the past week's Lenco transfers for our main account and append them to the finance Google Sheet.","expect":{"connectors":["lenco@1","googlesheets@1"],"steps":["connector"],"trigger":"schedule"},"tags":["reconciliation","reporting","schedule","productivity"],"difficulty":"medium"}
{"id":"recon-mono-statement-pdf","request":"When a customer finishes linking their account with Mono, request their 12-month statement PDF and save it to S3 under the customer's id.","expect":{"connectors":["mono@1","s3@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["reconciliation","open_banking","storage"],"difficulty":"medium"}
{"id":"recon-duplicate-credit-guard","request":"When iswallet sends a credit event, check Postgres for an earlier credit with the same reference; if it is a duplicate, open a Slack alert instead of crediting the user again.","expect":{"connectors":["iswallet@1","postgres@1","slack@1"],"steps":["branch","connector"],"trigger":"connector_event","properties":["dedup"]},"tags":["reconciliation","wallets","database"],"difficulty":"medium"}
{"id":"recon-opay-payment-status","request":"For OPay payments created more than 30 minutes ago and still pending in Postgres, query OPay every 15 minutes and close the ones OPay reports as failed or expired.","expect":{"connectors":["postgres@1","opay@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["reconciliation","collections","database","schedule"],"difficulty":"hard"}
{"id":"recon-gl-export","request":"At month end, export all payouts and collections from Postgres as a CSV through a code step, upload it to S3, and email the finance controller a presigned link.","expect":{"connectors":["postgres@1","s3@1","gmail@1"],"steps":["code","connector"],"trigger":"schedule"},"tags":["reconciliation","reporting","storage","schedule"],"difficulty":"hard"}
{"id":"recon-fee-audit","request":"Every Friday, check the Flutterwave transfer fee for each payout band and post to Slack if any fee differs from the fee in our pricing sheet.","expect":{"connectors":["flutterwave@1","googlesheets@1","slack@1"],"steps":["foreach","connector"],"trigger":"schedule"},"tags":["reconciliation","pricing","schedule"],"difficulty":"hard"}
{"id":"recon-chargeback-hold","request":"When Paystack reports a charge that our risk API flags as disputed, freeze the customer's account through our core banking API and wait for a fraud analyst's decision before unfreezing it.","expect":{"connectors":["paystack@1"],"steps":["http","approval"],"trigger":"connector_event","properties":["approval_timeout"]},"tags":["reconciliation","fraud","approval"],"difficulty":"hard"}
