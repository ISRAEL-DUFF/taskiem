// WhatsApp, SMS and chat. SYNTHETIC SEEDS PENDING REVIEW BY PEOPLE (needs-people AI2). Never copy into a prompt.
{"id":"msg-whatsapp-inbound-balance","request":"When a customer sends 'balance' to our WhatsApp Business number, look up their wallet by phone in Postgres and reply with the balance as a WhatsApp text.","expect":{"connectors":["whatsapp@1","postgres@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["messaging","whatsapp","database"],"difficulty":"medium"}
{"id":"msg-whatsapp-interactive-menu","request":"When someone messages our WhatsApp number for the first time, send them an interactive list with options for account opening, loans and support, and log the conversation in the support sheet.","expect":{"connectors":["whatsapp@1","googlesheets@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["messaging","whatsapp","support"],"difficulty":"medium"}
{"id":"msg-sms-bulk-promo","request":"Send a promotional SMS through Africa's Talking to every customer in the campaign sheet who opted in to marketing, in batches, and record the message cost back in the sheet.","expect":{"connectors":["googlesheets@1","africastalking@1"],"steps":["foreach","connector"],"properties":["bounded_concurrency"]},"tags":["messaging","marketing","productivity"],"difficulty":"hard"}
{"id":"msg-telegram-document","request":"When the daily settlement PDF lands in our S3 bucket, send it as a document to the finance Telegram group.","expect":{"connectors":["s3@1","telegram@1"],"steps":["connector"]},"tags":["messaging","telegram","storage"],"difficulty":"medium"}
{"id":"msg-slack-ephemeral","request":"When a support agent runs our /lookup command in Slack with a transaction reference, find the transaction in MySQL and show it only to that agent.","expect":{"connectors":["slack@1","mysql@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["messaging","slack","support","database"],"difficulty":"medium"}
{"id":"msg-whatsapp-media-receipt","request":"After a successful Flutterwave payment, generate a receipt PDF through our documents API and send it to the customer on WhatsApp as a document message.","expect":{"connectors":["flutterwave@1","whatsapp@1"],"steps":["http","connector"],"trigger":"connector_event"},"tags":["messaging","whatsapp","payments"],"difficulty":"medium"}
{"id":"msg-otp-fallback","request":"Send login OTPs by WhatsApp template first; if WhatsApp does not accept the message, send the same code by SMS through Termii.","expect":{"connectors":["whatsapp@1","termii@1"],"steps":["connector"],"properties":["error_handling"]},"tags":["messaging","otp","fallback"],"difficulty":"medium"}
{"id":"msg-mark-read-and-route","request":"When a WhatsApp message arrives on the support number, mark it as read, then post it to the support Slack channel with the sender's masked number.","expect":{"connectors":["whatsapp@1","slack@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["messaging","whatsapp","support"],"difficulty":"easy"}
{"id":"msg-telegram-edit-status","request":"Post each large transfer to the treasury Telegram channel when it starts, then edit the same message to show success or failure when the Lenco transfer finishes.","expect":{"connectors":["telegram@1","lenco@1"],"steps":["connector"]},"tags":["messaging","telegram","payouts"],"difficulty":"hard"}
{"id":"msg-sms-two-way-confirm","request":"Text a customer through Africa's Talking asking them to reply YES to confirm a 500,000 naira transfer, wait up to 15 minutes for their reply, and only then send the money with Paystack.","expect":{"connectors":["africastalking@1","paystack@1"],"steps":["signal","connector"],"properties":["idempotency"]},"tags":["messaging","payouts","confirmation"],"difficulty":"hard"}
{"id":"msg-whatsapp-template-campaign","request":"Every Thursday at 10am, send our approved weekly-savings-tip WhatsApp template to every subscriber in Postgres, no more than 20 at a time.","expect":{"connectors":["postgres@1","whatsapp@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["messaging","whatsapp","marketing","schedule"],"difficulty":"medium"}
{"id":"msg-email-draft-for-review","request":"When a dispute is opened in our dispute webhook, prepare a Gmail draft response to the customer for an agent to review rather than sending it.","expect":{"connectors":["gmail@1"],"steps":["connector"],"trigger":"webhook","properties":["webhook_auth"]},"tags":["messaging","email","support"],"difficulty":"easy"}
{"id":"msg-slack-update-thread","request":"Post a message to Slack when a bulk payout starts and reply in the same thread every time a batch of 50 completes.","expect":{"connectors":["slack@1"],"steps":["foreach","connector"]},"tags":["messaging","slack","payouts"],"difficulty":"hard"}
{"id":"msg-telegram-webhook-setup","request":"Set the webhook for our Telegram bot to the address Taskiem gives this workflow, then send a test message to the ops group.","expect":{"connectors":["telegram@1"],"steps":["connector"],"trigger":"manual"},"tags":["messaging","telegram","setup"],"difficulty":"easy"}
{"id":"msg-sms-sender-id-by-brand","request":"Our two brands use different SMS sender IDs: when our app sends a notification request, send it with Termii using the sender ID for the brand named in the request.","expect":{"connectors":["termii@1"],"steps":["connector"],"trigger":"webhook","properties":["webhook_auth","inputs_declared"]},"tags":["messaging","sms"],"difficulty":"medium"}
{"id":"msg-whatsapp-reply-to","request":"When a customer replies STOP to any of our WhatsApp messages, unsubscribe them in MySQL and reply quoting their message to confirm.","expect":{"connectors":["whatsapp@1","mysql@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["messaging","whatsapp","consent"],"difficulty":"medium"}
