// KYC, identity and compliance. SYNTHETIC SEEDS PENDING REVIEW BY PEOPLE (needs-people AI2). Never copy into a prompt.
{"id":"kyc-tier1-bvn-phone","request":"When a user upgrades to tier 1 in our app, look up their BVN with Prembly and check that the phone number on the BVN matches the one they registered; tell our app the result through its callback API.","expect":{"connectors":["prembly@1"],"steps":["connector","http"],"trigger":"webhook","properties":["webhook_auth","inputs_declared"]},"tags":["kyc","identity"],"difficulty":"medium"}
{"id":"kyc-tier2-nin-face","request":"For tier 2 upgrades, verify the user's NIN with a selfie through Prembly's face match; if the confidence is below 80, send the case to a compliance analyst to approve or reject.","expect":{"connectors":["prembly@1"],"steps":["branch","approval","connector"],"trigger":"webhook","properties":["webhook_auth","approval_timeout"]},"tags":["kyc","identity","approval"],"difficulty":"hard"}
{"id":"kyc-business-cac","request":"When a merchant registers, look up their CAC registration number with Prembly and store the company name and status in Postgres; flag mismatched names to the onboarding team on Slack.","expect":{"connectors":["prembly@1","postgres@1","slack@1"],"steps":["branch","connector"],"trigger":"webhook","properties":["webhook_auth"]},"tags":["kyc","business","database"],"difficulty":"medium"}
{"id":"kyc-youverify-address","request":"After a customer submits their home address, request an address verification from Youverify and, when Youverify reports the outcome, update the customer's KYC record in MySQL.","expect":{"connectors":["youverify@1","mysql@1"],"steps":["connector"],"trigger":"webhook"},"tags":["kyc","identity","database"],"difficulty":"hard"}
{"id":"kyc-aml-batch-rescreen","request":"Every Sunday night, re-screen all active business customers from Postgres against AML lists with Youverify, five at a time, and email compliance a list of new hits.","expect":{"connectors":["postgres@1","youverify@1","gmail@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["kyc","compliance","schedule","database"],"difficulty":"hard"}
{"id":"kyc-drivers-license","request":"Verify a rider's driver's licence with Prembly when our fleet app submits it, and approve the rider automatically only if the licence is valid and the names match.","expect":{"connectors":["prembly@1"],"steps":["branch","connector"],"trigger":"webhook","properties":["webhook_auth"]},"tags":["kyc","identity","mobility"],"difficulty":"medium"}
{"id":"kyc-account-name-match","request":"When a customer adds a withdrawal bank account, resolve it with Youverify and only save it to our database if the account name matches the customer's BVN name; otherwise send them an in-app message through our API.","expect":{"connectors":["youverify@1","postgres@1"],"steps":["branch","connector","http"],"trigger":"webhook"},"tags":["kyc","payouts","database"],"difficulty":"hard"}
{"id":"kyc-dojah-nin-lookup","request":"Look up a customer's NIN with Dojah when our onboarding form calls the webhook, and save the returned date of birth and gender to the customer profile through our API.","expect":{"connectors":["dojah@1"],"steps":["connector","http"],"trigger":"webhook","properties":["webhook_auth"]},"tags":["kyc","identity"],"difficulty":"easy"}
{"id":"kyc-liveness-retry","request":"Run a Prembly liveness check on the selfie a user uploads; if it fails, ask them to try again by SMS, and after three failures escalate to a compliance officer.","expect":{"connectors":["prembly@1","termii@1"],"steps":["branch","connector","approval"]},"tags":["kyc","identity","messaging","approval"],"difficulty":"hard"}
{"id":"kyc-voters-card-fallback","request":"If a customer has no NIN, verify their voter's card with Prembly instead, and if that also fails, put them on manual review for a KYC officer.","expect":{"connectors":["prembly@1"],"steps":["branch","approval","connector"],"properties":["approval_timeout"]},"tags":["kyc","identity","approval"],"difficulty":"hard"}
{"id":"kyc-pep-hit-hold","request":"When Youverify's AML check for a new account returns a politically exposed person hit, block withdrawals on the account through our core API and get the MLRO to approve before lifting the block.","expect":{"connectors":["youverify@1"],"steps":["http","approval"],"properties":["approval_timeout"]},"tags":["kyc","compliance","approval"],"difficulty":"hard"}
{"id":"kyc-income-verification","request":"When a loan applicant links their account, request their income estimate from Mono and, when it is ready, store it in Postgres and notify underwriting on Slack.","expect":{"connectors":["mono@1","postgres@1","slack@1"],"steps":["connector"],"trigger":"connector_event"},"tags":["kyc","lending","open_banking"],"difficulty":"medium"}
{"id":"kyc-creditworthiness","request":"For loan applications above 1 million naira, request a creditworthiness check through Mono and route the application to a senior credit officer for approval with the result attached.","expect":{"connectors":["mono@1"],"steps":["branch","approval","connector"],"trigger":"webhook","properties":["approval_timeout","webhook_auth"]},"tags":["kyc","lending","approval"],"difficulty":"hard"}
{"id":"kyc-expiry-reminder","request":"Every month, find customers in MySQL whose ID documents expire within 30 days and email each of them a reminder to update their documents.","expect":{"connectors":["mysql@1","gmail@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["kyc","compliance","schedule"],"difficulty":"medium"}
{"id":"kyc-phone-lookup-fraud","request":"Before approving a new device login, look up the phone number with Prembly and if the registered name does not match the account holder, alert the fraud team on Telegram.","expect":{"connectors":["prembly@1","telegram@1"],"steps":["branch","connector"]},"tags":["kyc","fraud"],"difficulty":"medium"}
{"id":"kyc-passport-diaspora","request":"For diaspora customers who sign up with an international passport, verify it with Prembly and send them a WhatsApp template welcoming them when it passes.","expect":{"connectors":["prembly@1","whatsapp@1"],"steps":["branch","connector"],"trigger":"webhook"},"tags":["kyc","identity","messaging"],"difficulty":"medium"}
{"id":"kyc-business-search","request":"When a corporate client is onboarded, search Youverify for their business by name and registration number, fetch the business details, and save the directors list to Postgres.","expect":{"connectors":["youverify@1","postgres@1"],"steps":["connector"],"trigger":"webhook"},"tags":["kyc","business","database"],"difficulty":"medium"}
{"id":"kyc-prembly-webhook","request":"When Prembly calls back with a verification result, update the verification row in Postgres and, for NOT-VERIFIED results, text the customer to resubmit their details.","expect":{"connectors":["prembly@1","postgres@1","termii@1"],"steps":["branch","connector"],"trigger":"connector_event"},"tags":["kyc","identity","database"],"difficulty":"medium"}
