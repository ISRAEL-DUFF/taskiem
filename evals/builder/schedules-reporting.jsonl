// Schedules, sheets and email reporting. SYNTHETIC SEEDS PENDING REVIEW BY PEOPLE (needs-people AI2). Never copy into a prompt.
{"id":"report-weekly-kpi-sheet","request":"Every Monday at 9am, count last week's sign-ups, active wallets and transaction volume from Postgres and append them as a new row in the KPI Google Sheet.","expect":{"connectors":["postgres@1","googlesheets@1"],"steps":["connector"],"trigger":"schedule"},"tags":["reporting","schedule","database","productivity"],"difficulty":"medium"}
{"id":"report-monthly-board-email","request":"On the 2nd of every month, pull last month's revenue, payouts and outstanding loans from MySQL and email a board summary to the CEO and CFO.","expect":{"connectors":["mysql@1","gmail@1"],"steps":["connector"],"trigger":"schedule","properties":["no_hardcoded_contacts"]},"tags":["reporting","schedule","database"],"difficulty":"medium"}
{"id":"report-daily-balances-all","request":"Every weekday at 8am, get balances from Paystack, Flutterwave, Moniepoint and Lenco at the same time and post one message with all four to the treasury Slack channel.","expect":{"connectors":["paystack@1","flutterwave@1","moniepoint@1","lenco@1","slack@1"],"steps":["parallel","connector"],"trigger":"schedule"},"tags":["reporting","treasury","schedule"],"difficulty":"hard"}
{"id":"report-sheet-to-db-sync","request":"Every night, read the branch targets sheet and upsert each row into the targets table in Postgres.","expect":{"connectors":["googlesheets@1","postgres@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["reporting","sync","schedule","database"],"difficulty":"medium"}
{"id":"report-db-to-sheet-export","request":"Every hour, copy new loan applications from MySQL into the credit team's Google Sheet so they can review them without database access.","expect":{"connectors":["mysql@1","googlesheets@1"],"steps":["connector"],"trigger":"schedule"},"tags":["reporting","sync","schedule","database"],"difficulty":"medium"}
{"id":"report-quarterly-tax-file","request":"At the end of each quarter, build the withholding tax schedule from Postgres in a code step, upload it to S3, and email the tax consultant the link.","expect":{"connectors":["postgres@1","s3@1","gmail@1"],"steps":["code","connector"],"trigger":"schedule"},"tags":["reporting","tax","schedule","storage"],"difficulty":"hard"}
{"id":"report-new-sheet-per-month","request":"On the first day of each month, create a new tab in the collections spreadsheet named after the month and write the header row.","expect":{"connectors":["googlesheets@1"],"steps":["connector"],"trigger":"schedule"},"tags":["reporting","productivity","schedule"],"difficulty":"easy"}
{"id":"report-failed-kyc-weekly","request":"Every Friday, email the compliance lead a list of KYC verifications that failed this week from our Postgres verifications table.","expect":{"connectors":["postgres@1","gmail@1"],"steps":["connector"],"trigger":"schedule"},"tags":["reporting","kyc","schedule"],"difficulty":"easy"}
{"id":"report-cohort-code","request":"Every Sunday, compute 30-day retention by sign-up week from Postgres in a Python code step and post the table to the growth Slack channel.","expect":{"connectors":["postgres@1","slack@1"],"steps":["code","connector"],"trigger":"schedule"},"tags":["reporting","analytics","code","schedule"],"difficulty":"hard"}
{"id":"report-agent-leaderboard","request":"Every evening, rank POS agents by today's transaction count from MySQL and send the top ten to the agent network's Telegram group.","expect":{"connectors":["mysql@1","telegram@1"],"steps":["connector"],"trigger":"schedule"},"tags":["reporting","agents","schedule"],"difficulty":"medium"}
{"id":"report-inbox-attachments-s3","request":"Every 30 minutes, save attachments from new emails in the settlements mailbox to S3 and label the emails as processed.","expect":{"connectors":["gmail@1","s3@1"],"steps":["foreach","connector"],"properties":["bounded_concurrency"]},"tags":["reporting","storage","email"],"difficulty":"hard"}
{"id":"report-sftp-upload-nibss","request":"Every weekday at 3pm, generate the day's mandate file from Postgres in a code step and upload it to our partner bank's SFTP server.","expect":{"connectors":["postgres@1","sftp@1"],"steps":["code","connector"],"trigger":"schedule"},"tags":["reporting","banking","schedule","storage"],"difficulty":"hard"}
{"id":"report-delete-old-exports","request":"Every Sunday, delete report exports older than 90 days from our S3 bucket and post how many were removed to Slack.","expect":{"connectors":["s3@1","slack@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["reporting","storage","retention","schedule"],"difficulty":"medium"}
{"id":"report-month-end-close","request":"On the last working day of the month at 5pm, freeze the month's ledger through our accounting API, export trial balance to the finance sheet, and email the controller when both are done.","expect":{"connectors":["googlesheets@1","gmail@1"],"steps":["http","connector"],"trigger":"schedule"},"tags":["reporting","accounting","schedule"],"difficulty":"hard"}
{"id":"report-email-on-demand","request":"Let a finance analyst start a report run by entering a start and end date, then email them the total payouts and collections for that range from MySQL.","expect":{"connectors":["mysql@1","gmail@1"],"steps":["connector"],"trigger":"manual","properties":["inputs_declared"]},"tags":["reporting","on_demand"],"difficulty":"easy"}
{"id":"report-merchant-statements","request":"On the 1st of each month, for every active merchant in Postgres, build their statement in a code step and email it to them, at most 10 merchants at a time.","expect":{"connectors":["postgres@1","gmail@1"],"steps":["foreach","code","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["reporting","merchants","schedule"],"difficulty":"hard"}
{"id":"report-dormant-accounts","request":"Every quarter, find wallets with no activity for 180 days in Postgres, mark them dormant, and email the compliance team the count.","expect":{"connectors":["postgres@1","gmail@1"],"steps":["connector"],"trigger":"schedule"},"tags":["reporting","compliance","schedule"],"difficulty":"medium"}
{"id":"report-cbn-returns-reminder","request":"Remind the regulatory reporting team on Slack at 9am on the 5th of every month that the monthly CBN returns are due on the 10th.","expect":{"connectors":["slack@1"],"steps":["connector"],"trigger":"schedule"},"tags":["reporting","compliance","schedule"],"difficulty":"easy"}
{"id":"report-sales-pipeline-sheet","request":"When our CRM webhook says a deal is won, add it to the sales sheet and post the deal value to the sales Telegram group.","expect":{"connectors":["googlesheets@1","telegram@1"],"steps":["connector"],"trigger":"webhook","properties":["webhook_auth"]},"tags":["reporting","sales"],"difficulty":"easy"}
{"id":"report-weekly-fx-exposure","request":"Every Friday at noon, sum our dollar receivables and payables from MySQL, fetch the current rate from our FX provider's API, and email the CFO the naira exposure.","expect":{"connectors":["mysql@1","gmail@1"],"steps":["http","connector"],"trigger":"schedule"},"tags":["reporting","fx","schedule"],"difficulty":"medium"}
{"id":"report-clear-staging-sheet","request":"Every night after the import finishes, clear the staging range of the imports sheet so the next day's data starts clean.","expect":{"connectors":["googlesheets@1"],"steps":["connector"],"trigger":"schedule"},"tags":["reporting","productivity","schedule"],"difficulty":"easy"}
{"id":"report-loan-book-snapshot","request":"Every night at midnight, snapshot the loan book from MySQL to a dated CSV in S3 via a code step, and alert the data team on Slack if the export fails.","expect":{"connectors":["mysql@1","s3@1","slack@1"],"steps":["code","connector"],"trigger":"schedule","properties":["error_handling"]},"tags":["reporting","lending","storage","schedule"],"difficulty":"hard"}
