// Templates composed as steps of one workflow (decision 0047): two- and three-template goals, and a template with steps of its own around it. SYNTHETIC SEEDS PENDING REVIEW BY PEOPLE (needs-people AI2). Never copy into a prompt.
{"id":"compose-salaries-then-vendors","request":"On the 25th, pay my staff their salaries, and then pay the vendors on our list for that month from the same account.","expect":{"templates":["run-payroll","pay-a-list"],"steps":["template"],"trigger":"schedule","properties":["approval_before_payment","idempotency"]},"tags":["composition","payroll","payouts"],"difficulty":"hard"}
{"id":"compose-invoice-then-subcontractors","request":"Bill Kemi Interiors 1.2 million naira for the fit-out, and once she has paid, pay the subcontractors listed for that job.","expect":{"templates":["send-invoice","pay-a-list"],"steps":["template"],"properties":["approval_before_payment"]},"tags":["composition","invoices","payouts"],"difficulty":"hard"}
{"id":"compose-payrolla-record-and-summary","request":"When Payrolla finishes paying everyone, keep a record of the payroll for our accountant and then message me how many were paid and who was missed.","expect":{"templates":["payrolla-payroll-summary","payrolla-record-payroll"],"steps":["template"],"trigger":"connector_event","properties":["no_payment_with_product"]},"tags":["composition","products","payroll"],"difficulty":"medium"}
{"id":"compose-three-month-end","request":"At month end run payroll, then settle the suppliers on our payee list, then invoice Ojo Logistics 450,000 naira for the shared warehouse costs.","expect":{"templates":["run-payroll","pay-a-list","send-invoice"],"steps":["template"],"properties":["approval_before_payment","idempotency"]},"tags":["composition","payroll","invoices"],"difficulty":"hard"}
{"id":"compose-payroll-then-invoice-client","request":"After salaries go out each month, send an invoice to Bayo Stores for the staff costs they share with us, 300,000 naira.","expect":{"templates":["run-payroll","send-invoice"],"steps":["template"],"properties":["approval_before_payment"]},"tags":["composition","payroll","invoices"],"difficulty":"medium"}
{"id":"compose-commissions-then-invoice","request":"Pay this week's commission batch to our agents, then invoice Zenith Mart for their share of the commissions.","expect":{"templates":["pay-a-list","send-invoice"],"steps":["template"],"properties":["approval_before_payment","idempotency"]},"tags":["composition","payouts","invoices"],"difficulty":"medium"}
{"id":"compose-deposit-then-balance","request":"Invoice Ada for the 50% deposit on her order, and when that is paid, invoice her for the balance.","expect":{"templates":["send-invoice"],"steps":["template"]},"tags":["composition","invoices"],"difficulty":"medium"}
{"id":"compose-refund-list-then-tell","request":"Pay out the refunds in our refunds table for batch R-12 after I approve them, and then text the operations manager how many failed.","expect":{"templates":["pay-a-list"],"steps":["template"],"properties":["approval_before_payment"]},"tags":["composition","payouts","notifications"],"difficulty":"medium"}
{"id":"compose-payroll-then-email-accountant","request":"Run payroll on the 28th and afterwards email the totals and fees to our accountant.","expect":{"templates":["run-payroll"],"steps":["template"],"trigger":"schedule","properties":["approval_before_payment","no_hardcoded_contacts"]},"tags":["composition","payroll","reporting"],"difficulty":"medium"}
{"id":"compose-payrolla-summary-only-step","request":"Once Payrolla completes a run, tell me who was not paid, and then post the same summary in the finance WhatsApp group.","expect":{"templates":["payrolla-payroll-summary"],"steps":["template"],"trigger":"connector_event","properties":["no_payment_with_product"]},"tags":["composition","products","messaging"],"difficulty":"medium"}
{"id":"compose-two-invoices-two-customers","request":"Send an invoice to Chidi for 80,000 naira and another to Funke for 120,000 naira for the catering, and let me know when both are paid.","expect":{"templates":["send-invoice"],"steps":["template"]},"tags":["composition","invoices"],"difficulty":"easy"}
{"id":"compose-vendors-then-payroll-check","request":"Pay the vendors in the payees table for batch April, then run the staff payroll, then tell me both totals in one message.","expect":{"templates":["pay-a-list","run-payroll"],"steps":["template"],"properties":["approval_before_payment","idempotency"]},"tags":["composition","payouts","payroll"],"difficulty":"hard"}
