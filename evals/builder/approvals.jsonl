// Approvals, policies and four-eyes controls. SYNTHETIC SEEDS PENDING REVIEW BY PEOPLE (needs-people AI2). Never copy into a prompt.
{"id":"approve-tiered-amount","request":"For payout requests from our admin portal, payments under 100,000 naira need one operations officer, up to 5 million need a manager as well, and anything larger also needs a director; pay with Paystack once approved.","expect":{"connectors":["paystack@1"],"steps":["branch","approval","connector"],"properties":["approval_before_payment","idempotency"]},"tags":["approvals","payouts","policy"],"difficulty":"hard"}
{"id":"approve-maker-checker-beneficiary","request":"When someone adds a new beneficiary in our treasury tool, a different person with the treasury_checker role must approve it before it is saved to Postgres.","expect":{"connectors":["postgres@1"],"steps":["approval","connector"],"properties":["approval_timeout"]},"tags":["approvals","treasury","database"],"difficulty":"medium"}
{"id":"approve-timeout-escalate","request":"Ask the branch manager to approve a cash withdrawal above 1 million naira; if they do not respond within 4 hours, escalate to the regional manager.","expect":{"steps":["approval","branch"],"properties":["approval_timeout"]},"tags":["approvals","banking","escalation"],"difficulty":"hard"}
{"id":"approve-limit-change","request":"When a customer requests a higher daily transfer limit in our app, get a risk officer to approve and then update the limit through our core banking API, and email the customer the decision.","expect":{"connectors":["gmail@1"],"steps":["approval","http","connector"],"trigger":"webhook","properties":["approval_timeout","webhook_auth"]},"tags":["approvals","limits"],"difficulty":"medium"}
{"id":"approve-refund-over-threshold","request":"Refunds under 20,000 naira go out automatically through Flutterwave; larger ones wait for a customer service supervisor's approval first.","expect":{"connectors":["flutterwave@1"],"steps":["branch","approval","connector"],"properties":["idempotency"]},"tags":["approvals","refunds"],"difficulty":"medium"}
{"id":"approve-policy-named","request":"Use our high_value_payments approval policy for every vendor payment over 10 million naira sent through Moniepoint from the vendor payments webhook.","expect":{"connectors":["moniepoint@1"],"steps":["approval","connector"],"trigger":"webhook","properties":["approval_before_payment","idempotency","webhook_auth"]},"tags":["approvals","payouts","policy"],"difficulty":"medium"}
{"id":"approve-loan-write-off","request":"When collections proposes writing off a loan in our loan system, require approval from both the head of credit and the CFO before updating the loan status in Postgres and notifying the accountant by email.","expect":{"connectors":["postgres@1","gmail@1"],"steps":["approval","connector"],"properties":["approval_timeout"]},"tags":["approvals","lending","database"],"difficulty":"medium"}
{"id":"approve-whatsapp-approver","request":"Send a manager an approval request for each expense claim over 50,000 naira submitted through our expense webhook, and pay approved claims to the employee's account with Lenco.","expect":{"connectors":["lenco@1"],"steps":["approval","connector"],"trigger":"webhook","properties":["approval_before_payment","idempotency","webhook_auth"]},"tags":["approvals","expenses","payouts"],"difficulty":"medium"}
{"id":"approve-batch-not-each","request":"Read the week's supplier payments from the payables sheet, get the finance manager to approve the batch as a whole with the total amount shown, then pay each supplier with Flutterwave.","expect":{"connectors":["googlesheets@1","flutterwave@1"],"steps":["approval","foreach","connector"],"properties":["approval_before_payment","idempotency","bounded_concurrency"]},"tags":["approvals","payouts","productivity"],"difficulty":"hard"}
{"id":"approve-rejected-notify","request":"When an approver rejects a payout request from our portal, email the requester the rejection reason and mark the request rejected in MySQL; when approved, pay it with Paystack.","expect":{"connectors":["gmail@1","mysql@1","paystack@1"],"steps":["approval","branch","connector"],"properties":["approval_before_payment","idempotency"]},"tags":["approvals","payouts","database"],"difficulty":"hard"}
{"id":"approve-account-unfreeze","request":"When a customer asks to unfreeze their account through support, a compliance officer must approve; then call our core banking API to unfreeze it and text the customer.","expect":{"connectors":["termii@1"],"steps":["approval","http","connector"],"properties":["approval_timeout"]},"tags":["approvals","compliance"],"difficulty":"medium"}
{"id":"approve-crypto-large-trade","request":"Large crypto-to-naira withdrawals reported by Breet as flagged must be approved by the head of risk before we let them proceed to the customer's bank.","expect":{"connectors":["breet@1"],"steps":["approval","connector"],"trigger":"connector_event","properties":["approval_before_payment"]},"tags":["approvals","crypto","risk"],"difficulty":"hard"}
{"id":"approve-interbank-sweep","request":"Every day at 4pm, propose sweeping the balance above 50 million naira from the Moniepoint collection account to our Lenco operating account, and do it once the treasurer approves.","expect":{"connectors":["moniepoint@1","lenco@1"],"steps":["approval","connector"],"trigger":"schedule","properties":["approval_before_payment","idempotency","reads_before_paying"]},"tags":["approvals","treasury","schedule"],"difficulty":"hard"}
{"id":"approve-merchant-onboarding","request":"After a merchant's documents pass KYC, a relationship manager and then a compliance officer approve the merchant before we activate them through our platform API.","expect":{"steps":["approval","http"],"properties":["approval_timeout"]},"tags":["approvals","merchants","kyc"],"difficulty":"medium"}
{"id":"approve-staff-loan","request":"Staff loan requests from the HR form need HR and then finance to approve; once both approve, disburse with Paystack and add a repayment schedule row to the HR sheet.","expect":{"connectors":["paystack@1","googlesheets@1"],"steps":["approval","connector"],"trigger":"webhook","properties":["approval_before_payment","idempotency"]},"tags":["approvals","payroll","payouts"],"difficulty":"medium"}
{"id":"approve-stepup-policy","request":"Payments above 20 million naira through Interswitch must be approved under our treasury_stepup policy, which asks the approver to confirm with their passkey.","expect":{"connectors":["interswitch@1"],"steps":["approval","connector"],"properties":["approval_before_payment","idempotency"]},"tags":["approvals","payouts","policy"],"difficulty":"medium"}
{"id":"approve-price-change","request":"When the pricing team proposes a new transfer fee in the pricing sheet, ask the head of product to approve before our pricing API is updated.","expect":{"connectors":["googlesheets@1"],"steps":["approval","http"],"properties":["approval_timeout"]},"tags":["approvals","pricing"],"difficulty":"medium"}
{"id":"approve-auto-reject-stale","request":"Approval requests for manual credits should expire after 48 hours; an expired request is treated as rejected and the requester is told on Slack.","expect":{"connectors":["slack@1"],"steps":["approval","connector"],"properties":["approval_timeout"]},"tags":["approvals","escalation"],"difficulty":"medium"}
