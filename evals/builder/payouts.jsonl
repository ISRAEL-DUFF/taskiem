// Payouts and disbursements. SYNTHETIC SEEDS PENDING REVIEW BY PEOPLE (needs-people AI2). Never copy into a prompt.
{"id":"payout-merchant-settlement-paystack","request":"Every evening at 6pm, settle each merchant's balance for the day from our Postgres ledger to their bank account with Paystack transfers, once a finance officer signs off on the batch.","expect":{"connectors":["postgres@1","paystack@1"],"steps":["approval","foreach","connector"],"trigger":"schedule","properties":["approval_before_payment","idempotency","bounded_concurrency"]},"tags":["payouts","schedule","approval","database"],"difficulty":"hard"}
{"id":"payout-agent-commission-moniepoint","request":"On the first day of each month, pay our POS agents their commission from the commissions sheet using Moniepoint transfers after the head of agency banking approves.","expect":{"connectors":["googlesheets@1","moniepoint@1"],"steps":["approval","foreach","connector"],"trigger":"schedule","properties":["approval_before_payment","idempotency","bounded_concurrency"]},"tags":["payouts","schedule","approval","productivity"],"difficulty":"hard"}
{"id":"payout-single-vendor-flutterwave","request":"Let an operations analyst start a one-off vendor payment by entering the bank code, account number, amount and narration; resolve the account name with Flutterwave, have a manager approve it, then send the transfer.","expect":{"connectors":["flutterwave@1"],"steps":["approval","connector"],"trigger":"manual","properties":["approval_before_payment","idempotency","inputs_declared","reads_before_paying"]},"tags":["payouts","approval"],"difficulty":"medium"}
{"id":"payout-loan-disbursal-lenco","request":"When the credit engine posts a disbursement instruction to our webhook, check the Lenco account has enough money, get a credit officer's approval and disburse the loan to the borrower's account through Lenco.","expect":{"connectors":["lenco@1"],"steps":["approval","connector"],"trigger":"webhook","properties":["approval_before_payment","idempotency","webhook_auth","reads_before_paying"]},"tags":["payouts","lending","approval"],"difficulty":"medium"}
{"id":"payout-cashback-iswallet","request":"When a card transaction is reported to our webhook as eligible for cashback, credit 2% of the amount to the customer's iswallet wallet, capped at 1,000 naira, and never twice for the same transaction.","expect":{"connectors":["iswallet@1"],"steps":["connector"],"trigger":"webhook","properties":["idempotency","webhook_auth","dedup"]},"tags":["payouts","rewards"],"difficulty":"medium"}
{"id":"payout-bulk-remita-pensions","request":"Each quarter, take the pension remittance schedule from MySQL and submit it to Remita as one bulk transfer once the HR manager and the finance director have both approved.","expect":{"connectors":["mysql@1","remita@1"],"steps":["approval","connector"],"trigger":"schedule","properties":["approval_before_payment","idempotency"]},"tags":["payouts","payroll","approval","database"],"difficulty":"hard"}
{"id":"payout-anchor-book-transfer","request":"When our app asks to move funds between two of a customer's Anchor deposit accounts, do an Anchor book transfer and tell our app the result through its callback URL.","expect":{"connectors":["anchor@1"],"steps":["connector","http"],"trigger":"webhook","properties":["idempotency","webhook_auth"]},"tags":["payouts","banking"],"difficulty":"medium"}
{"id":"payout-crypto-withdrawal-breet","request":"When a customer requests a naira withdrawal of their crypto balance in our app, check their Breet balance, have a risk analyst approve withdrawals over 500,000 naira, and withdraw to their verified bank account with Breet.","expect":{"connectors":["breet@1"],"steps":["branch","approval","connector"],"trigger":"webhook","properties":["approval_before_payment","webhook_auth","reads_before_paying"]},"tags":["payouts","crypto","approval"],"difficulty":"hard"}
{"id":"payout-retry-failed-interswitch","request":"Every two hours, look up Interswitch transfers our database marks as failed in the last day, and for each one re-send it only if Interswitch confirms it never went through.","expect":{"connectors":["postgres@1","interswitch@1"],"steps":["foreach","branch","connector"],"trigger":"schedule","properties":["idempotency","bounded_concurrency"]},"tags":["payouts","reconciliation","database"],"difficulty":"hard"}
{"id":"payout-insurance-claim","request":"When a claims officer marks an insurance claim as settled in our claims system webhook, get the claims manager to approve the payout and pay the claimant with Paystack, then email them a settlement letter.","expect":{"connectors":["paystack@1","gmail@1"],"steps":["approval","connector"],"trigger":"webhook","properties":["approval_before_payment","idempotency","webhook_auth"]},"tags":["payouts","insurance","approval"],"difficulty":"medium"}
{"id":"payout-driver-earnings-daily","request":"At 11pm every day, pay every delivery rider their earnings for the day from our MySQL trips table via Flutterwave, ten at a time, and text each rider the amount with Termii.","expect":{"connectors":["mysql@1","flutterwave@1","termii@1"],"steps":["foreach","connector"],"trigger":"schedule","properties":["idempotency","bounded_concurrency"]},"tags":["payouts","schedule","messaging","database"],"difficulty":"hard"}
{"id":"payout-refund-opay","request":"When a support agent approves a refund in Slack, refund the original OPay payment and post the refund reference back in the thread.","expect":{"connectors":["slack@1","opay@1"],"steps":["connector"],"properties":["idempotency"]},"tags":["payouts","refunds","messaging"],"difficulty":"medium"}
{"id":"payout-escrow-release","request":"Hold an escrow payment until the buyer confirms delivery through our webhook or 7 days pass, then release the funds to the seller with a Paystack transfer.","expect":{"connectors":["paystack@1"],"steps":["signal","connector"],"properties":["idempotency"]},"tags":["payouts","escrow","wait"],"difficulty":"hard"}
{"id":"payout-salary-advance","request":"When an employee requests a salary advance in our HR app, check their eligibility with our HR API, have their line manager approve, then send up to 30% of their salary through Lenco and record the deduction in Postgres.","expect":{"connectors":["lenco@1","postgres@1"],"steps":["http","approval","connector"],"trigger":"webhook","properties":["approval_before_payment","idempotency","webhook_auth"]},"tags":["payouts","payroll","approval","database"],"difficulty":"hard"}
{"id":"payout-name-check-before-send","request":"Before paying any new beneficiary added in our admin portal, resolve the account number with Paystack's bank list check, compare the returned name with the name entered, and only then let the treasury lead approve and send the money.","expect":{"connectors":["paystack@1"],"steps":["branch","approval","connector"],"properties":["approval_before_payment","reads_before_paying"]},"tags":["payouts","fraud","approval"],"difficulty":"hard"}
{"id":"payout-iswallet-to-bank-split","request":"When a creator's monthly payout is due according to our webhook, send 90% to their bank account with an iswallet payout and 10% to our tax holding wallet with an iswallet transfer, both under the same approval.","expect":{"connectors":["iswallet@1"],"steps":["approval","connector"],"trigger":"webhook","properties":["approval_before_payment","idempotency","webhook_auth"]},"tags":["payouts","approval"],"difficulty":"medium"}
{"id":"payout-cooperative-dividends","request":"Once a year in January, pay cooperative members their dividends from the members spreadsheet with Moniepoint after two committee members approve, and send each member a WhatsApp template message confirming the amount.","expect":{"connectors":["googlesheets@1","moniepoint@1","whatsapp@1"],"steps":["approval","foreach","connector"],"trigger":"schedule","properties":["approval_before_payment","idempotency","bounded_concurrency"]},"tags":["payouts","schedule","approval","messaging"],"difficulty":"hard"}
{"id":"payout-limit-per-day","request":"For withdrawals sent to our webhook, pay automatically with Flutterwave when the customer has withdrawn less than 200,000 naira today according to Postgres; otherwise hold it for an operations supervisor to approve.","expect":{"connectors":["postgres@1","flutterwave@1"],"steps":["branch","approval","connector"],"trigger":"webhook","properties":["idempotency","webhook_auth"]},"tags":["payouts","limits","approval","database"],"difficulty":"hard"}
{"id":"payout-check-transfer-status","request":"Ten minutes after each Lenco transfer we start, check its status and, if it is still pending, alert the payments channel on Slack.","expect":{"connectors":["lenco@1","slack@1"],"steps":["wait","branch","connector"]},"tags":["payouts","monitoring","wait"],"difficulty":"medium"}
{"id":"payout-school-fees","request":"When a parent pays school fees into a school's Paystack account, transfer the school's share to its bank account the same day and keep our platform fee, after confirming the charge with Paystack.","expect":{"connectors":["paystack@1"],"steps":["connector"],"trigger":"connector_event","properties":["idempotency","reads_before_paying"]},"tags":["payouts","marketplace","education"],"difficulty":"medium"}
{"id":"payout-agent-float-topup","request":"When an agent requests a float top-up on WhatsApp, look up their wallet in MySQL, get the regional manager to approve, and fund their iswallet wallet.","expect":{"connectors":["whatsapp@1","mysql@1","iswallet@1"],"steps":["approval","connector"],"properties":["approval_before_payment","idempotency"]},"tags":["payouts","agents","approval","messaging"],"difficulty":"hard"}
