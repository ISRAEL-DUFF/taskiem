// Multi-step workflows with branches, loops, parallel work, waits and signals. SYNTHETIC SEEDS PENDING REVIEW BY PEOPLE (needs-people AI2). Never copy into a prompt.
{"id":"multi-loan-end-to-end","request":"When a loan application arrives, verify the BVN with Dojah, pull 6 months of Mono transactions and score them in a code step; reject automatically below a score of 40, auto-approve above 75, and send everything in between to a credit officer; disburse approved loans with Paystack and text the applicant the outcome.","expect":{"connectors":["dojah@1","mono@1","paystack@1","termii@1"],"steps":["code","branch","approval","connector"],"trigger":"webhook","properties":["approval_before_payment","idempotency","webhook_auth"]},"tags":["multistep","lending","kyc","approval"],"difficulty":"hard"}
{"id":"multi-merchant-onboarding","request":"Onboard a merchant: verify the business with Youverify and the director's BVN with Prembly in parallel, create a Moniepoint reserved account for them if both pass, and email the account details; otherwise email the merchant what failed.","expect":{"connectors":["youverify@1","prembly@1","moniepoint@1","gmail@1"],"steps":["parallel","branch","connector"]},"tags":["multistep","merchants","kyc"],"difficulty":"hard"}
{"id":"multi-payroll-with-reports","request":"On the 26th, read the payroll from MySQL, have HR and finance approve, pay staff through Remita bulk transfer, wait an hour, check the bulk status, then email payslips and post a summary of failures to Slack.","expect":{"connectors":["mysql@1","remita@1","gmail@1","slack@1"],"steps":["approval","wait","connector"],"trigger":"schedule","properties":["approval_before_payment","idempotency"]},"tags":["multistep","payroll","approval","schedule"],"difficulty":"hard"}
{"id":"multi-refund-and-notify-parallel","request":"When a refund is approved in our support tool webhook, refund the payment with OPay, then at the same time email the customer, text them with Termii and log the refund in the refunds sheet.","expect":{"connectors":["opay@1","gmail@1","termii@1","googlesheets@1"],"steps":["parallel","connector"],"trigger":"webhook","properties":["idempotency","webhook_auth"]},"tags":["multistep","refunds","messaging"],"difficulty":"hard"}
{"id":"multi-wallet-funding-flow","request":"When a customer funds their wallet with Paystack, confirm the charge, credit their balance in Postgres, and if this is their first deposit also give them 200 naira of airtime with Africa's Talking.","expect":{"connectors":["paystack@1","postgres@1","africastalking@1"],"steps":["branch","connector"],"trigger":"connector_event","properties":["dedup"]},"tags":["multistep","wallets","rewards"],"difficulty":"hard"}
{"id":"multi-fraud-review-loop","request":"For each transaction our fraud API flags in the last hour, freeze the card through our card processor API, ask a fraud analyst to confirm or release it, and unfreeze released cards.","expect":{"steps":["foreach","http","approval","branch"],"trigger":"schedule","properties":["bounded_concurrency","approval_timeout"]},"tags":["multistep","fraud","approval"],"difficulty":"hard"}
{"id":"multi-crypto-sell-flow","request":"When Breet reports a completed trade, convert the naira proceeds to the customer's bank account with Breet's withdraw-to-bank, then email them a receipt; if the withdrawal fails, text them and open a Slack alert.","expect":{"connectors":["breet@1","gmail@1","termii@1","slack@1"],"steps":["branch","connector"],"trigger":"connector_event","properties":["idempotency"]},"tags":["multistep","crypto","payouts"],"difficulty":"hard"}
{"id":"multi-invoice-chase","request":"When an invoice is issued, email it, then wait 7 days; if it is still unpaid per our billing API, send a WhatsApp reminder template, wait another 7 days, and if still unpaid, alert the account manager on Slack.","expect":{"connectors":["gmail@1","whatsapp@1","slack@1"],"steps":["wait","http","branch","connector"],"trigger":"webhook"},"tags":["multistep","collections","wait"],"difficulty":"hard"}
{"id":"multi-compensate-wallet-debit","request":"Debit the customer's wallet in Postgres, then send the bank transfer with Flutterwave; if the transfer fails for good, credit the wallet back and tell the customer by SMS.","expect":{"connectors":["postgres@1","flutterwave@1","termii@1"],"steps":["connector"],"properties":["idempotency","error_handling"]},"tags":["multistep","payouts","compensation"],"difficulty":"hard"}
{"id":"multi-statement-pipeline","request":"Every night, for each customer who asked for a statement today, fetch their transactions from Postgres, render a PDF through our documents API, upload it to S3, and email them a presigned link, 5 customers at a time.","expect":{"connectors":["postgres@1","s3@1","gmail@1"],"steps":["foreach","http","connector"],"trigger":"schedule","properties":["bounded_concurrency"]},"tags":["multistep","reporting","storage"],"difficulty":"hard"}
{"id":"multi-agent-cashout","request":"When a customer requests a cash-out at an agent through our agency app, debit the customer's iswallet wallet, credit the agent's wallet, and send both of them an SMS receipt at the same time.","expect":{"connectors":["iswallet@1","termii@1"],"steps":["parallel","connector"],"trigger":"webhook","properties":["idempotency","webhook_auth"]},"tags":["multistep","agents","wallets"],"difficulty":"hard"}
{"id":"multi-kyc-then-account","request":"After a customer passes NIN verification with Youverify, open their deposit account through our core banking API, create an Anchor virtual account for funding, and send them a WhatsApp welcome template with the account number.","expect":{"connectors":["youverify@1","anchor@1","whatsapp@1"],"steps":["branch","http","connector"]},"tags":["multistep","onboarding","kyc"],"difficulty":"hard"}
{"id":"multi-dispute-signal","request":"When a customer raises a dispute, create a ticket through our helpdesk API, wait for the helpdesk to tell us the resolution through a signal for up to 5 days, then refund with Paystack if the dispute was upheld.","expect":{"connectors":["paystack@1"],"steps":["http","signal","branch","connector"],"properties":["idempotency"]},"tags":["multistep","disputes","wait"],"difficulty":"hard"}
{"id":"multi-bill-payment-retry","request":"Pay a customer's electricity bill through Interswitch; retry up to three times on temporary errors, and if it still fails, refund their wallet in Postgres and apologise by SMS.","expect":{"connectors":["interswitch@1","postgres@1","termii@1"],"steps":["connector"],"properties":["idempotency","error_handling"]},"tags":["multistep","bills","error_handling"],"difficulty":"hard"}
{"id":"multi-savings-interest","request":"On the last day of each month, compute interest for each savings customer in a code step from their Postgres balances, credit it to their iswallet wallets ten at a time after the head of finance approves the total, and email a summary to finance.","expect":{"connectors":["postgres@1","iswallet@1","gmail@1"],"steps":["code","approval","foreach","connector"],"trigger":"schedule","properties":["approval_before_payment","idempotency","bounded_concurrency"]},"tags":["multistep","savings","approval","schedule"],"difficulty":"hard"}
{"id":"multi-marketplace-split","request":"When a marketplace order is paid on Flutterwave, look up the seller in MySQL, pay the seller 95% by Flutterwave transfer, keep 5% as commission recorded in MySQL, and notify the seller on WhatsApp.","expect":{"connectors":["flutterwave@1","mysql@1","whatsapp@1"],"steps":["connector"],"trigger":"connector_event","properties":["idempotency"]},"tags":["multistep","marketplace","payouts"],"difficulty":"hard"}
{"id":"multi-branch-by-channel","request":"When a customer chooses how they want their statement through our app, send it by email if they chose email, by WhatsApp document if they chose WhatsApp, and by Telegram otherwise.","expect":{"connectors":["gmail@1","whatsapp@1","telegram@1"],"steps":["branch","connector"],"trigger":"webhook"},"tags":["multistep","messaging"],"difficulty":"medium"}
{"id":"multi-ussd-handoff","request":"When our USSD aggregator posts a completed airtime purchase session, debit the customer's wallet in Postgres, send the airtime with Africa's Talking, and if that fails, credit the wallet back.","expect":{"connectors":["postgres@1","africastalking@1"],"steps":["connector"],"trigger":"webhook","properties":["error_handling","webhook_auth"]},"tags":["multistep","ussd","airtime"],"difficulty":"hard"}
{"id":"multi-sweep-and-report","request":"Every day at 6pm, read balances of all our Lenco sub-accounts, sweep anything above 1 million naira to the main account after the treasurer approves, then post a sweep report to Slack.","expect":{"connectors":["lenco@1","slack@1"],"steps":["foreach","approval","connector"],"trigger":"schedule","properties":["approval_before_payment","idempotency","reads_before_paying"]},"tags":["multistep","treasury","approval","schedule"],"difficulty":"hard"}
{"id":"multi-parallel-kyc-checks","request":"Run a BVN lookup with Dojah, a phone lookup with Prembly and an AML screen with Youverify at the same time for each new account, and only activate the account through our API if all three pass.","expect":{"connectors":["dojah@1","prembly@1","youverify@1"],"steps":["parallel","branch","http"]},"tags":["multistep","kyc","parallel"],"difficulty":"hard"}
