# Compose settings (not secrets). Copy to .env.

# The public host name; DNS A/AAAA records must point at this VM before start.
TASKIEM_DOMAIN=staging.taskiem.example

# Pin an immutable tag published by CI: sha-<12 characters of the commit> or a
# version tag. Never "main".
TASKIEM_IMAGE=ghcr.io/israel-duff/taskiem:sha-000000000000

OPENBAO_VERSION=2.4.1
