#!/usr/bin/env bash
# taskiem-vps: install, update, back up and watch Taskiem on one VM
# (decision 0032, docs/vm.md). Installed to /usr/local/bin by install.sh.
#
#   taskiem-vps setup               first install, or re-run to change settings (idempotent)
#   taskiem-vps update [--now] [--allow-downgrade]
#                                   move to the newest signed release on this server's channel
#   taskiem-vps rollback            go back to the release before the current one
#   taskiem-vps status              what runs, which release, health, last update and backup
#   taskiem-vps check               health checks; alerts on change (run every 5 minutes)
#   taskiem-vps backup              encrypted backup of OpenBao, Taskiem's data and settings
#   taskiem-vps restore             rebuild this deployment on a new server from a backup
#   taskiem-vps logs [SERVICE...]   follow the logs
#   taskiem-vps owner-reset         send the owner a new set-your-password email
set -Eeuo pipefail

KIT=${TASKIEM_VPS_KIT:-/opt/taskiem}
ETC=${TASKIEM_VPS_ETC:-/etc/taskiem}
STATE=${TASKIEM_VPS_STATE:-/var/lib/taskiem-vps}
BIN=${TASKIEM_VPS_BIN:-/usr/local/bin} # where this tool is installed (tests change it)
REPO_SLUG=ISRAEL-DUFF/taskiem
IMAGE_REPO=ghcr.io/israel-duff/taskiem
SIGNER='^https://github\.com/ISRAEL-DUFF/taskiem/\.github/workflows/ci\.yml@refs/(heads/main|tags/v.+)$'
# A production server takes only what a version tag's run released.
SIGNER_PRODUCTION='^https://github\.com/ISRAEL-DUFF/taskiem/\.github/workflows/ci\.yml@refs/tags/v.+$'
ISSUER=https://token.actions.githubusercontent.com
# CI's signed statement that an image was released to a channel, with a
# release number that only grows (.github/workflows/ci.yml).
RELEASE_STATEMENT=https://github.com/ISRAEL-DUFF/taskiem/attestations/release/v1
# Third-party images, pinned by digest (the tag is kept for people), as the
# Dockerfile pins its bases; docker-compose.yml pins the same OpenBao.
PSQL_IMAGE=postgres:16.15-alpine@sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab
RESTIC_IMAGE=restic/restic:0.19.1@sha256:136600b6ff6843d61d355f7f71f460a166429f35de6fd11b568fece3c9a4d510
OPENBAO_IMAGE=openbao/openbao:2.7.1@sha256:6d2b93856e3fcf7b18ad855a0b51eaba474dc8b79cf554379ea32034797d2acf

# --- helpers -----------------------------------------------------------------

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "run as root (sudo taskiem-vps $*)"; }
# With another Caddy in front (external-proxy mode, below), a Compose file
# of this server's own is added to the release's: it leaves Taskiem's Caddy
# out and puts the web containers on the shared network.
compose() {
  local files=(-f "$KIT/docker-compose.yml")
  if external_proxy; then
    [ -f "$KIT/$PROXY_COMPOSE" ] || write_proxy_compose >/dev/null || true
    files+=(-f "$KIT/$PROXY_COMPOSE")
  fi
  docker compose --project-directory "$KIT" "${files[@]}" "$@"
}

# Env files are KEY='value': single quotes make Compose read the value
# literally. A value holding a single quote or a newline is refused.
env_get() { # FILE KEY
  [ -f "$1" ] || return 0
  sed -n "s/^$2='\\(.*\\)'\$/\\1/p" "$1" | tail -n1
}
env_set() { # FILE KEY VALUE
  local file=$1 key=$2 value=$3 tmp
  case $value in *"'"* | *$'\n'*) die "$key may not contain a single quote or a newline" ;; esac
  touch "$file" && chmod 600 "$file"
  tmp=$(mktemp "$file.XXXX")
  grep -v "^$key=" "$file" >"$tmp" || true
  printf "%s='%s'\n" "$key" "$value" >>"$tmp"
  chmod 600 "$tmp" && mv "$tmp" "$file"
}
env_unset() { # FILE KEY
  local tmp
  [ -f "$1" ] || return 0
  tmp=$(mktemp "$1.XXXX")
  grep -v "^$2=" "$1" >"$tmp" || true
  chmod 600 "$tmp" && mv "$tmp" "$1"
}
conf() { env_get "$ETC/vps.conf" "$1"; }

# ask VAR "question" [default]: from TASKIEM_VPS_<VAR> if set, else the
# terminal (stdin may be the piped installer), else the default.
ask() {
  local var=$1 question=$2 default=${3:-} value env="TASKIEM_VPS_$1"
  value=${!env:-}
  if [ -z "$value" ] && [ -r /dev/tty ] && [ -z "${TASKIEM_VPS_NONINTERACTIVE:-}" ]; then
    if [ -n "$default" ]; then printf '%s [%s]: ' "$question" "$default" >/dev/tty; else printf '%s: ' "$question" >/dev/tty; fi
    IFS= read -r value </dev/tty || true
  fi
  printf -v "$var" '%s' "${value:-$default}"
}
ask_secret() {
  local var=$1 question=$2 default=${3:-} value env="TASKIEM_VPS_$1"
  value=${!env:-}
  if [ -z "$value" ] && [ -r /dev/tty ] && [ -z "${TASKIEM_VPS_NONINTERACTIVE:-}" ]; then
    printf '%s%s: ' "$question" "${default:+ [keep current]}" >/dev/tty
    IFS= read -rs value </dev/tty || true
    printf '\n' >/dev/tty
  fi
  printf -v "$var" '%s' "${value:-$default}"
}

hex() { openssl rand -hex "$1"; }
test_mode() { [ -n "${TASKIEM_VPS_IMAGE_OVERRIDE:-}" ]; }

# curl against this server's own HTTPS front door, whatever DNS says.
local_https() { # PATH [curl args...]
  local path=$1 domain insecure=()
  shift
  domain=$(conf DOMAIN)
  [ -z "${TASKIEM_VPS_INSECURE_TLS:-}" ] || insecure=(-k) # tests only: Caddy's internal CA for localhost
  curl -fsS --max-time 10 "${insecure[@]}" --resolve "$domain:443:127.0.0.1" "$@" "https://$domain$path"
}

# --- external proxy ----------------------------------------------------------

# External-proxy mode (docs/vm.md#sharing-the-server-with-xenibase): another
# Caddy on this server, Xenibase's, holds ports 80 and 443 and serves
# Taskiem's sites too. Taskiem's own Caddy is left out; taskiem and
# taskiem-public join a shared Docker network that the other Caddy is on;
# taskiem.caddy and taskiem.global go into the directory it imports (its
# caddy.d), and it is told to reload. Chosen in setup (TASKIEM_VPS_PROXY=external,
# TASKIEM_VPS_PROXY_DIR, TASKIEM_VPS_PROXY_CONTAINER, TASKIEM_VPS_PROXY_NETWORK)
# and kept in vps.conf, so updates, rollbacks and restores keep it.
PROXY_COMPOSE=docker-compose.external-proxy.yml
external_proxy() { [ "$(conf PROXY)" = external ]; }

# PATH CONTENT: write it (0644) only if it differs; 0 when it changed.
write_if_changed() {
  local tmp
  [ "$(cat "$1" 2>/dev/null)" != "$2" ] || return 1
  tmp=$(mktemp "$1.XXXX")
  printf '%s\n' "$2" >"$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$1"
}

# The Compose file added to the release's in external-proxy mode. It is
# this server's, not the kit's: an update replaces docker-compose.yml and
# leaves it.
write_proxy_compose() {
  write_if_changed "$KIT/$PROXY_COMPOSE" "# Written by taskiem-vps for external-proxy mode (docs/vm.md#sharing-the-server-with-xenibase).
# Added to docker-compose.yml on this server; do not edit, setup rewrites it.
# Another Caddy serves Taskiem's sites, so Taskiem's own is left out (it runs
# only with the own-caddy profile, which is never set), and the containers
# that Caddy proxies to join the network it is on.
services:
  caddy:
    profiles: [own-caddy]
  taskiem:
    networks: [default, proxy]
  taskiem-public:
    networks: [default, proxy]
networks:
  proxy:
    name: $(conf PROXY_NETWORK)
    external: true"
}

# The shared network, made by whichever installer runs first, and this
# server's Compose file for it. COMPOSE_FILE in .env names both files, so
# a person's own `docker compose --project-directory /opt/taskiem ...`
# leaves Taskiem's Caddy out too.
proxy_prepare() {
  local net
  net=$(conf PROXY_NETWORK)
  docker network inspect "$net" >/dev/null 2>&1 || docker network create "$net" >/dev/null ||
    docker network inspect "$net" >/dev/null 2>&1 || die "could not create the Docker network $net"
  write_proxy_compose || true
  env_set "$KIT/.env" COMPOSE_FILE "$KIT/docker-compose.yml:$KIT/$PROXY_COMPOSE"
}

# taskiem.caddy: the same sites as the kit's Caddyfile and public.caddy,
# with the names written out, since the other Caddy does not have
# Taskiem's environment. That Caddy already sends HTTP to HTTPS for the
# app's name; for other names its own http:// site answers, so plain-HTTP
# visits to preview addresses are sent to HTTPS here.
proxy_site() {
  local domain preview
  domain=$(conf DOMAIN)
  printf '%s\n' "# Taskiem's sites, served by this Caddy for Taskiem's external-proxy mode
# (Taskiem's docs/vm.md#sharing-the-server-with-xenibase). Written by
# taskiem-vps: do not edit, its setup and updates rewrite it.

# The web app, /v1 and webhooks. Taskiem sets HSTS itself.
${domain,,} {
	encode zstd gzip
	reverse_proxy taskiem:8080
}"
  [ "$(conf PUBLIC)" = yes ] || return 0
  preview=$(conf PREVIEW_DOMAIN)
  printf '%s\n' "
# Storefronts and hosted forms: every other host goes to Taskiem's public
# host. Each name gets a certificate when first visited, once the public
# host's /tls/ask (taskiem.global) confirms it serves it.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy taskiem-public:8082
}

# Preview addresses over plain HTTP go to HTTPS.
http://*.${preview,,} {
	redir https://{host}{uri} 308
}"
}

# taskiem.global, imported inside the other Caddy's global options.
proxy_global() {
  printf '%s\n' "# Taskiem's global options for this Caddy (external-proxy mode). Written
# by taskiem-vps: do not edit. Certificates for storefronts' hosts are
# issued only for a host Taskiem's public host says it serves.
on_demand_tls {
	ask http://taskiem-public:9090/tls/ask
}"
}

proxy_reload() { # CONTAINER
  local out
  out=$(docker exec "$1" caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile 2>&1) || {
    log "the Caddy in $1 did not reload: $(printf '%s' "$out" | tail -3)"
    return 1
  }
}

# Write the two files into the other Caddy's directory and reload it when
# they changed (always with "force"). Each new file is written under a
# temporary name in that directory and renamed into place, taskiem.global
# first: the other Caddy refuses taskiem.caddy's on-demand certificates
# without the check in taskiem.global, so there is never a moment with the
# site but not the check. If the reload fails, the files it had before are
# put back (or removed, if there were none) and it is reloaded again, so
# the directory never holds files that Caddy refuses: it is recreated on
# every Xenibase upgrade, and would then fail to start, taking every site
# down. Fails if the new files would not load.
proxy_publish() { # [force]
  local dir container changed=${1:-} f tmp new_global new_site
  dir=$(conf PROXY_DIR) container=$(conf PROXY_CONTAINER)
  [ -d "$dir" ] || { log "$dir, the other Caddy's site directory, does not exist"; return 1; }
  new_global=$(proxy_global) new_site=$(proxy_site)
  [ "$(cat "$dir/taskiem.global" 2>/dev/null)" = "$new_global" ] || changed=1
  [ "$(cat "$dir/taskiem.caddy" 2>/dev/null)" = "$new_site" ] || changed=1
  [ -n "$changed" ] || return 0
  # The files as they are, kept under names the other Caddy does not import.
  for f in global caddy; do
    rm -f "$dir/taskiem.$f.previous"
    [ ! -e "$dir/taskiem.$f" ] || cp -p "$dir/taskiem.$f" "$dir/taskiem.$f.previous"
  done
  for f in global caddy; do
    tmp=$(mktemp "$dir/.taskiem.$f.XXXXXX")
    if [ "$f" = global ]; then printf '%s\n' "$new_global" >"$tmp"; else printf '%s\n' "$new_site" >"$tmp"; fi
    chmod 644 "$tmp" && mv -f "$tmp" "$dir/taskiem.$f"
  done
  log "reloading the Caddy in $container"
  if proxy_reload "$container"; then
    rm -f "$dir/taskiem.global.previous" "$dir/taskiem.caddy.previous"
    return 0
  fi
  # Back as they were: the site before the check, so the site is never
  # there without its check.
  log "putting back the files the Caddy in $container had, and reloading it"
  for f in caddy global; do
    if [ -e "$dir/taskiem.$f.previous" ]; then mv -f "$dir/taskiem.$f.previous" "$dir/taskiem.$f"; else rm -f "$dir/taskiem.$f"; fi
  done
  proxy_reload "$container" || true
  return 1
}

# Taskiem's files out of a directory it no longer uses (setup moved the
# server back to its own Caddy, or to another directory).
proxy_unpublish() { # DIR CONTAINER
  [ -n "$1" ] || return 0
  [ -e "$1/taskiem.caddy" ] || [ -e "$1/taskiem.global" ] || return 0
  # The site before its check, so the site is never there without it.
  rm -f "$1/taskiem.caddy"
  rm -f "$1/taskiem.global"
  proxy_reload "$2" || true
}

# One line per problem, for run_checks.
proxy_checks() {
  local dir net c id domain
  dir=$(conf PROXY_DIR) net=$(conf PROXY_NETWORK) c=$(conf PROXY_CONTAINER) domain=$(conf DOMAIN)
  [ "$(cat "$dir/taskiem.caddy" 2>/dev/null)" = "$(proxy_site)" ] || echo "$dir/taskiem.caddy is missing or changed: run taskiem-vps setup"
  [ "$(cat "$dir/taskiem.global" 2>/dev/null)" = "$(proxy_global)" ] || echo "$dir/taskiem.global is missing or changed: run taskiem-vps setup"
  docker network inspect "$net" >/dev/null 2>&1 || { echo "the Docker network $net is missing: run taskiem-vps setup"; return 0; }
  id=$(compose ps -q taskiem 2>/dev/null || true)
  [ -z "$id" ] || docker inspect -f '{{json .NetworkSettings.Networks}}' "$id" 2>/dev/null | grep -qF "\"$net\":" ||
    echo "Taskiem is not on the network $net: the Caddy in $c cannot reach it (taskiem-vps setup)"
  if ! docker inspect -f '{{json .NetworkSettings.Networks}}' "$c" 2>/dev/null | grep -qF "\"$net\":"; then
    echo "the Caddy in $c is not running or not on the network $net: it cannot reach Taskiem"
  # Its running configuration (admin API) has Taskiem's site: the last reload took.
  elif ! docker exec "$c" wget -qO- http://127.0.0.1:2019/config/ 2>/dev/null | grep -qF "\"${domain,,}\""; then
    echo "the Caddy in $c has not loaded taskiem.caddy: docker exec $c caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile"
  fi
}

# --- releases ----------------------------------------------------------------

# The digest the server's channel tag (staging or production) points at.
channel_digest() {
  docker buildx imagetools inspect "$IMAGE_REPO:$(conf CHANNEL)" --format '{{.Manifest.Digest}}'
}

# cosign checks a signature against Sigstore's trust metadata (which keys
# and certificate authorities count), a signed TUF repository it refreshes
# from Sigstore's CDN at most once a day. On 2 November 2026 that CDN began
# answering a staging server with 403 for every file, and cosign fails the
# whole check when the refresh fails. So the metadata is taken from the
# first of three sources that answers: Sigstore's CDN, the same repository
# as published on GitHub Pages (the same signed files, so the same
# verification), and the trusted root saved here after the last check that
# got through (verified offline against metadata known good then). Only a
# metadata problem moves on to the next source: a signature verdict is
# final whichever source gave it.
TUF_SOURCES=${TASKIEM_VPS_TUF_SOURCES:-"https://tuf-repo-cdn.sigstore.dev https://sigstore.github.io/root-signing"}

verify_image() { # REF
  if [ "${TASKIEM_VPS_VERIFY:-1}" = 0 ]; then
    log "WARNING: signature check skipped (TASKIEM_VPS_VERIFY=0); never do this on a real server"
    return 0
  fi
  local src out
  COSIGN_TRUST=()
  for src in $TUF_SOURCES pinned; do
    if [ "$src" = pinned ]; then
      [ -s "$STATE/trusted_root.json" ] || continue
      log "checking the signature against the trust metadata saved on $(date -u -r "$STATE/trusted_root.json" +%F)"
      COSIGN_TRUST=(--trusted-root "$STATE/trusted_root.json")
      cosign verify "$1" "${COSIGN_TRUST[@]}" --certificate-identity-regexp "$SIGNER" --certificate-oidc-issuer "$ISSUER" >/dev/null 2>&1 && return 0
      break
    fi
    if ! out=$(cosign initialize --mirror "$src" 2>&1 >/dev/null); then
      log "no trust metadata from $src: $(printf '%s' "$out" | tail -1 | cut -c1-160)"
      continue
    fi
    if out=$(cosign verify "$1" --certificate-identity-regexp "$SIGNER" --certificate-oidc-issuer "$ISSUER" 2>&1 >/dev/null); then
      save_trusted_root
      return 0
    fi
    case $out in
      *"trusted root"* | *"TUF"* | *"tuf refresh"* | *"load metadata"*)
        log "no trust metadata from $src: $(printf '%s' "$out" | tail -1 | cut -c1-160)" ;;
      *) break ;; # a verdict on the signature, not a problem fetching metadata
    esac
  done
  die "$1 is not signed by Taskiem's CI: refusing it"
}

# The trust metadata verify_image ended up using (the saved root, when the
# sources could not be reached): the release statement is checked the same way.
COSIGN_TRUST=()

# The release number CI stated for REF on this server's channel: the
# highest, if it was released more than once. Prints nothing when CI made
# no such statement. The statement is an attestation signed as the image
# is (keyless, this repository's CI workflow), so moving a tag in the
# registry cannot make one.
release_of() { # REF
  local channel signer out
  channel=$(conf CHANNEL)
  signer=$SIGNER
  [ "$channel" = production ] && signer=$SIGNER_PRODUCTION
  out=$(cosign verify-attestation "$1" "${COSIGN_TRUST[@]}" --type "$RELEASE_STATEMENT" \
    --certificate-identity-regexp "$signer" --certificate-oidc-issuer "$ISSUER" 2>/dev/null) || return 0
  printf '%s\n' "$out" |
    jq -r --arg c "$channel" '(.payload // .dsseEnvelope.payload // empty) | @base64d | fromjson | .predicate | select(.channel == $c) | .release' 2>/dev/null |
    grep -E '^[0-9]+$' | sort -n | tail -1
}

# Refuse a release that CI did not release to this server's channel, or
# that is not newer than the one running. Sets NEW_RELEASE.
NEW_RELEASE=""
check_release() { # REF ALLOW_DOWNGRADE
  NEW_RELEASE=""
  if test_mode && [ -z "${TASKIEM_VPS_TEST_RELEASES:-}" ]; then return 0; fi
  [ "${TASKIEM_VPS_VERIFY:-1}" = 0 ] && return 0 # verify_image has warned
  local have channel
  channel=$(conf CHANNEL)
  NEW_RELEASE=$(release_of "$1" || true)
  if [ -z "$NEW_RELEASE" ]; then
    refuse_release "$1" "$1 carries no signed statement from Taskiem's CI that it was released to the $channel channel: refusing it"
  fi
  have=$(cat "$STATE/current-release" 2>/dev/null || true)
  case $have in '' | *[!0-9]*) have=0 ;; esac
  [ "$NEW_RELEASE" -gt "$have" ] && return 0
  if [ -n "$2" ]; then
    log "WARNING: --allow-downgrade: installing release $NEW_RELEASE of the $channel channel over release $have, as ${SUDO_USER:-root} asked"
    logger -t taskiem-vps -p auth.warning "update --allow-downgrade by ${SUDO_USER:-root}: release $NEW_RELEASE ($1) over release $have" 2>/dev/null || true
    return 0
  fi
  refuse_release "$1" "$1 is release $NEW_RELEASE of the $channel channel, not newer than release $have running here: refusing it (to go back on purpose, a person runs taskiem-vps update --now --allow-downgrade)"
}

# A refused release is remembered, so the timer does not check and alert
# about it on every tick; the alert goes out once.
refuse_release() { # REF MESSAGE
  if [ "$1" != "$(cat "$STATE/update-failed" 2>/dev/null || true)" ]; then
    printf '%s\n' "$1" >"$STATE/update-failed"
    notify "release refused" "$2. The $(conf CHANNEL) tag in the registry names an image this server will not install. If nobody meant that, someone may have moved the tag: check the registry."
  fi
  die "$2"
}

# Keep the newest trusted root cosign fetched, for a day the metadata
# sources are all unreachable.
save_trusted_root() {
  local f
  f=$(find "${HOME:-/root}/.sigstore/root" -name trusted_root.json -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
  [ -n "$f" ] || return 0
  cmp -s "$f" "$STATE/trusted_root.json" 2>/dev/null || install -m 0644 "$f" "$STATE/trusted_root.json"
}

# The commit an image was built from (OCI revision label), for the matching kit.
image_revision() { docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$1" 2>/dev/null || true; }

# Replace the kit (Compose file, configs, this tool, timers) with the copy
# from the commit the image was built from. Env files are never touched.
sync_kit() { # REVISION
  local rev=$1 tmp
  [ -n "$rev" ] || { log "image has no revision label: keeping the installed kit"; return 0; }
  [ -z "${TASKIEM_VPS_KIT_SOURCE:-}" ] || { log "kit from $TASKIEM_VPS_KIT_SOURCE (local source): not syncing"; return 0; }
  tmp=$(mktemp -d)
  curl -fsSL "https://codeload.github.com/$REPO_SLUG/tar.gz/$rev" | tar -xz -C "$tmp" --strip-components=3 --wildcards "*/deploy/vm" ||
    { rm -rf "$tmp"; die "could not fetch the deployment kit for $rev"; }
  install_kit "$tmp"
  rm -rf "$tmp"
}

install_kit() { # DIR
  local src=$1 f
  # A kit whose taskiem-vps does not know external-proxy mode would start
  # Taskiem's own Caddy on ports another Caddy holds: refused before
  # anything changes.
  if external_proxy && ! grep -q "$PROXY_COMPOSE" "$src/taskiem-vps"; then
    die "this release's deployment kit is from before external-proxy mode, which this server uses (PROXY=external in $ETC/vps.conf): not installing it"
  fi
  for f in docker-compose.yml Caddyfile openbao.hcl openbao-taskiem-policy.hcl; do
    install -m 0644 "$src/$f" "$KIT/$f"
  done
  # Kits from before the public host (a rollback) have no public.caddy.
  if [ -f "$src/public.caddy" ]; then
    install -m 0644 "$src/public.caddy" "$KIT/public.caddy"
    [ ! -f "$KIT/caddy.d/public.caddy" ] || install -m 0644 "$src/public.caddy" "$KIT/caddy.d/public.caddy"
  else
    rm -f "$KIT/caddy.d/public.caddy"
  fi
  install -m 0755 "$src/taskiem-vps" "$BIN/taskiem-vps.new" && mv -f "$BIN/taskiem-vps.new" "$BIN/taskiem-vps"
  if [ -z "${TASKIEM_VPS_NO_TIMERS:-}" ] && [ -d /run/systemd/system ]; then
    install -m 0644 "$src"/systemd/taskiem-vps-*.service "$src"/systemd/taskiem-vps-*.timer /etc/systemd/system/
    systemctl daemon-reload
  fi
}

# The SCRAM-SHA-256 verifier of a password (read on stdin, so it is on no
# command line), from the release's own taskiem, without a network.
scram_verifier() { # IMAGE PASSWORD
  local v
  v=$(printf '%s\n' "$2" | docker run --rm -i --network none "$1" scram-verifier) || die "could not make the password's verifier with $1"
  case $v in SCRAM-SHA-256\$*) ;; *) die "unexpected password verifier from $1" ;; esac
  case $v in *"'"* | *'$$'*) die "unexpected password verifier from $1" ;; esac
  printf '%s' "$v"
}

# psql (libpq) checks a verify-full certificate against
# ~/.postgresql/root.crt unless told to use the system's roots, which is
# what a managed service's certificate from a public CA (Xenibase's) needs.
# Taskiem itself (pgx) uses the system's roots already.
psql_dsn() { # URL
  case $1 in
  *sslrootcert=*) printf '%s' "$1" ;;
  *sslmode=verify-full* | *sslmode=verify-ca*) printf '%s&sslrootcert=system' "$1" ;;
  *) printf '%s' "$1" ;;
  esac
}

# Ask Xenibase to sync the owner's new logins to its poolers now, instead
# of at its next 30-second sweep: only with TASKIEM_VPS_XENIBASE_URL,
# _XENIBASE_TOKEN (an API token) and _XENIBASE_PROJECT (the project's id)
# in the environment. Nothing is kept. The token goes on standard input,
# not the command line.
xenibase_sync() {
  local url=${TASKIEM_VPS_XENIBASE_URL:-} token=${TASKIEM_VPS_XENIBASE_TOKEN:-} project=${TASKIEM_VPS_XENIBASE_PROJECT:-}
  [ -n "$url" ] && [ -n "$token" ] && [ -n "$project" ] || return 0
  if printf 'Authorization: Bearer %s\n' "$token" |
    curl -fsS --max-time 30 -X POST -H @- "${url%/}/api/v1/projects/$project/manage-roles/sync" >/dev/null; then
    log "Xenibase synced the database's logins to its poolers"
  else
    log "WARNING: Xenibase's sync did not answer; waiting for its 30-second sweep instead"
  fi
}

# The first sign-in as a login setup just made. A pooler takes a new login
# only once it knows it: a Xenibase dedicated project syncs its owner's
# logins every 30 seconds. So wait for it, up to TASKIEM_VPS_LOGIN_WAIT
# seconds (90), and say why.
wait_for_login() { # ROLE URL
  local role=$1 dsn wait=${TASKIEM_VPS_LOGIN_WAIT:-90} deadline said=""
  dsn=$(psql_dsn "$2")
  deadline=$((SECONDS + wait))
  until echo 'SELECT 1' | docker run --rm -i --network host -e DSN="$dsn" "$PSQL_IMAGE" sh -c 'psql "$DSN" -qAt -v ON_ERROR_STOP=1' >/dev/null 2>&1; do
    [ $SECONDS -lt $deadline ] || die "$role cannot sign in to the database after $wait seconds. On a Xenibase dedicated project: role management must be on (Project Settings > Compute > Database roles), the URL must be the session pooler's (port 5432), and POST /api/v1/projects/<id>/manage-roles/sync says why a login is not synced. On another server: its pg_hba.conf must let $role in"
    if [ -z "$said" ]; then
      log "waiting for the database to accept $role (a pooler takes a new login when it is synced: on Xenibase within 30 seconds)"
      said=1
    fi
    sleep "${TASKIEM_VPS_LOGIN_POLL:-5}"
  done
  [ -z "$said" ] || log "$role signs in"
}

set_image() { # REF
  env_set "$KIT/.env" TASKIEM_IMAGE "$1"
  printf '%s\n' "$1" >"$STATE/current"
}

# Healthy container and the public front door answering readyz.
wait_healthy() { # SECONDS
  local deadline=$((SECONDS + $1)) id status
  while [ $SECONDS -lt $deadline ]; do
    id=$(compose ps -q taskiem 2>/dev/null || true)
    status=""
    if [ -n "$id" ]; then status=$(docker inspect -f '{{.State.Health.Status}}' "$id" 2>/dev/null || true); fi
    if [ "$status" = healthy ] && local_https /readyz >/dev/null 2>&1 && public_healthy && mail_healthy; then return 0; fi
    sleep 3
  done
  return 1
}

# The public host, when public pages are on, healthy too.
public_healthy() {
  [ "$(conf PUBLIC)" = yes ] || return 0
  # A release from before the public host (a rollback) has no such service.
  compose config --services 2>/dev/null | grep -x taskiem-public >/dev/null || return 0
  local id
  id=$(compose ps -q taskiem-public 2>/dev/null || true)
  [ -n "$id" ] && [ "$(docker inspect -f '{{.State.Health.Status}}' "$id" 2>/dev/null || true)" = healthy ]
}

# The mail role, when a mail domain is set, healthy too.
mail_healthy() {
  [ -n "$(conf MAIL_DOMAIN)" ] || return 0
  # A release from before email triggers (a rollback) has no such service.
  compose config --services 2>/dev/null | grep -x taskiem-mail >/dev/null || return 0
  local id
  id=$(compose ps -q taskiem-mail 2>/dev/null || true)
  [ -n "$id" ] && [ "$(docker inspect -f '{{.State.Health.Status}}' "$id" 2>/dev/null || true)" = healthy ]
}

in_window() {
  local window tz now start end
  window=$(conf WINDOW)
  [ -n "$window" ] || return 0
  tz=$(conf TZ)
  now=$(TZ=${tz:-Africa/Lagos} date +%H%M)
  start=${window%-*} end=${window#*-}
  start=${start/:/} end=${end/:/}
  if [ "$start" -le "$end" ]; then [ "$now" -ge "$start" ] && [ "$now" -lt "$end" ]; else [ "$now" -ge "$start" ] || [ "$now" -lt "$end" ]; fi
}

# --- alerts ------------------------------------------------------------------

# NOTIFY_SENT says whether the last alert reached anyone: yes when a
# channel took it, or when no channel is configured (the log is then the
# only alert there is). notify itself never fails, so callers need not
# guard it.
NOTIFY_SENT=yes
notify() { # SUBJECT BODY
  local subject body=$2 smtp from to webhook msg tried=0 sent=0
  subject="[Taskiem $(conf DOMAIN)] $1"
  log "ALERT: $1"
  to=$(conf ALERT_EMAIL)
  smtp=$(env_get "$KIT/taskiem.env" TASKIEM_SMTP_URL)
  from=$(env_get "$KIT/taskiem.env" TASKIEM_ALERT_FROM)
  if [ -n "$to" ] && [ -n "$smtp" ]; then
    msg=$(mktemp)
    printf 'From: %s\r\nTo: %s\r\nSubject: %s\r\nDate: %s\r\n\r\n%s\r\n' "$from" "$to" "$subject" "$(date -R)" "$body" >"$msg"
    local tls=()
    [ "${smtp%%://*}" != smtp ] || tls=(--ssl-reqd) # smtp:// must upgrade with STARTTLS
    tried=$((tried + 1))
    if curl -fsS --max-time 30 "${tls[@]}" --url "$smtp" --mail-from "$from" --mail-rcpt "$to" --upload-file "$msg" >/dev/null; then
      sent=$((sent + 1))
    else
      log "alert email failed"
    fi
    rm -f "$msg"
  fi
  webhook=$(conf ALERT_WEBHOOK)
  if [ -n "$webhook" ]; then
    tried=$((tried + 1))
    if jq -n --arg text "$subject"$'\n'"$body" '{text: $text}' |
      curl -fsS --max-time 15 -H 'Content-Type: application/json' -d @- "$webhook" >/dev/null; then
      sent=$((sent + 1))
    else
      log "alert webhook failed"
    fi
  fi
  NOTIFY_SENT=yes
  if [ "$tried" -gt 0 ] && [ "$sent" -eq 0 ]; then
    NOTIFY_SENT=no
    # Nobody was told: say so where a person watching the server looks.
    log "ERROR: the alert \"$1\" could not be sent by any channel"
    logger -t taskiem-vps -p daemon.err "alert could not be sent by any channel: $subject: $body" 2>/dev/null || true
  fi
  return 0
}

# The owner's first password, when no email could carry a set-your-password
# link: shown on the terminal when a person is at one; otherwise written to
# a file only root can read, and its path logged. Never to standard output:
# an unattended install's output is kept by cloud-init and CI logs.
hand_over_password() { # EMAIL PASSWORD
  local f
  if { true >/dev/tty; } 2>/dev/null; then
    printf '\nOwner %s, first password (shown once, change it at first sign-in): %s\n\n' "$1" "$2" >/dev/tty
    return 0
  fi
  f="${TASKIEM_VPS_ROOT_HOME:-/root}/taskiem-owner-password-$(date +%F).txt"
  (
    umask 077
    printf 'Taskiem owner: %s\nFirst password: %s\n\nSign in, change it, then delete this file (shred -u).\n' "$1" "$2" >"$f"
  )
  chmod 600 "$f"
  log "the owner's first password is in $f (readable by root only): give it to $1, then delete the file (shred -u)"
}

# --- commands ----------------------------------------------------------------

cmd_setup() {
  need_root setup
  command -v docker >/dev/null || die "Docker is not installed (run install.sh)"
  docker compose version >/dev/null || die "the Docker Compose plugin is missing"
  command -v jq >/dev/null || die "jq is missing (run install.sh)"
  mkdir -p "$KIT" "$ETC" "$STATE" && chmod 700 "$ETC" "$STATE"
  touch "$ETC/vps.conf" && chmod 600 "$ETC/vps.conf"
  [ -f "$KIT/docker-compose.yml" ] || die "no deployment kit in $KIT (run install.sh)"

  # ALERT_EMAIL and ALERT_WEBHOOK are read indirectly (${!f}) when saved below.
  # shellcheck disable=SC2034
  local DOMAIN OWNER_EMAIL ORG DATABASE_URL SMTP_URL MAIL_FROM CHANNEL WINDOW ALERT_EMAIL ALERT_WEBHOOK BACKUP_REPO BACKUP_KEY_ID BACKUP_SECRET TELEGRAM_BOT_TOKEN TELEGRAM_BOT_USERNAME PUBLIC PREVIEW_DOMAIN MAIL_DOMAIN ISWALLET_URL PAYROLLA_URL
  local PROXY PROXY_DIR PROXY_CONTAINER PROXY_NETWORK
  echo "Taskiem setup. Press Enter to keep the value in brackets." >&2
  ask DOMAIN "Public host name (DNS must point here)" "$(conf DOMAIN)"
  ask OWNER_EMAIL "Owner's email (receives the set-your-password link)" "$(conf OWNER_EMAIL)"
  ask ORG "Organisation name" "$(conf ORG)"
  ask_secret DATABASE_URL "Postgres 16+ URL of an empty database, as its owner (needs CREATEROLE; on Xenibase, a dedicated project's session pooler URL)" "$(env_get "$KIT/migrate.env" TASKIEM_DATABASE_URL)"
  ask_secret SMTP_URL "SMTP URL (smtps://user:pass@host:465)" "$(env_get "$KIT/taskiem.env" TASKIEM_SMTP_URL)"
  ask MAIL_FROM "Sender address for email" "$(env_get "$KIT/taskiem.env" TASKIEM_ALERT_FROM)"
  ask_secret TELEGRAM_BOT_TOKEN "Telegram bot token from @BotFather (empty: no Telegram)" "$(env_get "$KIT/taskiem.env" TASKIEM_TELEGRAM_BOT_TOKEN)"
  if [ -n "$TELEGRAM_BOT_TOKEN" ]; then
    ask TELEGRAM_BOT_USERNAME "Telegram bot username, without @" "$(env_get "$KIT/taskiem.env" TASKIEM_TELEGRAM_BOT_USERNAME)"
    TELEGRAM_BOT_USERNAME=${TELEGRAM_BOT_USERNAME#@}
    [ -n "$TELEGRAM_BOT_USERNAME" ] || die "the bot's username is required with its token"
  fi
  # Provider endpoints (docs/operations.md): the live addresses. iswallet
  # and Payrolla connections are live or test, chosen when made; test goes
  # to each provider's sandbox.
  ask ISWALLET_URL "iswallet API URL (empty: iswallet's production API)" "$(env_get "$KIT/taskiem.env" TASKIEM_ISWALLET_URL)"
  ask PAYROLLA_URL "Payrolla API URL (empty: Payrolla's production API)" "$(env_get "$KIT/taskiem.env" TASKIEM_PAYROLLA_URL)"
  local u
  for u in "$ISWALLET_URL" "$PAYROLLA_URL"; do
    [ -z "$u" ] || [[ $u =~ ^https://[^[:space:]]+$ ]] || die "provider URLs must start with https:// ($u)"
  done
  # Storefronts and hosted forms (Phase 5): off until they ship.
  ask PUBLIC "Public pages for storefronts and forms (yes or no)" "$(conf PUBLIC || true)"
  PUBLIC=${PUBLIC:-no}
  case $PUBLIC in yes | no) ;; *) die "public pages: answer yes or no" ;; esac
  if [ "$PUBLIC" = yes ]; then
    ask PREVIEW_DOMAIN "Preview domain for storefronts, such as shops.example.com (point *.<it> here)" "$(conf PREVIEW_DOMAIN)"
    PREVIEW_DOMAIN=${PREVIEW_DOMAIN,,}
    [[ $PREVIEW_DOMAIN =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]] || die "the preview domain must be a host name such as shops.example.com"
  fi
  # Email triggers (docs/email.md): mail for <id>@<mail domain> comes to
  # this server on port 25; its MX record names this server's host name.
  ask MAIL_DOMAIN "Mail domain for email triggers, such as in.example.com, its MX record pointing at this server's host name (empty: off)" "$(conf MAIL_DOMAIN || true)"
  MAIL_DOMAIN=${MAIL_DOMAIN,,}
  if [ -n "$MAIL_DOMAIN" ]; then
    [[ $MAIL_DOMAIN =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]] || die "the mail domain must be a domain such as in.example.com"
  fi
  local first_run=""
  [ -n "$(conf CHANNEL)" ] || first_run=1
  ask CHANNEL "Release channel: staging (upgrades on every merge) or production (upgrades on approved versions)" "$(conf CHANNEL)"
  CHANNEL=${CHANNEL:-staging}
  local default_window
  default_window=$(conf WINDOW)
  if [ -n "$first_run" ] && [ "$CHANNEL" = production ]; then default_window=01:00-05:00; fi
  ask WINDOW "Upgrade window, Africa/Lagos time, like 01:00-05:00 ('any' for any time)" "${default_window:-any}"
  [ "$WINDOW" != any ] || WINDOW=""
  ask ALERT_EMAIL "Alert email (empty: none)" "$(conf ALERT_EMAIL)"
  ask ALERT_WEBHOOK "Alert webhook, Slack-compatible (empty: none)" "$(conf ALERT_WEBHOOK)"
  # HTTPS: Taskiem's own Caddy, or another Caddy on this server that holds
  # ports 80 and 443 (Xenibase's), which then serves Taskiem's sites too.
  ask PROXY "HTTPS: own (Taskiem's Caddy) or external (another Caddy on this server, such as Xenibase's)" "$(conf PROXY || true)"
  PROXY=${PROXY:-own}
  case $PROXY in own | external) ;; *) die "HTTPS: answer own or external" ;; esac
  if [ "$PROXY" = external ]; then
    ask PROXY_DIR "The other Caddy's site directory on this server, which its Caddyfile imports (Xenibase's deploy/compose/caddy.d)" "$(conf PROXY_DIR)"
    ask PROXY_CONTAINER "The other Caddy's container" "$(conf PROXY_CONTAINER || true)"
    PROXY_CONTAINER=${PROXY_CONTAINER:-xenibase-caddy-1}
    ask PROXY_NETWORK "The Docker network Taskiem and that Caddy share" "$(conf PROXY_NETWORK || true)"
    PROXY_NETWORK=${PROXY_NETWORK:-cohost}
    PROXY_DIR=${PROXY_DIR%/}
    [[ $PROXY_DIR == /* ]] && [ -d "$PROXY_DIR" ] || die "the other Caddy's site directory must be an existing absolute path ($PROXY_DIR)"
    [[ $PROXY_CONTAINER =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "not a container name: $PROXY_CONTAINER"
    [[ $PROXY_NETWORK =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "not a network name: $PROXY_NETWORK"
    # Written into the other Caddy's configuration as it is.
    [[ ${DOMAIN,,} =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]] || die "the host name must be a name such as app.example.com ($DOMAIN)"
  else
    PROXY_DIR="" PROXY_CONTAINER="" PROXY_NETWORK=""
  fi
  ask BACKUP_REPO "Backup destination, restic repository such as s3:https://host/bucket/taskiem (empty: no backups)" "$(env_get "$ETC/backup.env" RESTIC_REPOSITORY)"
  if [ -n "$BACKUP_REPO" ]; then
    ask BACKUP_KEY_ID "Backup access key id" "$(env_get "$ETC/backup.env" AWS_ACCESS_KEY_ID)"
    ask_secret BACKUP_SECRET "Backup secret key" "$(env_get "$ETC/backup.env" AWS_SECRET_ACCESS_KEY)"
  fi

  if [ -z "$DOMAIN" ] || [ -z "$OWNER_EMAIL" ] || [ -z "$ORG" ] || [ -z "$DATABASE_URL" ]; then
    die "domain, owner email, organisation and database URL are required"
  fi
  case $CHANNEL in staging | production) ;; *) die "channel must be staging or production" ;; esac
  [[ $DATABASE_URL =~ ^(postgres(ql)?://)([^@/]*@)?([^/?]+)/([A-Za-z0-9_]+)(\?.*)?$ ]] || die "database URL must look like postgres://user:password@host:5432/dbname?sslmode=verify-full"
  local dsn_scheme=${BASH_REMATCH[1]} dsn_host=${BASH_REMATCH[4]} dbname=${BASH_REMATCH[5]} dsn_query=${BASH_REMATCH[6]}
  # Taskiem LISTENs for notifications, which needs a session of its own: a
  # transaction pooler (6543, Xenibase's and others') cannot carry it.
  case $dsn_host in *:6543) die "port 6543 is a transaction pooler's: Taskiem needs a session (it LISTENs); give the session pooler's URL (port 5432)" ;; esac
  # Its logins are named <database>_app and <database>_public: for a
  # database named taskiem those are Taskiem's own group roles, which the
  # migrations make and nothing may sign in as.
  case ${dbname,,} in
  taskiem | taskiem_dispatch) die "the database may not be named $dbname: its login roles would take the names of Taskiem's own roles; name it, for example, taskiem_staging or taskiem_prod" ;;
  esac
  [ -n "$SMTP_URL" ] || log "WARNING: no SMTP: no password emails, invitations or alert emails"
  [ -z "$SMTP_URL" ] || [ -n "$MAIL_FROM" ] || die "a sender address is required with SMTP"
  [ -n "$BACKUP_REPO" ] || log "WARNING: no backup destination: OpenBao's storage is not backed up off this server"

  local f
  [ "$PUBLIC" != yes ] || [ "$PREVIEW_DOMAIN" != "${DOMAIN,,}" ] || die "the preview domain must differ from the app's host name"
  [ -z "$MAIL_DOMAIN" ] || [ "$MAIL_DOMAIN" != "${DOMAIN,,}" ] || die "the mail domain must differ from the app's host name (use a subdomain, such as in.${DOMAIN,,})"
  # The other Caddy this server used before, if setup moves it.
  local old_proxy_dir="" old_proxy_container=""
  if external_proxy && { [ "$PROXY" != external ] || [ "$(conf PROXY_DIR)" != "$PROXY_DIR" ]; }; then
    old_proxy_dir=$(conf PROXY_DIR) old_proxy_container=$(conf PROXY_CONTAINER)
  fi
  for f in DOMAIN OWNER_EMAIL ORG CHANNEL WINDOW ALERT_EMAIL ALERT_WEBHOOK PUBLIC PREVIEW_DOMAIN MAIL_DOMAIN PROXY PROXY_DIR PROXY_CONTAINER PROXY_NETWORK; do env_set "$ETC/vps.conf" "$f" "${!f:-}"; done
  env_set "$ETC/vps.conf" TZ Africa/Lagos

  # Secrets made once, never regenerated.
  local unseal anchor apppw resticpw fresh=""
  unseal=$(env_get "$KIT/openbao-unseal.env" BAO_STATIC_UNSEAL_KEY)
  [ -n "$unseal" ] || { unseal=$(hex 32); fresh=1; }
  anchor=$(env_get "$KIT/taskiem.env" TASKIEM_ANCHOR_KEY)
  [ -n "$anchor" ] || anchor=$(openssl rand -base64 32)
  apppw=$(env_get "$ETC/secrets.env" APP_DB_PASSWORD)
  [ -n "$apppw" ] || apppw=$(hex 24)
  local pubpw
  pubpw=$(env_get "$ETC/secrets.env" PUBLIC_DB_PASSWORD)
  [ -n "$pubpw" ] || pubpw=$(hex 24)
  env_set "$ETC/secrets.env" PUBLIC_DB_PASSWORD "$pubpw"
  resticpw=$(env_get "$ETC/backup.env" RESTIC_PASSWORD)
  [ -n "$resticpw" ] || resticpw=$(hex 32)
  env_set "$ETC/secrets.env" APP_DB_PASSWORD "$apppw"

  local approle="${dbname}_app"
  env_set "$KIT/openbao-unseal.env" BAO_STATIC_UNSEAL_KEY "$unseal"
  env_set "$KIT/migrate.env" TASKIEM_DATABASE_URL "$DATABASE_URL"
  local t="$KIT/taskiem.env"
  env_set "$t" TASKIEM_DATABASE_URL "${dsn_scheme}${approle}:${apppw}@${dsn_host}/${dbname}${dsn_query}"
  env_set "$t" TASKIEM_KMS openbao
  env_set "$t" TASKIEM_OPENBAO_ADDR http://openbao:8200
  env_set "$t" TASKIEM_KMS_KEY taskiem
  env_set "$t" TASKIEM_PUBLIC_URL "https://$DOMAIN"
  env_set "$t" TASKIEM_TRUST_PROXY true
  env_set "$t" TASKIEM_WORKER_QUEUES connector,sandbox,ai # ai: AI steps (docs/ai.md#ai-steps)
  env_set "$t" TASKIEM_WASM_CACHE /cache/wazero
  env_set "$t" TASKIEM_ARCHIVE_DIR /var/lib/taskiem/archive
  env_set "$t" TASKIEM_ANCHOR_DIR /var/lib/taskiem/anchors
  env_set "$t" TASKIEM_ANCHOR_KEY "$anchor"
  env_set "$t" TASKIEM_SMTP_URL "$SMTP_URL"
  env_set "$t" TASKIEM_ALERT_FROM "$MAIL_FROM"
  env_set "$t" TASKIEM_ALLOW_SIGNUP false
  env_set "$t" TASKIEM_ISWALLET_URL "$ISWALLET_URL"
  env_set "$t" TASKIEM_PAYROLLA_URL "$PAYROLLA_URL"
  # Telegram (docs/telegram.md): Taskiem registers its webhook at start.
  env_set "$t" TASKIEM_TELEGRAM_BOT_TOKEN "$TELEGRAM_BOT_TOKEN"
  env_set "$t" TASKIEM_TELEGRAM_BOT_USERNAME "${TELEGRAM_BOT_USERNAME:-}"
  if [ -n "$TELEGRAM_BOT_TOKEN" ]; then
    [ -n "$(env_get "$t" TASKIEM_TELEGRAM_WEBHOOK_SECRET)" ] || env_set "$t" TASKIEM_TELEGRAM_WEBHOOK_SECRET "$(hex 32)"
    # Signs approval buttons while WhatsApp is off.
    [ -n "$(env_get "$t" TASKIEM_CHAT_TOKEN_KEY)" ] || env_set "$t" TASKIEM_CHAT_TOKEN_KEY "$(openssl rand -base64 32)"
  fi
  # The public host (docs/public-host.md): its own login, a member of
  # taskiem_public only, and nothing else of the platform's.
  local pubrole="${dbname}_public" p="$KIT/public.env" pubkey hashkey
  touch "$p" && chmod 600 "$p"
  # The storefront's key (forms and the inbox, the same on both containers)
  # and the hash key for customers' message limits: made once.
  pubkey=$(env_get "$t" TASKIEM_PUBLIC_KEY)
  [ -n "$pubkey" ] || pubkey=$(openssl rand -base64 32)
  env_set "$t" TASKIEM_PUBLIC_KEY "$pubkey"
  hashkey=$(env_get "$t" TASKIEM_MESSAGE_HASH_KEY)
  [ -n "$hashkey" ] || hashkey=$(openssl rand -base64 32)
  env_set "$t" TASKIEM_MESSAGE_HASH_KEY "$hashkey"
  mkdir -p "$KIT/caddy.d"
  if [ "$PUBLIC" = yes ]; then
    env_set "$p" TASKIEM_PUBLIC_DATABASE_URL "${dsn_scheme}${pubrole}:${pubpw}@${dsn_host}/${dbname}${dsn_query}"
    env_set "$p" TASKIEM_TRUST_PROXY true
    env_set "$p" TASKIEM_PUBLIC_DOMAINS "$PREVIEW_DOMAIN"
    env_set "$p" TASKIEM_PUBLIC_KEY "$pubkey"
    env_set "$t" TASKIEM_PUBLIC_DOMAINS "$PREVIEW_DOMAIN"
    install -m 0644 "$KIT/public.caddy" "$KIT/caddy.d/public.caddy"
  else
    env_set "$t" TASKIEM_PUBLIC_DOMAINS ""
    rm -f "$KIT/caddy.d/public.caddy"
  fi
  # The mail role (docs/email.md): the public host's login and key, in a
  # file of its own so it runs whether public pages are on or not.
  local m="$KIT/mail.env" profiles=()
  touch "$m" && chmod 600 "$m"
  if [ -n "$MAIL_DOMAIN" ]; then
    env_set "$m" TASKIEM_PUBLIC_DATABASE_URL "${dsn_scheme}${pubrole}:${pubpw}@${dsn_host}/${dbname}${dsn_query}"
    env_set "$m" TASKIEM_PUBLIC_KEY "$pubkey"
    env_set "$m" TASKIEM_MAIL_DOMAIN "$MAIL_DOMAIN"
    env_set "$m" TASKIEM_MAIL_HOSTNAME "${DOMAIN,,}"
    profiles+=(mail)
  fi
  # The app shows addresses and takes the mail the mail role leaves.
  env_set "$t" TASKIEM_MAIL_DOMAIN "$MAIL_DOMAIN"
  [ "$PUBLIC" != yes ] || profiles+=(public)
  # Files sent in forms or kept from emails are scanned by the clamav
  # container (docs/forms.md#files, docs/email.md).
  if [ ${#profiles[@]} -gt 0 ]; then env_set "$t" TASKIEM_CLAMD_ADDR clamav:3310; else env_set "$t" TASKIEM_CLAMD_ADDR ""; fi
  env_set "$KIT/.env" COMPOSE_PROFILES "$(IFS=,; echo "${profiles[*]}")"
  touch "$KIT/openbao.env" && chmod 600 "$KIT/openbao.env"
  env_set "$KIT/.env" TASKIEM_DOMAIN "$DOMAIN"
  env_set "$KIT/.env" OPENBAO_IMAGE "$OPENBAO_IMAGE"
  if [ -n "$BACKUP_REPO" ]; then
    env_set "$ETC/backup.env" RESTIC_REPOSITORY "$BACKUP_REPO"
    env_set "$ETC/backup.env" RESTIC_PASSWORD "$resticpw"
    env_set "$ETC/backup.env" AWS_ACCESS_KEY_ID "$BACKUP_KEY_ID"
    env_set "$ETC/backup.env" AWS_SECRET_ACCESS_KEY "$BACKUP_SECRET"
  fi

  # Before the first Compose command: in external-proxy mode its file names the shared network.
  if [ "$PROXY" = external ]; then
    proxy_prepare
  else
    rm -f "$KIT/$PROXY_COMPOSE"
    env_unset "$KIT/.env" COMPOSE_FILE
  fi

  log "checking the database"
  local owner_dsn
  owner_dsn=$(psql_dsn "$DATABASE_URL")
  echo 'SELECT 1' | docker run --rm -i --network host -e DSN="$owner_dsn" "$PSQL_IMAGE" sh -c 'psql "$DSN" -qAt -v ON_ERROR_STOP=1' >/dev/null ||
    die "cannot reach the database with that URL"

  # The release: the channel's newest signed image (or a local test image).
  local ref
  if test_mode; then
    ref=$TASKIEM_VPS_IMAGE_OVERRIDE
  elif [ -s "$STATE/current" ]; then
    ref=$(cat "$STATE/current")
  else
    ref="$IMAGE_REPO@$(channel_digest)"
    verify_image "$ref"
  fi
  set_image "$ref"
  if ! test_mode; then
    docker pull --quiet "$ref" >/dev/null
    sync_kit "$(image_revision "$ref")" # the kit from the commit this release was built from
    compose pull --quiet
  fi

  # OpenBao: start, initialise once (auto-unseals with the static key), then
  # Taskiem's transit key, policy and periodic token; the root token is revoked.
  log "starting OpenBao"
  compose up -d openbao
  # bao status exits 0 when unsealed, 2 when sealed or not initialised, 1 on error.
  local rc st
  for _ in $(seq 60); do rc=0; compose exec -T openbao bao status >/dev/null 2>&1 || rc=$?; [ "$rc" = 1 ] || break; sleep 2; done
  st=$(compose exec -T openbao bao status -format=json 2>/dev/null || true)
  if [ "$(jq -r '.initialized // false' <<<"$st" 2>/dev/null)" != true ]; then
    log "initialising OpenBao"
    local init root
    init=$(compose exec -T openbao bao operator init -format=json -recovery-shares=5 -recovery-threshold=3)
    root=$(jq -r .root_token <<<"$init")
    for _ in $(seq 30); do compose exec -T openbao bao status >/dev/null 2>&1 && break; sleep 2; done
    compose exec -T openbao bao status >/dev/null 2>&1 || die "OpenBao did not unseal itself after initialising"
    local token
    token=$(compose exec -T -e BAO_TOKEN="$root" openbao sh -ec '
      bao secrets enable transit >/dev/null
      bao write -f transit/keys/taskiem >/dev/null
      bao policy write taskiem /openbao/policies/taskiem.hcl >/dev/null
      bao token create -policy=taskiem -no-default-policy -orphan -period=768h -display-name=taskiem -field=token')
    compose exec -T -e BAO_TOKEN="$root" openbao bao token revoke -self >/dev/null
    env_set "$KIT/openbao.env" TASKIEM_OPENBAO_TOKEN "$token"
    write_recovery_sheet "$unseal" "$(jq -r '.recovery_keys_b64[]' <<<"$init")" "$anchor" "$resticpw"
  elif [ -n "$fresh" ]; then
    die "OpenBao is initialised but its unseal key is missing from $KIT/openbao-unseal.env: restore it from the recovery sheet"
  fi
  [ -n "$(env_get "$KIT/openbao.env" TASKIEM_OPENBAO_TOKEN)" ] || die "Taskiem's OpenBao token is missing from $KIT/openbao.env"

  log "migrating the database"
  compose run --rm migrate

  log "creating the database role Taskiem signs in as ($approle)"
  # Each login's password goes to Postgres as its SCRAM verifier, made by
  # this release's taskiem from stdin: Postgres logs a failing statement's
  # text, and the password is never in it.
  local appver pubver
  appver=$(scram_verifier "$ref" "$apppw")
  docker run --rm -i --network host -e DSN="$owner_dsn" "$PSQL_IMAGE" sh -c 'psql "$DSN" -qAt -v ON_ERROR_STOP=1' <<SQL >/dev/null
DO \$\$ BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '$approle') THEN
    CREATE ROLE "$approle" LOGIN PASSWORD '$appver';
  ELSE
    ALTER ROLE "$approle" LOGIN PASSWORD '$appver';
  END IF;
END \$\$;
GRANT taskiem_app TO "$approle";
SQL

  # The public host's login exists only while public pages or mail are on.
  [ -n "$MAIL_DOMAIN" ] || compose rm -sf taskiem-mail >/dev/null 2>&1 || true
  if [ "$PUBLIC" = yes ] || [ -n "$MAIL_DOMAIN" ]; then
    log "creating the database role the public host signs in as ($pubrole)"
    pubver=$(scram_verifier "$ref" "$pubpw")
    docker run --rm -i --network host -e DSN="$owner_dsn" "$PSQL_IMAGE" sh -c 'psql "$DSN" -qAt -v ON_ERROR_STOP=1' <<SQL >/dev/null
DO \$\$ BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '$pubrole') THEN
    CREATE ROLE "$pubrole" LOGIN NOINHERIT PASSWORD '$pubver';
  ELSE
    ALTER ROLE "$pubrole" LOGIN NOINHERIT PASSWORD '$pubver';
  END IF;
END \$\$;
GRANT taskiem_public TO "$pubrole";
SQL
  else
    docker run --rm -i --network host -e DSN="$owner_dsn" "$PSQL_IMAGE" sh -c 'psql "$DSN" -qAt -v ON_ERROR_STOP=1' <<SQL >/dev/null
DO \$\$ BEGIN
  IF EXISTS (SELECT FROM pg_roles WHERE rolname = '$pubrole') THEN ALTER ROLE "$pubrole" NOLOGIN; END IF;
END \$\$;
SQL
    compose rm -sf taskiem-public >/dev/null 2>&1 || true
  fi
  [ "$PUBLIC" = yes ] || compose rm -sf taskiem-public >/dev/null 2>&1 || true

  # The logins reach the database before Taskiem signs in as them: through
  # a pooler, such as a Xenibase project's, only once it has synced them.
  xenibase_sync
  wait_for_login "$approle" "$(env_get "$t" TASKIEM_DATABASE_URL)"
  if [ "$PUBLIC" = yes ] || [ -n "$MAIL_DOMAIN" ]; then
    wait_for_login "$pubrole" "${dsn_scheme}${pubrole}:${pubpw}@${dsn_host}/${dbname}${dsn_query}"
  fi

  # Taskiem's own Caddy, if this server had it until now.
  [ "$PROXY" != external ] || docker compose --project-directory "$KIT" -f "$KIT/docker-compose.yml" rm -sf caddy >/dev/null 2>&1 || true
  proxy_unpublish "$old_proxy_dir" "$old_proxy_container"

  log "starting Taskiem"
  compose up -d --remove-orphans
  if [ "$PROXY" = external ]; then
    proxy_publish force || die "the Caddy in $PROXY_CONTAINER did not take Taskiem's sites: its Caddyfile must import $PROXY_DIR's *.global in its global options and *.caddy (docs/vm.md#sharing-the-server-with-xenibase)"
  fi
  wait_healthy 300 || die "Taskiem did not become healthy: taskiem-vps logs"
  if [ "$PROXY" != external ]; then
    # Caddy reads caddy.d/ only when told: public pages on or off.
    compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 ||
      compose restart caddy >/dev/null
  fi

  if [ ! -f "$STATE/bootstrapped" ]; then
    log "creating the organisation and its owner"
    local pw
    pw=$(hex 16)
    # By name only: the value travels in the environment, not on a command
    # line that every process on the server can read.
    TASKIEM_BOOTSTRAP_PASSWORD="$pw" compose run --rm --no-deps -e TASKIEM_BOOTSTRAP_PASSWORD taskiem bootstrap --tenant "$ORG" --email "$OWNER_EMAIL" >/dev/null
    touch "$STATE/bootstrapped"
    if [ -n "$SMTP_URL" ] && owner_reset_email; then
      log "$OWNER_EMAIL has been sent a link to set their password"
    else
      hand_over_password "$OWNER_EMAIL" "$pw"
    fi
  fi

  if [ -n "$BACKUP_REPO" ]; then
    restic_run cat config >/dev/null 2>&1 || restic_run init >/dev/null
  fi
  enable_timers
  log "done: https://$DOMAIN ($CHANNEL channel)"
  ls /root/taskiem-recovery-*.txt >/dev/null 2>&1 &&
    log "IMPORTANT: copy /root/taskiem-recovery-*.txt to two offline places, then delete it (shred -u)"
  return 0
}

write_recovery_sheet() { # UNSEAL RECOVERY_KEYS ANCHOR RESTICPW
  local sheet
  sheet="/root/taskiem-recovery-$(date +%F).txt"
  umask 077
  cat >"$sheet" <<EOF
TASKIEM RECOVERY SHEET — $(conf DOMAIN) — $(date -u +%FT%TZ)

Store this in two offline places (a safe, a password manager vault), then
delete it from the server: shred -u $sheet

OpenBao unseal key (hex). Without it, a restored OpenBao cannot open,
and every secret Taskiem holds is lost:
$1

OpenBao recovery keys (any 3 of 5; for generating a new root token):
$2

Audit anchor signing key (TASKIEM_ANCHOR_KEY):
$3

Backup repository password (restic):
$4
EOF
  log "recovery sheet written to $sheet"
}

enable_timers() {
  [ -z "${TASKIEM_VPS_NO_TIMERS:-}" ] && [ -d /run/systemd/system ] || return 0
  systemctl enable --now taskiem-vps-update.timer taskiem-vps-check.timer >/dev/null
  if [ -s "$ETC/backup.env" ]; then systemctl enable --now taskiem-vps-backup.timer >/dev/null; fi
}

owner_reset_email() {
  local email
  email=$(conf OWNER_EMAIL)
  jq -n --arg email "$email" '{email: $email}' | local_https /v1/auth/password/forgot -H 'Content-Type: application/json' -d @- >/dev/null
}

cmd_owner_reset() { need_root owner-reset; owner_reset_email && log "sent to $(conf OWNER_EMAIL)"; }

cmd_update() {
  need_root update
  local auto="" now="" downgrade=""
  for a in "$@"; do case $a in --auto) auto=1 ;; --now) now=1 ;; --allow-downgrade) downgrade=1 ;; *) die "unknown option $a" ;; esac; done
  [ -z "$downgrade" ] || [ -z "$auto" ] || die "--allow-downgrade is for a person, not the timer"
  # One lock for everything that stops or restarts the stack: updates,
  # rollbacks and the backup (which copies OpenBao's storage while it is
  # stopped).
  exec 9>"$STATE/update.lock"
  flock -n 9 || { log "another update, or the backup, is running"; return 0; }

  local current target
  current=$(cat "$STATE/current" 2>/dev/null || true)
  if test_mode; then target=$TASKIEM_VPS_IMAGE_OVERRIDE; else target="$IMAGE_REPO@$(channel_digest)"; fi
  if [ "$target" = "$current" ]; then [ -n "$auto" ] || log "already on the newest $(conf CHANNEL) release"; return 0; fi
  # A release that failed and was rolled back waits for a newer one; only
  # --now tries it again (the timer would otherwise retry it every tick).
  if [ -z "$now" ] && [ "$target" = "$(cat "$STATE/update-failed" 2>/dev/null || true)" ]; then
    [ -n "$auto" ] || log "$target failed to upgrade before and was rolled back: not trying it again (use --now to retry)"
    return 0
  fi
  if [ -z "$now" ] && ! in_window; then
    [ -n "$auto" ] || log "outside the upgrade window ($(conf WINDOW)); use --now to upgrade anyway"
    return 0
  fi

  log "upgrading to $target"
  test_mode || verify_image "$target"
  check_release "$target" "$downgrade"
  test_mode || docker pull --quiet "$target" >/dev/null
  sync_kit "$(image_revision "$target")"
  printf '%s\n' "$current" >"$STATE/previous"
  set_image "$target"
  ! external_proxy || proxy_prepare
  if compose up -d --remove-orphans 2>"$STATE/last-update.log" && { ! external_proxy || proxy_publish || true; } && wait_healthy 240; then
    rm -f "$STATE/update-failed"
    # The release numbers travel with current and previous.
    if [ -n "$NEW_RELEASE" ]; then
      cp "$STATE/current-release" "$STATE/previous-release" 2>/dev/null || rm -f "$STATE/previous-release"
      printf '%s\n' "$NEW_RELEASE" >"$STATE/current-release"
    fi
    date -u +%FT%TZ >"$STATE/last-update"
    log "upgraded to $target"
    notify "upgraded" "Now running $target (was $current)."
    return 0
  fi
  log "the new release did not become healthy: rolling back to $current"
  # With its own kit: the Compose file, configs and this tool of the
  # release being returned to, not of the one that failed.
  (sync_kit "$(image_revision "$current")") || log "could not restore the deployment kit of $current: keeping $target's"
  set_image "$current"
  compose up -d --remove-orphans >/dev/null 2>&1 || true
  printf '%s\n' "$target" >"$STATE/update-failed"
  if wait_healthy 240; then
    notify "upgrade failed, rolled back" "The release $target did not become healthy and was rolled back to $current. It will not be tried again until a newer release is published. Details: $STATE/last-update.log and taskiem-vps logs."
  else
    notify "UPGRADE FAILED AND ROLLBACK UNHEALTHY" "Neither $target nor $current is healthy. Taskiem may be down. Run taskiem-vps status and taskiem-vps logs now."
  fi
  return 1
}

cmd_rollback() {
  need_root rollback
  local previous
  previous=$(cat "$STATE/previous" 2>/dev/null || true)
  [ -n "$previous" ] || die "no previous release recorded"
  exec 9>"$STATE/update.lock"
  flock -n 9 || die "an update or the backup is running: try again when it has finished"
  log "rolling back to $previous"
  sync_kit "$(image_revision "$previous")" # its own kit, before anything changes
  printf '%s\n' "$(cat "$STATE/current")" >"$STATE/previous"
  set_image "$previous"
  # The release numbers swap with the releases.
  local was
  was=$(cat "$STATE/current-release" 2>/dev/null || true)
  if [ -s "$STATE/previous-release" ]; then cp "$STATE/previous-release" "$STATE/current-release"; else rm -f "$STATE/current-release"; fi
  if [ -n "$was" ]; then printf '%s\n' "$was" >"$STATE/previous-release"; else rm -f "$STATE/previous-release"; fi
  ! external_proxy || proxy_prepare
  compose up -d --remove-orphans
  ! external_proxy || proxy_publish || true
  wait_healthy 240 || die "not healthy after rollback: taskiem-vps logs"
  log "rolled back"
}

# docker run --env-file takes values literally, quotes included (Compose
# strips them): give it an unquoted copy, readable by root only.
docker_env() { # FILE -> prints the path of a temporary unquoted copy
  local tmp
  tmp=$(mktemp)
  chmod 600 "$tmp"
  sed -n "s/^\([A-Za-z_][A-Za-z0-9_]*\)='\(.*\)'\$/\1=\2/p" "$1" >"$tmp"
  printf '%s\n' "$tmp"
}

# restic in a container, with what it backs up mounted under /backup
# (read-only unless RESTIC_MODE=rw, for restore). A repository that is a
# local path (tests, or a mounted disk) is mounted too.
restic_run() {
  local mode=${RESTIC_MODE:-ro} repo host extra=() openbao=${OPENBAO_SOURCE:-taskiem_openbao_data}
  repo=$(env_get "$ETC/backup.env" RESTIC_REPOSITORY)
  host=$(conf DOMAIN)
  case $repo in /*) mkdir -p "$repo" && extra=(-v "$repo:$repo") ;; esac
  local envf rc=0
  envf=$(docker_env "$ETC/backup.env")
  docker run --rm --env-file "$envf" --hostname "${host:-taskiem}" "${extra[@]}" \
    -v "$openbao:/backup/openbao:$mode" -v "taskiem_taskiem_data:/backup/taskiem-data:$mode" \
    -v "$KIT:/backup/kit:$mode" -v "$ETC:/backup/etc:$mode" \
    "$RESTIC_IMAGE" "$@" || rc=$?
  rm -f "$envf"
  return "$rc"
}

cmd_backup() {
  need_root backup
  [ -s "$ETC/backup.env" ] || die "no backup destination: run taskiem-vps setup"
  # OpenBao's Raft database must not be copied while it is open: stop it for
  # the seconds a local copy takes, start it again, and back up the copy.
  # The unseal key is left out on purpose: it is on the recovery sheet.
  # An update's "compose up" would start OpenBao again in the middle of the
  # copy, and the torn copy would be stored as a good backup. So the backup
  # holds the lock updates take (the upgrade window covers the backup's
  # hour), waiting for a running update to finish.
  exec 9>"$STATE/update.lock"
  flock -w "${TASKIEM_VPS_LOCK_WAIT:-1800}" 9 || {
    notify "backup failed" "The backup did not run: an update held the server for more than $(( ${TASKIEM_VPS_LOCK_WAIT:-1800} / 60 )) minutes. Run taskiem-vps status, then taskiem-vps backup."
    die "an update is still running: the backup did not start"
  }
  local copy="$STATE/openbao-copy" copied=yes
  mkdir -p "$copy" && chmod 700 "$copy"
  trap 'compose start openbao >/dev/null 2>&1 || true' EXIT
  compose stop openbao >/dev/null
  # Copy, then check the copy against the source file by file while
  # OpenBao is still stopped: a copy that differs is not a backup.
  docker run --rm --user 0 --entrypoint sh -v taskiem_openbao_data:/src:ro -v "$copy:/dst" "$OPENBAO_IMAGE" \
    -c 'find /dst -mindepth 1 -delete && cp -a /src/. /dst/ &&
        (cd /src && find . -type f -exec sha256sum {} + | sort -k2) >/tmp/src.sums &&
        (cd /dst && find . -type f -exec sha256sum {} + | sort -k2) >/tmp/dst.sums &&
        [ -s /tmp/src.sums ] && cmp -s /tmp/src.sums /tmp/dst.sums' || copied=no
  # Something started OpenBao during the copy: its files may have moved on.
  if ! test_mode && [ -n "$(compose ps -q --status running openbao 2>/dev/null || true)" ]; then copied=no; fi
  compose start openbao >/dev/null
  trap - EXIT
  if [ "$copied" = no ]; then
    notify "backup failed" "The copy of OpenBao's storage did not match the original, so nothing was stored. Run taskiem-vps backup to try again."
    return 1
  fi
  if OPENBAO_SOURCE=$copy restic_run backup /backup --tag taskiem --exclude /backup/kit/openbao-unseal.env --exclude /backup/etc/backup.env &&
    restic_run forget --tag taskiem --keep-daily 14 --keep-weekly 8 --keep-monthly 12 --prune >/dev/null; then
    date -u +%FT%TZ >"$STATE/last-backup"
    log "backup done"
  else
    notify "backup failed" "The nightly backup to $(env_get "$ETC/backup.env" RESTIC_REPOSITORY) failed. Run taskiem-vps backup to see why."
    return 1
  fi
}

# Rebuild on a new server: settings, OpenBao's storage and Taskiem's data
# from the newest backup, the unseal key from the recovery sheet. The
# database is the provider's (restore it with point-in-time recovery first
# if it was lost too; on Xenibase, Xenibase's backups and recovery); the
# restored settings point at it. Beside Xenibase, its Caddy's files for
# Taskiem are written again: they are Xenibase's, not in the backup.
cmd_restore() {
  need_root restore
  [ ! -s "$KIT/openbao.env" ] || [ -n "${TASKIEM_VPS_FORCE:-}" ] ||
    die "this server already has a deployment; restore is for a new one (TASKIEM_VPS_FORCE=1 overwrites it)"
  mkdir -p "$KIT" "$ETC" "$STATE" && chmod 700 "$ETC" "$STATE"
  local BACKUP_REPO BACKUP_KEY_ID BACKUP_SECRET RESTIC_PASSWORD UNSEAL_KEY v current
  ask BACKUP_REPO "Backup repository (restic), as set up on the old server"
  ask BACKUP_KEY_ID "Backup access key id (empty for a local path)"
  [ -z "$BACKUP_KEY_ID" ] || ask_secret BACKUP_SECRET "Backup secret key"
  ask_secret RESTIC_PASSWORD "Backup repository password (recovery sheet)"
  ask_secret UNSEAL_KEY "OpenBao unseal key (recovery sheet)"
  if [ -z "$BACKUP_REPO" ] || [ -z "$RESTIC_PASSWORD" ] || [ -z "$UNSEAL_KEY" ]; then
    die "the repository, its password and the unseal key are required"
  fi
  env_set "$ETC/backup.env" RESTIC_REPOSITORY "$BACKUP_REPO"
  env_set "$ETC/backup.env" RESTIC_PASSWORD "$RESTIC_PASSWORD"
  env_set "$ETC/backup.env" AWS_ACCESS_KEY_ID "${BACKUP_KEY_ID:-}"
  env_set "$ETC/backup.env" AWS_SECRET_ACCESS_KEY "${BACKUP_SECRET:-}"
  for v in openbao_data taskiem_data; do
    docker volume create --label com.docker.compose.project=taskiem --label "com.docker.compose.volume=$v" "taskiem_$v" >/dev/null
  done
  log "restoring the newest backup"
  RESTIC_MODE=rw restic_run restore latest --tag taskiem --target /
  env_set "$KIT/openbao-unseal.env" BAO_STATIC_UNSEAL_KEY "$UNSEAL_KEY"
  current=$(env_get "$KIT/.env" TASKIEM_IMAGE)
  [ -n "$current" ] || die "the backup holds no release (TASKIEM_IMAGE in .env)"
  printf '%s\n' "$current" >"$STATE/current"
  touch "$STATE/bootstrapped"
  test_mode || docker pull --quiet "$current" >/dev/null
  ! external_proxy || proxy_prepare
  compose up -d --remove-orphans
  # The other Caddy's files are not in the backup: written again.
  ! external_proxy || proxy_publish force || log "WARNING: the Caddy in $(conf PROXY_CONTAINER) did not take Taskiem's sites"
  wait_healthy 300 || die "restored, but Taskiem is not healthy: taskiem-vps logs"
  enable_timers
  log "restored $(conf DOMAIN): point its DNS at this server if it is not already"
}

# Each failing check prints one line; alerts go out when the set changes.
run_checks() {
  local id status domain days age
  domain=$(conf DOMAIN)
  id=$(compose ps -q taskiem 2>/dev/null || true)
  status=missing
  if [ -n "$id" ]; then status=$(docker inspect -f '{{.State.Health.Status}}' "$id" 2>/dev/null || echo missing); fi
  [ "$status" = healthy ] || echo "Taskiem container is $status"
  local_https /readyz >/dev/null 2>&1 || echo "https://$domain/readyz does not answer"
  compose exec -T openbao wget -qO- http://127.0.0.1:8200/v1/sys/health >/dev/null 2>&1 || echo "OpenBao is sealed or down: secrets cannot be read"
  public_healthy || echo "the public host (storefronts and forms) is not healthy: new business domains get no certificate"
  mail_healthy || echo "the mail server (email triggers) is not healthy: mail to workflows is refused until it is back, and senders retry"
  ! external_proxy || proxy_checks
  if compose logs --since 30h openbao-renew 2>/dev/null | grep 'RENEWAL FAILED' >/dev/null; then echo "OpenBao token renewal failed: secrets stop working when the token expires"; fi
  df -P / /var/lib/docker 2>/dev/null | awk 'NR>1 && $5+0 >= 85 {print "disk " $6 " is " $5 " full"}' | sort -u
  if [ -z "${TASKIEM_VPS_INSECURE_TLS:-}" ]; then
    days=$(echo | openssl s_client -connect 127.0.0.1:443 -servername "$domain" 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)
    if [ -n "$days" ]; then
      days=$(( ($(date -d "$days" +%s) - $(date +%s)) / 86400 ))
      [ "$days" -ge 14 ] || echo "TLS certificate expires in $days days"
    fi
  fi
  if [ -s "$ETC/backup.env" ]; then
    if [ -f "$STATE/last-backup" ]; then
      age=$(( ($(date +%s) - $(date -d "$(cat "$STATE/last-backup")" +%s)) / 3600 ))
      [ "$age" -lt 36 ] || echo "last successful backup was $age hours ago"
    else
      echo "no successful backup yet"
    fi
  fi
  [ ! -s "$STATE/update-failed" ] || echo "release $(cat "$STATE/update-failed") failed to upgrade and was rolled back"
  staging_behind
  ! ls /root/taskiem-recovery-*.txt >/dev/null 2>&1 || echo "the recovery sheet is still on the server (/root/taskiem-recovery-*.txt)"
  ! ls /root/taskiem-owner-password-*.txt >/dev/null 2>&1 || echo "the owner's first password is still on the server (/root/taskiem-owner-password-*.txt)"
}

# A staging server runs every merge to main, so main ahead of the running
# release by a merge older than a day means releases are not being tagged
# (CI's image job skipped or failing) or this server is not taking them.
# Compared through GitHub's API from the running image's revision label;
# nothing to say when GitHub cannot be asked.
staging_behind() {
  local rev cmp ahead oldest age
  [ "$(conf CHANNEL)" = staging ] || return 0
  test_mode && return 0
  rev=$(image_revision "$(cat "$STATE/current" 2>/dev/null)")
  [ -n "$rev" ] || return 0
  cmp=$(curl -fsS --max-time 10 -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$REPO_SLUG/compare/$rev...main" 2>/dev/null) || return 0
  ahead=$(jq -r '.ahead_by // 0' <<<"$cmp" 2>/dev/null) || return 0
  [ "${ahead:-0}" -gt 0 ] || return 0
  oldest=$(jq -r '[.commits[].commit.committer.date] | min // empty' <<<"$cmp" 2>/dev/null)
  [ -n "$oldest" ] || return 0
  age=$(( ($(date +%s) - $(date -d "$oldest" +%s)) / 3600 ))
  [ "$age" -lt 24 ] || echo "staging is $ahead merge(s) behind main, the oldest $age hours old: check that CI's image job tagged staging (taskiem-vps update --now if it did)"
}

cmd_check() {
  need_root check
  local now before
  now=$(run_checks || true)
  before=$(cat "$STATE/alerts" 2>/dev/null || true)
  if [ "$now" != "$before" ]; then
    if [ -n "$now" ]; then notify "problems" "$now"; else notify "all checks pass again" "Previously: $before"; fi
    # Remembered only once someone was told: an alert that could not be
    # sent (the mail server or webhook down with everything else) is tried
    # again on the next check.
    if [ "$NOTIFY_SENT" = yes ]; then printf '%s' "$now" >"$STATE/alerts"; fi
  fi
  if [ -n "$now" ]; then printf '%s\n' "$now"; return 1; fi
  echo "all checks pass"
}

cmd_status() {
  need_root status
  local cur window
  cur=$(cat "$STATE/current" 2>/dev/null || echo none)
  window=$(conf WINDOW || true)
  printf 'Server     https://%s\nChannel    %s (upgrade window: %s)\nRelease    %s\nCommit     %s\nUpdated    %s\nBackup     %s\n\n' \
    "$(conf DOMAIN)" "$(conf CHANNEL)" "${window:-any}" "$cur" "$(image_revision "$cur" | cut -c1-12)" \
    "$(cat "$STATE/last-update" 2>/dev/null || echo never)" "$(cat "$STATE/last-backup" 2>/dev/null || echo never)"
  compose ps --format 'table {{.Service}}\t{{.Status}}'
  echo
  run_checks | sed 's/^/PROBLEM: /' || true
}

cmd_logs() { need_root logs; compose logs -f --tail 200 "$@"; }

case ${1:-} in
setup) shift; cmd_setup "$@" ;;
update) shift; cmd_update "$@" ;;
rollback) shift; cmd_rollback ;;
status) cmd_status ;;
check) cmd_check ;;
backup) cmd_backup ;;
restore) cmd_restore ;;
logs) shift; cmd_logs "$@" ;;
owner-reset) cmd_owner_reset ;;
_install-kit) need_root; mkdir -p "$KIT"; install_kit "$2" ;; # used by install.sh
*) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
