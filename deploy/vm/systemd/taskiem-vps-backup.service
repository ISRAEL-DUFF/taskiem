[Unit]
Description=Taskiem: encrypted backup of OpenBao, Taskiem's data and settings
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/taskiem-vps backup
# A oneshot has no start time limit of its own: a docker call that hangs
# would hold the update lock for ever. Longer than a slow run needs
# (waiting for an update, then a first full backup); systemd then stops it and the lock is released.
TimeoutStartSec=6h
