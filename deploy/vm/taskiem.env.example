# Taskiem's settings (docs/operations.md, Configuration). Copy to taskiem.env;
# chmod 600. Secrets live here and in openbao.env and migrate.env only.

# Database: a login role that is a member of taskiem_app, not the owner.
TASKIEM_DATABASE_URL=postgres://taskiem:CHANGE_ME@db.example.internal:5432/taskiem?sslmode=verify-full

# Keys: OpenBao on the Compose network. Never TASKIEM_KMS=local here.
TASKIEM_KMS=openbao
TASKIEM_OPENBAO_ADDR=http://openbao:8200
TASKIEM_KMS_KEY=taskiem

# The public URL (https): passkeys, links in emails, HSTS, secure cookies.
TASKIEM_PUBLIC_URL=https://staging.taskiem.example
# Caddy is the only hop in front: take the client address from it.
TASKIEM_TRUST_PROXY=true

# Every role in one process; container steps are OFF (decision 0032).
TASKIEM_WORKER_QUEUES=connector,sandbox
TASKIEM_WASM_CACHE=/cache/wazero

# Persistent data on the taskiem_data volume.
TASKIEM_ARCHIVE_DIR=/var/lib/taskiem/archive
TASKIEM_ANCHOR_DIR=/var/lib/taskiem/anchors
# Signs the daily audit-chain anchors: openssl rand -base64 32. Keep a copy offline.
TASKIEM_ANCHOR_KEY=

# Email for password resets, invitations, signup confirmations and alerts.
# smtps://user:pass@host:465 or smtp://user:pass@host:587 (STARTTLS).
TASKIEM_SMTP_URL=
TASKIEM_ALERT_FROM=taskiem@taskiem.example

# Self-serve signup stays off until P4-O1 (sending domain, SPF, DKIM, DMARC).
TASKIEM_ALLOW_SIGNUP=false

# Providers: iswallet's staging is the connector's default. Set its
# production URL at go-live.
# TASKIEM_ISWALLET_URL=
