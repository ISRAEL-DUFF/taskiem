{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.taskiem.dev/connector/v1.json",
  "title": "Taskiem connector manifest (connector/v1)",
  "description": "Declarative description of a connector. Cross-reference rules (reconcile and compensate actions exist, idempotency encodings fit provider limits, pii fields exist in the input schema) are enforced at registration and documented in docs/contracts/connector-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "id", "version", "name", "category", "auth", "actions"],
  "properties": {
    "manifest": { "const": "connector/v1" },
    "id": { "$ref": "#/$defs/name" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 2000 },
    "category": {
      "enum": ["payments", "banking", "open_banking", "identity", "messaging", "ussd", "mobile_money", "tax", "database", "productivity", "storage", "developer", "ai", "other"]
    },
    "regions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
    },
    "auth": { "$ref": "#/$defs/auth" },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "per"],
      "properties": {
        "requests": { "type": "integer", "minimum": 1 },
        "per": { "$ref": "#/$defs/duration" },
        "scope": { "enum": ["connection", "tenant", "global"], "default": "connection" }
      }
    },
    "base_url": { "type": "string", "pattern": "^https://" },
    "egress_hosts": {
      "description": "Hosts this connector may reach through the egress proxy; defaults to the base_url host.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/action" }
    },
    "triggers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/trigger" }
    }
  },

  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "duration": { "type": "string", "pattern": "^([0-9]+(ms|s|m|h|d))+$" },
    "expr": { "type": "string", "pattern": "^=.+" },
    "jsonSchema": { "type": ["object", "boolean"] },

    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["api_key", "oauth2", "basic", "custom", "none"] },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label"],
            "properties": {
              "key": { "$ref": "#/$defs/name" },
              "label": { "type": "string" },
              "secret": { "type": "boolean", "default": false },
              "required": { "type": "boolean", "default": true }
            }
          }
        },
        "oauth2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorize_url", "token_url"],
          "properties": {
            "authorize_url": { "type": "string", "pattern": "^https://" },
            "token_url": { "type": "string", "pattern": "^https://" },
            "scopes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": { "action": { "$ref": "#/$defs/name" } }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "oauth2" } } }, "then": { "required": ["oauth2"] } },
        { "if": { "properties": { "type": { "enum": ["api_key", "basic", "custom"] } } }, "then": { "required": ["fields"] } }
      ]
    },

    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "encoding", "length"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "description": "Input field (or header:<Name>) that carries the encoded key." },
        "encoding": { "enum": ["base32_lower", "hex_lower", "base64url"] },
        "length": { "type": "integer", "minimum": 16, "maximum": 128, "description": "Characters of encoded hash, excluding the prefix." },
        "prefix": { "type": "string", "maxLength": 16 },
        "limits": {
          "description": "The provider's own constraints on the field; registration checks prefix + encoded hash against them.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_length": { "type": "integer", "minimum": 1 },
            "max_length": { "type": "integer", "minimum": 1 },
            "charset": { "type": "string", "description": "Allowed characters as a regex character-class body, e.g. a-z0-9_-" }
          }
        }
      }
    },

    "pii": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "category"],
            "properties": {
              "field": { "type": "string" },
              "category": { "enum": ["bvn", "nin", "phone", "account_number", "email", "name", "address", "card", "other"] }
            }
          }
        ]
      }
    },

    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "class", "input"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "class": { "enum": ["read", "idempotent_write", "reconcilable_write", "unsafe_write"] },
        "idempotency": { "$ref": "#/$defs/idempotency" },
        "reconcile": { "$ref": "#/$defs/name" },
        "compensate": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
        "input": { "$ref": "#/$defs/jsonSchema" },
        "output": { "$ref": "#/$defs/jsonSchema" },
        "pii": { "$ref": "#/$defs/pii" }
      },
      "allOf": [
        { "if": { "properties": { "class": { "const": "idempotent_write" } } }, "then": { "required": ["idempotency"] } },
        { "if": { "properties": { "class": { "const": "reconcilable_write" } } }, "then": { "required": ["reconcile"] } },
        { "if": { "properties": { "class": { "const": "read" } } }, "then": { "not": { "required": ["idempotency"] } } }
      ]
    },

    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["webhook", "polling"] },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme"],
          "properties": {
            "scheme": { "enum": ["hmac_sha256", "hmac_sha512", "hmac_sha1", "hmac_sha256_timestamped", "slack_v0", "header_secret", "query_secret", "connector", "bearer", "basic", "none"], "description": "header_secret: the header carries the shared secret itself (compared in constant time). connector: the connector's own code verifies (for signatures no scheme describes). slack_v0: HMAC-SHA256 over 'v0:<timestamp>:<raw body>', the header carrying 'v0=<hex>'." },
            "encoding": { "enum": ["hex", "base64", "base64_of_hex"], "description": "hmac_*: how the signature header encodes the MAC (default hex; base64_of_hex is base64 of the lowercase hex string)." },
            "key_derivation": { "enum": ["none", "sha256_hex"], "description": "hmac_*: the MAC key is the secret itself (none, default) or the lowercase hex SHA-256 of the secret." },
            "header": { "type": "string" },
            "query": { "type": "string", "description": "query_secret: the URL parameter carrying the shared secret (for providers that sign nothing; the callback URL is registered with it)." },
            "secret_field": { "$ref": "#/$defs/name" },
            "timestamp_header": { "type": "string", "description": "hmac_sha256_timestamped: header with the unix-seconds timestamp; the signed string is '<timestamp>.<raw body>'." },
            "tolerance": { "$ref": "#/$defs/duration", "description": "hmac_sha256_timestamped: reject timestamps further than this from now (default 5m)." }
          },
          "allOf": [
            { "if": { "properties": { "scheme": { "const": "hmac_sha256_timestamped" } } }, "then": { "required": ["header", "timestamp_header"] } },
            { "if": { "properties": { "scheme": { "const": "slack_v0" } } }, "then": { "required": ["header", "timestamp_header"] } }
          ]
        },
        "ack": {
          "type": "object",
          "additionalProperties": false,
          "description": "The answer a provider expects to an accepted delivery, instead of 202 JSON.",
          "properties": {
            "status": { "type": "integer", "minimum": 200, "maximum": 299 },
            "body": { "type": "string", "maxLength": 1024 },
            "content_type": { "type": "string" }
          }
        },
        "handshake": {
          "type": "object",
          "additionalProperties": false,
          "description": "How the provider proves the endpoint before (or while) delivering. GET: the provider sends token_query equal to the connection's secret_field and expects respond back as text (Meta). POST: a verified delivery for which when holds is answered with respond, not delivered (Slack url_verification).",
          "properties": {
            "method": { "enum": ["GET", "POST"] },
            "when": { "$ref": "#/$defs/expr" },
            "respond": { "$ref": "#/$defs/expr" },
            "token_query": { "type": "string" },
            "secret_field": { "$ref": "#/$defs/name" }
          },
          "required": ["method", "respond"],
          "allOf": [
            { "if": { "properties": { "method": { "const": "GET" } } }, "then": { "required": ["token_query", "secret_field"] } },
            { "if": { "properties": { "method": { "const": "POST" } } }, "then": { "required": ["when"] } }
          ]
        },
        "events": { "type": "array", "items": { "type": "string" } },
        "split": { "$ref": "#/$defs/expr", "description": "A list-valued expression: each element becomes one event, seen by event_type, dedup and correlation as item (for providers that batch several events in one delivery)." },
        "event_type": { "$ref": "#/$defs/expr" },
        "dedup": { "$ref": "#/$defs/expr" },
        "correlation": { "$ref": "#/$defs/expr" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "webhook" } } }, "then": { "required": ["verify"] } }
      ]
    }
  }
}
