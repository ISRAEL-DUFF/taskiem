{
  "$id": "https://schemas.taskiem.dev/capabilities/v1.json",
  "title": "Taskiem capabilities v1",
  "description": "What a rail can do, said the same way for every rail (decision 0044, docs/spec/rails-and-products.md 4.1), and what the books can do, the same way for every books (kind: product; decision 0051). A rail's manifest maps each capability it has to its own actions (connector/v1 rule 16); templates use the capability and run on any rail that declares it. Amounts are integer minor units (kobo for NGN). x-pii marks personal fields, sealed whatever the rail. classes are the effect classes a rail's action may have to stand for the capability.",
  "capabilities": {
    "balance": {
      "title": "Check the balance",
      "classes": ["read"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account": { "type": "string", "description": "A wallet or account to read; the connection's own when left out" },
          "currency": { "type": "string", "default": "NGN" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["available_kobo", "currency"],
        "properties": {
          "available_kobo": { "type": "integer", "description": "What can be spent now, in minor units" },
          "currency": { "type": "string" }
        }
      }
    },
    "resolve_account": {
      "title": "Find the name on a bank account",
      "classes": ["read"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bank_code", "account_number"],
        "properties": {
          "bank_code": { "type": "string", "description": "The bank's NIP code (list_banks)" },
          "account_number": { "type": "string", "x-pii": "account_number" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account_name"],
        "properties": {
          "account_name": { "type": "string", "x-pii": "name" }
        }
      }
    },
    "list_banks": {
      "title": "List the banks",
      "classes": ["read"],
      "input": { "type": "object", "additionalProperties": false, "properties": {} },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["banks"],
        "properties": {
          "banks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "name"],
              "properties": {
                "code": { "type": "string", "description": "The NIP code" },
                "name": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "pay_bank": {
      "title": "Pay a bank account",
      "classes": ["idempotent_write", "reconcilable_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount_kobo", "bank_code", "account_number", "account_name", "narration"],
        "properties": {
          "amount_kobo": { "type": "integer", "minimum": 1 },
          "currency": { "type": "string", "default": "NGN" },
          "bank_code": { "type": "string", "description": "The bank's NIP code (list_banks)" },
          "account_number": { "type": "string", "x-pii": "account_number" },
          "account_name": { "type": "string", "description": "As resolve_account found it", "x-pii": "name" },
          "narration": { "type": "string", "maxLength": 100 },
          "source": { "type": "string", "description": "The wallet or account to pay from, on rails that hold several" }
        }
      },
      "output": {
        "$ref": "#/$defs/payout"
      }
    },
    "pay_wallet": {
      "title": "Pay a wallet on the same rail",
      "classes": ["idempotent_write", "reconcilable_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount_kobo", "wallet_id", "narration"],
        "properties": {
          "amount_kobo": { "type": "integer", "minimum": 1 },
          "currency": { "type": "string", "default": "NGN" },
          "wallet_id": { "type": "string", "description": "The wallet or account to pay into" },
          "narration": { "type": "string", "maxLength": 100 },
          "source": { "type": "string", "description": "The wallet or account to pay from, on rails that hold several" }
        }
      },
      "output": {
        "$ref": "#/$defs/payout"
      }
    },
    "pay_mobile_money": {
      "title": "Pay a mobile money wallet",
      "classes": ["idempotent_write", "reconcilable_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount_kobo", "currency", "msisdn", "narration"],
        "properties": {
          "amount_kobo": { "type": "integer", "minimum": 1 },
          "currency": { "type": "string" },
          "msisdn": { "type": "string", "description": "The phone number, international format", "x-pii": "phone" },
          "narration": { "type": "string", "maxLength": 100 }
        }
      },
      "output": {
        "$ref": "#/$defs/payout"
      }
    },
    "get_payout": {
      "title": "Look a payout up",
      "classes": ["read"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payout_id"],
        "properties": {
          "payout_id": { "type": "string", "description": "As the payment capability answered it" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "enum": ["settled", "pending", "failed", "reversed"] },
          "settled_at": { "type": "string" },
          "fee_kobo": { "type": "integer" },
          "reason": { "type": "string", "description": "Why it failed or is still pending, in the rail's words" }
        }
      }
    },
    "pay_many": {
      "title": "Pay a list of bank accounts in one batch",
      "description": "Declared only where the rail has a real bulk endpoint; elsewhere templates loop over pay_bank.",
      "classes": ["idempotent_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "narration"],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["amount_kobo", "bank_code", "account_number", "account_name"],
              "properties": {
                "amount_kobo": { "type": "integer", "minimum": 1 },
                "bank_code": { "type": "string" },
                "account_number": { "type": "string", "x-pii": "account_number" },
                "account_name": { "type": "string", "x-pii": "name" },
                "narration": { "type": "string", "maxLength": 100 }
              }
            }
          },
          "currency": { "type": "string", "default": "NGN" },
          "narration": { "type": "string", "maxLength": 100 },
          "source": { "type": "string" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["batch_id", "items"],
        "properties": {
          "batch_id": { "type": "string" },
          "items": { "type": "array", "items": { "$ref": "#/$defs/payout" } }
        }
      }
    },
    "collect_link": {
      "title": "Make a payment page for a customer",
      "classes": ["idempotent_write", "reconcilable_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount_kobo", "customer", "description"],
        "properties": {
          "amount_kobo": { "type": "integer", "minimum": 1 },
          "currency": { "type": "string", "default": "NGN" },
          "customer": { "$ref": "#/$defs/customer" },
          "description": { "type": "string", "description": "What the payment is for, shown to the customer" },
          "return_url": { "type": "string", "description": "Where the customer goes after paying" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_url", "payment_id"],
        "properties": {
          "payment_url": { "type": "string" },
          "payment_id": { "type": "string", "description": "For get_payment and payment.received" }
        }
      }
    },
    "collect_transfer": {
      "title": "Give a customer a bank account number for one payment",
      "description": "A one-time (dynamic) account for one amount, which stops taking new payments at expires_at. Money paid into it arrives as payment.received with the payment_id it answered; a rail that sends a late or wrong-amount transfer back says so with payment.returned. The rail's mapping declares what it does with late and wrong-amount transfers and the lifetimes it allows (transfer).",
      "classes": ["idempotent_write", "reconcilable_write", "unsafe_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount_kobo", "customer", "description"],
        "properties": {
          "amount_kobo": { "type": "integer", "minimum": 1, "description": "What the customer must send" },
          "currency": { "type": "string", "default": "NGN" },
          "customer": { "$ref": "#/$defs/customer" },
          "description": { "type": "string", "description": "What the payment is for" },
          "expires_minutes": { "type": "integer", "minimum": 1, "description": "How long the account should take payments; the rail keeps it within its own range (transfer.min_minutes to transfer.max_minutes)" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_id", "account_number", "bank_name", "amount_kobo", "expires_at"],
        "properties": {
          "payment_id": { "type": "string", "description": "For get_payment, payment.received and payment.returned" },
          "account_number": { "type": "string", "x-pii": "account_number" },
          "bank_name": { "type": "string" },
          "account_name": { "type": "string", "x-pii": "name" },
          "amount_kobo": { "type": "integer", "description": "What the customer must send" },
          "expires_at": { "type": "string", "description": "When the account stops taking new payments, RFC 3339, as the rail set it" }
        }
      }
    },
    "collect_push": {
      "title": "Ask a customer to approve a payment on their phone or a terminal",
      "classes": ["idempotent_write", "reconcilable_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["amount_kobo", "msisdn", "description"],
        "properties": {
          "amount_kobo": { "type": "integer", "minimum": 1 },
          "currency": { "type": "string", "default": "NGN" },
          "msisdn": { "type": "string", "x-pii": "phone" },
          "description": { "type": "string" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_id", "status"],
        "properties": {
          "payment_id": { "type": "string" },
          "status": { "enum": ["paid", "pending", "failed"] }
        }
      }
    },
    "get_payment": {
      "title": "Look a payment up",
      "classes": ["read"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_id"],
        "properties": {
          "payment_id": { "type": "string", "description": "As collect_link or collect_transfer answered it, or the reference a payment event carried" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "enum": ["paid", "pending", "failed", "refunded"] },
          "amount_kobo": { "type": "integer", "description": "What the customer paid" },
          "currency": { "type": "string" },
          "paid_at": { "type": "string" }
        }
      }
    },
    "virtual_account": {
      "title": "Open a bank account number for a customer to pay into",
      "description": "A permanent account number for one customer (a student, a tenant, a shop): every transfer into it arrives as virtual_account.credited with the account's reference, and list_credits reads credits back. The rail's reference is derived from the step's key, so issuing again for the same customer answers the same account. What each rail needs and lets the business set is in docs/spec/schools-rail-facts.md. An unsafe_write action may stand for it only when the mapping says unsafe: true: an unknown outcome then parks for a person to check.",
      "classes": ["idempotent_write", "reconcilable_write", "unsafe_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["customer"],
        "properties": {
          "customer": { "$ref": "#/$defs/customer" },
          "account_name": { "type": "string", "maxLength": 100, "description": "The name payers should see when they check the number; used where the rail lets the business set it, and shortened by the caller to the rail's limit. Elsewhere the rail names the account itself (from the customer's name on most)", "x-pii": "name" },
          "account": { "type": "string", "description": "The wallet or account the number pays into, on rails that hold several" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account_number", "bank_name", "reference"],
        "properties": {
          "account_number": { "type": "string", "x-pii": "account_number" },
          "bank_name": { "type": "string" },
          "account_name": { "type": "string", "description": "As the rail named it; absent where the rail does not say (Flutterwave)", "x-pii": "name" },
          "reference": { "type": "string", "description": "The account's reference, which virtual_account.credited and list_credits carry" }
        }
      }
    },
    "list_credits": {
      "title": "List money paid into customers' account numbers",
      "description": "Credits to the account numbers virtual_account opened, over a window of time, each with the fields of virtual_account.credited and the same credit_id, so a credit whose event never arrived is found by reading back an overlapping window and recorded once. truncated is true when the rail had more than was read: read a shorter window.",
      "classes": ["read"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["since"],
        "properties": {
          "since": { "type": "string", "description": "From when, RFC 3339" },
          "until": { "type": "string", "description": "Until when, RFC 3339; now when left out" },
          "account": { "type": "string", "description": "The wallet or account the numbers pay into, on rails that hold several" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credits"],
        "properties": {
          "credits": { "type": "array", "items": { "$ref": "#/$defs/credit" } },
          "truncated": { "type": "boolean", "description": "The rail had more credits in the window than were read" }
        }
      }
    },
    "refund": {
      "title": "Refund a payment",
      "classes": ["idempotent_write", "reconcilable_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_id"],
        "properties": {
          "payment_id": { "type": "string" },
          "amount_kobo": { "type": "integer", "minimum": 1, "description": "Part of the payment; the whole when left out" },
          "reason": { "type": "string" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["refund_id", "status"],
        "properties": {
          "refund_id": { "type": "string" },
          "status": { "enum": ["refunded", "pending", "failed"] },
          "amount_kobo": { "type": "integer" }
        }
      }
    },
    "books_customer": {
      "title": "Find or add a customer in the books",
      "kind": "product",
      "classes": ["idempotent_write", "reconcilable_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "x-pii": "name" },
          "email": { "type": "string", "x-pii": "email", "description": "Found by it before a customer is added, so a retry finds the one it made" },
          "phone": { "type": "string", "x-pii": "phone", "description": "Found by it when there is no email" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["customer_id"],
        "properties": {
          "customer_id": { "type": "string", "description": "The books' own id" },
          "created": { "type": "boolean", "description": "false when the customer was already there" }
        }
      }
    },
    "books_invoice": {
      "title": "Record an invoice in the books",
      "kind": "product",
      "classes": ["idempotent_write", "reconcilable_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "customer_id", "lines"],
        "properties": {
          "number": { "type": "string", "description": "Taskiem's invoice number, kept as the books' reference (reference_number, DocNumber): a retry finds the invoice instead of making a second" },
          "customer_id": { "type": "string", "description": "As books_customer answered it" },
          "issued_on": { "type": "string", "format": "date" },
          "due_on": { "type": "string", "format": "date" },
          "currency": { "type": "string", "default": "NGN" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description", "amount_kobo"],
              "properties": {
                "description": { "type": "string" },
                "quantity": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
                "amount_kobo": { "type": "integer", "minimum": 0, "description": "Each, before tax" },
                "item_id": { "type": "string", "description": "As books_items lists it" },
                "tax_id": { "type": "string", "description": "As books_taxes lists it (VAT at 7.5%)" }
              }
            }
          },
          "notes": { "type": "string" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invoice_id"],
        "properties": {
          "invoice_id": { "type": "string" },
          "number": { "type": "string" },
          "total_kobo": { "type": "integer", "description": "As the books worked it out, tax included" }
        }
      }
    },
    "books_payment": {
      "title": "Record a payment against an invoice in the books",
      "kind": "product",
      "classes": ["idempotent_write", "reconcilable_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invoice_id", "amount_kobo", "reference"],
        "properties": {
          "invoice_id": { "type": "string" },
          "amount_kobo": { "type": "integer", "minimum": 1 },
          "currency": { "type": "string", "default": "NGN" },
          "paid_on": { "type": "string", "format": "date" },
          "reference": { "type": "string", "description": "The money log entry's reference: a retry finds the payment by it" },
          "method": { "enum": ["transfer", "card", "cash", "pos", "other"] },
          "account_id": { "type": "string", "description": "The bank or cash account it went into, as books_accounts lists it" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_id"],
        "properties": {
          "payment_id": { "type": "string" }
        }
      }
    },
    "books_sale": {
      "title": "Record a day's takings in the books",
      "kind": "product",
      "classes": ["idempotent_write", "reconcilable_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "date", "takings"],
        "properties": {
          "reference": { "type": "string", "description": "The day and the source (pos-2026-10-24): a retry finds the receipt by it" },
          "date": { "type": "string", "format": "date" },
          "currency": { "type": "string", "default": "NGN" },
          "takings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description", "amount_kobo"],
              "properties": {
                "description": { "type": "string", "description": "Card, transfer, cash…" },
                "amount_kobo": { "type": "integer", "minimum": 0 },
                "account_id": { "type": "string" }
              }
            }
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sale_id"],
        "properties": {
          "sale_id": { "type": "string" }
        }
      }
    },
    "books_expense": {
      "title": "Record an expense in the books",
      "kind": "product",
      "classes": ["idempotent_write", "reconcilable_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "amount_kobo", "account_id"],
        "properties": {
          "reference": { "type": "string", "description": "The receipt's or the money log entry's: a retry finds the expense by it" },
          "supplier": { "type": "string" },
          "amount_kobo": { "type": "integer", "minimum": 1 },
          "vat_kobo": { "type": "integer", "minimum": 0 },
          "currency": { "type": "string", "default": "NGN" },
          "date": { "type": "string", "format": "date" },
          "account_id": { "type": "string", "description": "The expense account, as books_accounts lists it" },
          "paid_from_id": { "type": "string", "description": "The bank or cash account it was paid from" },
          "description": { "type": "string" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expense_id"],
        "properties": {
          "expense_id": { "type": "string" }
        }
      }
    },
    "books_bill": {
      "title": "Record a supplier's bill in the books",
      "kind": "product",
      "classes": ["idempotent_write", "reconcilable_write"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["supplier_id", "number", "lines"],
        "properties": {
          "supplier_id": { "type": "string" },
          "number": { "type": "string", "description": "The supplier's bill number: a retry finds the bill by it" },
          "issued_on": { "type": "string", "format": "date" },
          "due_on": { "type": "string", "format": "date" },
          "currency": { "type": "string", "default": "NGN" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description", "amount_kobo", "account_id"],
              "properties": {
                "description": { "type": "string" },
                "amount_kobo": { "type": "integer", "minimum": 0 },
                "account_id": { "type": "string" },
                "tax_id": { "type": "string" }
              }
            }
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bill_id"],
        "properties": {
          "bill_id": { "type": "string" },
          "total_kobo": { "type": "integer" }
        }
      }
    },
    "books_accounts": {
      "title": "List the books' accounts",
      "kind": "product",
      "classes": ["read"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["income", "expense", "bank", "cash", "receivable", "payable", "other"], "description": "Only accounts of this type" }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accounts"],
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "books_items": {
      "title": "List the books' items",
      "kind": "product",
      "classes": ["read"],
      "input": { "type": "object", "additionalProperties": false, "properties": {} },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "amount_kobo": { "type": "integer", "description": "Its price, where it has one" }
              }
            }
          }
        }
      }
    },
    "books_taxes": {
      "title": "List the books' taxes",
      "kind": "product",
      "classes": ["read"],
      "input": { "type": "object", "additionalProperties": false, "properties": {} },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taxes"],
        "properties": {
          "taxes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "percent": { "type": "number" }
              }
            }
          }
        }
      }
    }
  },
  "events": {
    "payout.settled": {
      "title": "A payout reached the account",
      "correlation": "payout_id",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payout_id"],
        "properties": {
          "payout_id": { "type": "string" },
          "amount_kobo": { "type": "integer" },
          "settled_at": { "type": "string" }
        }
      }
    },
    "payout.failed": {
      "title": "A payout failed; the money is back",
      "correlation": "payout_id",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payout_id"],
        "properties": {
          "payout_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "payout.reversed": {
      "title": "A settled payout came back",
      "correlation": "payout_id",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payout_id"],
        "properties": {
          "payout_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "payment.received": {
      "title": "A customer paid",
      "correlation": "payment_id",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_id", "amount_kobo"],
        "properties": {
          "payment_id": { "type": "string" },
          "amount_kobo": { "type": "integer" },
          "currency": { "type": "string" },
          "paid_at": { "type": "string" }
        }
      }
    },
    "payment.returned": {
      "title": "A customer's transfer went back to them",
      "correlation": "payment_id",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_id"],
        "properties": {
          "payment_id": { "type": "string" },
          "amount_kobo": { "type": "integer" },
          "reason": { "enum": ["late", "wrong_amount", "other"], "description": "late: after the account expired; wrong_amount: not the amount asked" }
        }
      }
    },
    "refund.pending": {
      "title": "A refund to a customer was started",
      "correlation": "payment_id",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_id"],
        "properties": {
          "payment_id": { "type": "string", "description": "The payment refunded, as the payment capability answered it (refund takes it)" },
          "refund_id": { "type": "string", "description": "The rail's own reference for the refund, when its event carries one" },
          "amount_kobo": { "type": "integer", "description": "What is refunded" },
          "currency": { "type": "string" }
        }
      }
    },
    "refund.processed": {
      "title": "A refund to a customer went out",
      "correlation": "payment_id",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_id"],
        "properties": {
          "payment_id": { "type": "string", "description": "The payment refunded, as the payment capability answered it (refund takes it)" },
          "refund_id": { "type": "string", "description": "The rail's own reference for the refund, when its event carries one" },
          "amount_kobo": { "type": "integer", "description": "What is refunded" },
          "currency": { "type": "string" }
        }
      }
    },
    "refund.failed": {
      "title": "A refund failed; the money is back",
      "correlation": "payment_id",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_id"],
        "properties": {
          "payment_id": { "type": "string", "description": "The payment refunded, as the payment capability answered it (refund takes it)" },
          "refund_id": { "type": "string", "description": "The rail's own reference for the refund, when its event carries one" },
          "amount_kobo": { "type": "integer", "description": "What was to be refunded" },
          "currency": { "type": "string" },
          "reason": { "type": "string", "description": "Why, in the rail's words" }
        }
      }
    },
    "virtual_account.credited": {
      "title": "Money arrived in a customer's account number",
      "correlation": "reference",
      "fields": { "$ref": "#/$defs/credit" }
    },
    "pos.sale": {
      "title": "A POS terminal took a payment",
      "correlation": "reference",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "amount_kobo", "status"],
        "properties": {
          "reference": { "type": "string", "description": "The provider's reference for the transaction; a later report of the same transaction carries it again" },
          "amount_kobo": { "type": "integer", "description": "What the customer paid" },
          "fee_kobo": { "type": "integer", "description": "The provider's charge, when it reports one" },
          "settled_kobo": { "type": "integer", "description": "What reaches the business's account, when the provider reports it" },
          "status": { "enum": ["approved", "pending", "declined", "reversed"], "description": "A declined sale is reported too: no money moved" },
          "terminal": { "type": "string", "description": "The terminal's serial number" },
          "occurred_at": { "type": "string", "description": "RFC 3339" },
          "method": { "enum": ["card", "transfer", "wallet", "ussd", "qr", "other"], "description": "How the customer paid" },
          "payer_name": { "type": "string", "x-pii": "name" }
        }
      }
    },
    "books.invoice.created": {
      "title": "An invoice was made in the books",
      "kind": "product",
      "correlation": "invoice_id",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invoice_id"],
        "properties": {
          "invoice_id": { "type": "string" },
          "number": { "type": "string" },
          "customer_id": { "type": "string" },
          "total_kobo": { "type": "integer" },
          "currency": { "type": "string" }
        }
      }
    },
    "books.invoice.paid": {
      "title": "An invoice was paid in full in the books",
      "kind": "product",
      "correlation": "invoice_id",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invoice_id"],
        "properties": {
          "invoice_id": { "type": "string" },
          "number": { "type": "string" },
          "total_kobo": { "type": "integer" },
          "currency": { "type": "string" }
        }
      }
    },
    "books.payment.recorded": {
      "title": "A payment was recorded in the books",
      "kind": "product",
      "correlation": "invoice_id",
      "fields": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payment_id"],
        "properties": {
          "payment_id": { "type": "string" },
          "invoice_id": { "type": "string" },
          "amount_kobo": { "type": "integer" },
          "currency": { "type": "string" },
          "reference": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "payout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payout_id", "status"],
      "properties": {
        "payout_id": { "type": "string", "description": "For get_payout and the payout events" },
        "status": { "enum": ["settled", "pending", "failed"], "description": "pending until the rail reports it; failed only when no money left" },
        "fee_kobo": { "type": "integer" },
        "reason": { "type": "string", "description": "Why it failed or is pending, in the rail's words" }
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "x-pii": "name" },
        "email": { "type": "string", "x-pii": "email" },
        "phone": { "type": "string", "x-pii": "phone" },
        "bvn": { "type": "string", "x-pii": "bvn" },
        "nin": { "type": "string", "x-pii": "nin", "description": "National Identification Number, which some rails take instead of a BVN" }
      }
    },
    "credit": {
      "description": "One transfer into a customer's account number (virtual_account). amount_kobo is what the payer sent; where the rail settles net of its fee, settled_kobo is what landed and fee_kobo the fee. A rail that reports only what landed, with no fee, gives that as amount_kobo and leaves fee_kobo out (docs/spec/schools-rail-facts.md says which rail does what).",
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "credit_id", "amount_kobo"],
      "properties": {
        "reference": { "type": "string", "description": "The account's reference, as virtual_account answered it" },
        "credit_id": { "type": "string", "description": "The rail's own id for this one credit, the same in its event and in list_credits: two credits to one account have different ones" },
        "amount_kobo": { "type": "integer", "description": "What the payer sent" },
        "fee_kobo": { "type": "integer", "description": "The rail's fee on this credit, when it reports one" },
        "settled_kobo": { "type": "integer", "description": "What reached the business, when the rail reports it" },
        "currency": { "type": "string" },
        "account_number": { "type": "string", "description": "The account number paid into", "x-pii": "account_number" },
        "payer_name": { "type": "string", "x-pii": "name" },
        "payer_account": { "type": "string", "description": "The payer's account number, often masked by the rail", "x-pii": "account_number" },
        "payer_bank": { "type": "string" },
        "narration": { "type": "string", "description": "What the payer wrote, as the rail passed it on; often carries names", "x-pii": "other" },
        "occurred_at": { "type": "string", "description": "RFC 3339" },
        "event": { "type": "string", "enum": ["payment.received"], "description": "payment.received for a payment into a one-time number (collect_transfer) the rail lists among its credits: recorded as that payment, under the same key as its payment.received event, not as an account credit" }
      }
    }
  }
}
