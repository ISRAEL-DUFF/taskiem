{
  "schema": "wd-test/v1",
  "workflow": "../payrolla-salary-disbursement.wd.json",
  "env": { "payrolla_api_url": "https://payrolla.test/api" },
  "cases": [
    {
      "name": "pays a wallet employee and a bank employee, then reports",
      "trigger": { "body": {
        "payroll_id": "pr_2026_01", "period": "2026-01", "funding_wallet_id": "w_company", "total_kobo": 50000000,
        "employees": [
          { "employee_id": "e1", "net_pay_kobo": 30000000, "wallet_id": "w_e1" },
          { "employee_id": "e2", "net_pay_kobo": 20000000, "bank_code": "000", "account_number": "0123456789", "account_name": "Ada Obi" }
        ] } },
      "mocks": {
        "check_balance": { "output": { "balances": [ { "currency": "NGN", "available": 90000000 } ] } },
        "to_wallet": { "output": { "transfer_id": "t1", "status": "completed", "amount": "=input.amount" } },
        "to_bank": { "output": { "outflow_id": "o2", "status": "pending" } },
        "report": { "output": { "status": 200 } }
      },
      "signals": { "settle": { "payload": { "event": "wallet.outflow.confirmed", "body": { "data": { "outflow_id": "o2" } } } } },
      "approvals": { "approve": { "decision": "approved", "by": "checker" } },
      "expect": {
        "status": "completed",
        "steps": {
          "pay_all[0].to_wallet": "completed", "pay_all[0].to_bank": "skipped",
          "pay_all[1].to_wallet": "skipped", "pay_all[1].settle": "completed",
          "report_rejected": "skipped",
          "watch[0].watch_lane[0].watch_ends": "completed", "watch[0].watch_lane[0].reversal_event": "cancelled",
          "watch[0].watch_lane[0].reversal": "skipped", "watch[0].watch_lane[0].reversal_notice": "skipped"
        },
        "inputs": {
          "pay_all[0].to_wallet": { "from_wallet_id": "w_company", "to_wallet_id": "w_e1", "amount": 30000000, "narration": "Salary 2026-01 pr_2026_01 e1" },
          "pay_all[1].to_bank": { "bank_code": "000", "amount": 20000000, "narration": "Salary 2026-01 pr_2026_01 e2",
                                  "metadata": { "payroll_id": "pr_2026_01", "employee_id": "e2" } },
          "report": { "method": "POST", "url": "https://payrolla.test/api/payrolls/pr_2026_01/disbursement-report",
                      "body": { "status": "completed", "paid": 2, "failed": 0,
                                "totals": { "paid_kobo": 50000000, "bank_fees_kobo": 0, "paid_to_wallet": 1, "paid_to_bank": 1, "refused": 0, "failed_at_bank": 0, "unconfirmed": 0 } } }
        },
        "outputs": {
          "approve": { "decision": "approved", "decided_by": "checker" },
          "summary": { "paid": 2, "failed": 0 },
          "watching_for_reversals": { "watch_until": "2026-02-09T09:00:00Z", "payouts": 1, "outflow_ids": [ "o2" ] }
        },
        "calls": { "to_wallet": 1, "to_bank": 1, "report": 1, "reversal_notice": 0 }
      }
    },
    {
      "name": "a reversal after the report is sent to Payrolla as a notice, and pays no one",
      "trigger": { "body": {
        "payroll_id": "pr_2026_07", "period": "2026-07", "funding_wallet_id": "w_company", "total_kobo": 50000000,
        "employees": [
          { "employee_id": "e1", "net_pay_kobo": 30000000, "wallet_id": "w_e1" },
          { "employee_id": "e2", "net_pay_kobo": 20000000, "bank_code": "044", "account_number": "0123456789", "account_name": "Ada Obi" }
        ] } },
      "mocks": {
        "check_balance": { "output": { "balances": [ { "currency": "NGN", "available": 90000000 } ] } },
        "to_wallet": { "output": { "transfer_id": "t1", "status": "completed" } },
        "to_bank": { "output": { "outflow_id": "o2", "status": "pending", "amount": 20000000, "fee": 5350 } },
        "report": { "output": { "status": 200 } },
        "reversal_notice": [ { "error": { "kind": "retryable", "message": "503 from Payrolla" } }, { "output": { "status": 200 } } ]
      },
      "signals": {
        "settle": { "payload": { "event": "wallet.outflow.confirmed", "body": { "data": { "outflow_id": "o2", "fee": 5350 } } } },
        "reversal_event": { "payload": { "event": "wallet.outflow.reversed", "body": {
          "id": "evt_o2_reversed", "event_type": "wallet.outflow.reversed", "occurred_at": "2026-01-20T10:00:05Z",
          "data": { "outflow_id": "o2", "wallet_id": "w_company", "amount": 20000000, "fee": 5350, "total_reversed": 20005350,
                    "idempotency_key": "tsk_x", "provider_reference": "NIP-1", "reversed_at": "2026-01-20T10:00:00Z" } } } }
      },
      "approvals": { "approve": { "decision": "approved" } },
      "expect": {
        "status": "completed",
        "steps": {
          "report": "completed",
          "watch[0].watch_lane[0].reversal_event": "completed", "watch[0].watch_lane[0].watch_ends": "cancelled",
          "watch[0].watch_lane[0].reversal_notice": "completed"
        },
        "inputs": {
          "report": { "body": { "status": "completed", "paid": 2, "failed": 0,
                                "totals": { "paid_kobo": 50000000, "bank_fees_kobo": 5350, "paid_to_wallet": 1, "paid_to_bank": 1 } } },
          "watch[0].watch_lane[0].reversal_notice": {
            "method": "POST", "url": "https://payrolla.test/api/payrolls/pr_2026_07/reversal-notice",
            "headers": { "Authorization": "='Bearer ' + secrets.payrolla_api_token" },
            "body": { "payroll_id": "pr_2026_07", "employee_id": "e2", "outflow_id": "o2", "amount_kobo": 20000000, "fee_kobo": 5350,
                      "reversed_at": "2026-01-20T10:00:00Z", "event_id": "evt_o2_reversed",
                      "iswallet": { "total_reversed": 20005350, "provider_reference": "NIP-1" } } }
        },
        "calls": { "report": 1, "reversal_notice": 2, "to_wallet": 1, "to_bank": 1, "check_balance": 1 }
      }
    },
    {
      "name": "a reversal for an outflow the run does not watch sends nothing",
      "trigger": { "body": {
        "payroll_id": "pr_2026_08", "period": "2026-08", "funding_wallet_id": "w_company", "total_kobo": 20000000,
        "employees": [
          { "employee_id": "e2", "net_pay_kobo": 20000000, "bank_code": "044", "account_number": "0123456789", "account_name": "Ada Obi" }
        ] } },
      "mocks": {
        "check_balance": { "output": { "balances": [ { "currency": "NGN", "available": 90000000 } ] } },
        "to_bank": { "output": { "outflow_id": "o2", "status": "pending", "fee": 5350 } },
        "report": { "output": { "status": 200 } }
      },
      "signals": {
        "settle": { "payload": { "event": "wallet.outflow.confirmed", "body": { "data": { "outflow_id": "o2" } } } },
        "reversal_event": { "payload": { "event": "wallet.outflow.reversed", "body": {
          "id": "evt_o9_reversed", "occurred_at": "2026-01-20T10:00:05Z", "data": { "outflow_id": "o9", "amount": 99900, "fee": 5350 } } } }
      },
      "approvals": { "approve": { "decision": "approved" } },
      "expect": {
        "status": "completed",
        "steps": { "watch[0].watch_lane[0].reversal": "skipped", "watch[0].watch_lane[0].reversal_notice": "skipped" },
        "calls": { "reversal_notice": 0, "to_bank": 1 }
      }
    },
    {
      "name": "a notice Payrolla refuses is recorded and ends the watch for that payout only",
      "trigger": { "body": {
        "payroll_id": "pr_2026_09", "period": "2026-09", "funding_wallet_id": "w_company", "total_kobo": 40000000,
        "employees": [
          { "employee_id": "e1", "net_pay_kobo": 20000000, "bank_code": "044", "account_number": "0123456789", "account_name": "Ada Obi" },
          { "employee_id": "e2", "net_pay_kobo": 20000000, "bank_code": "044", "account_number": "0123456780", "account_name": "Bola Ade" }
        ] } },
      "mocks": {
        "check_balance": { "output": { "balances": [ { "currency": "NGN", "available": 90000000 } ] } },
        "pay_all[0].to_bank": { "output": { "outflow_id": "o1", "status": "pending", "fee": 5350 } },
        "pay_all[1].to_bank": { "output": { "outflow_id": "o2", "status": "pending", "fee": 5350 } },
        "report": { "output": { "status": 200 } },
        "reversal_notice": { "error": { "kind": "fatal", "message": "422 from Payrolla" } }
      },
      "signals": {
        "pay_all[0].settle": { "payload": { "event": "wallet.outflow.confirmed", "body": { "data": { "outflow_id": "o1" } } } },
        "pay_all[1].settle": { "payload": { "event": "wallet.outflow.confirmed", "body": { "data": { "outflow_id": "o2" } } } },
        "watch[0].watch_lane[0].reversal_event": { "payload": { "event": "wallet.outflow.reversed", "body": {
          "id": "evt_o1_reversed", "occurred_at": "2026-01-20T10:00:05Z", "data": { "outflow_id": "o1", "amount": 20000000, "fee": 5350 } } } }
      },
      "approvals": { "approve": { "decision": "approved" } },
      "expect": {
        "status": "completed",
        "steps": {
          "watch[0].watch_lane[0].reversal_notice": "failed", "watch[0].watch_lane[0].notice_failed": "completed",
          "watch[0].watch_lane[1].watch_ends": "completed", "watch[0].watch_lane[1].reversal_notice": "skipped"
        },
        "outputs": { "watch[0].watch_lane[0].notice_failed": { "employee_id": "e1", "outflow_id": "o1", "error": { "kind": "fatal" } } },
        "inputs": { "watch[0].watch_lane[0].reversal_notice": { "body": { "employee_id": "e1", "reversed_at": "2026-01-20T10:00:05Z" } } },
        "calls": { "reversal_notice": 1 }
      }
    },
    {
      "name": "the report carries totals by outcome, and only confirmed bank payouts are watched",
      "env": { "payrolla_reversal_watch_days": "10" },
      "trigger": { "body": {
        "payroll_id": "pr_2026_10", "period": "2026-10", "funding_wallet_id": "w_company", "total_kobo": 150000000,
        "employees": [
          { "employee_id": "w_ok", "net_pay_kobo": 30000000, "wallet_id": "w_1" },
          { "employee_id": "w_refused", "net_pay_kobo": 30000000, "wallet_id": "w_2" },
          { "employee_id": "b_ok", "net_pay_kobo": 30000000, "bank_code": "044", "account_number": "0000000001", "account_name": "A" },
          { "employee_id": "b_failed", "net_pay_kobo": 30000000, "bank_code": "044", "account_number": "0000000002", "account_name": "B" },
          { "employee_id": "b_unconfirmed", "net_pay_kobo": 30000000, "bank_code": "044", "account_number": "0000000003", "account_name": "C" }
        ] } },
      "mocks": {
        "check_balance": { "output": { "balances": [ { "currency": "NGN", "available": 900000000 } ] } },
        "pay_all[0].to_wallet": { "output": { "transfer_id": "t1", "status": "completed" } },
        "pay_all[1].to_wallet": { "error": { "kind": "fatal", "message": "iswallet 422 EXCEEDS_SINGLE_TXN_LIMIT" } },
        "pay_all[2].to_bank": { "output": { "outflow_id": "o3", "status": "pending", "fee": 5350 } },
        "pay_all[3].to_bank": { "output": { "outflow_id": "o4", "status": "pending", "fee": 5350 } },
        "pay_all[4].to_bank": { "output": { "outflow_id": "o5", "status": "pending", "fee": 5350 } },
        "report": { "output": { "status": 200 } }
      },
      "signals": {
        "pay_all[2].settle": { "payload": { "event": "wallet.outflow.confirmed", "body": { "data": { "outflow_id": "o3" } } } },
        "pay_all[3].settle": { "payload": { "event": "wallet.outflow.failed", "body": { "data": { "outflow_id": "o4" } } } },
        "pay_all[4].settle": { "timeout": true }
      },
      "approvals": { "approve": { "decision": "approved" } },
      "expect": {
        "status": "completed",
        "outputs": {
          "summary": { "paid": 2, "failed": 3,
                       "totals": { "paid_kobo": 60000000, "bank_fees_kobo": 5350, "paid_to_wallet": 1, "paid_to_bank": 1,
                                   "refused": 1, "failed_at_bank": 1, "unconfirmed": 1 } },
          "watching_for_reversals": { "watch_until": "2026-01-15T09:00:00Z", "payouts": 1, "outflow_ids": [ "o3" ] }
        },
        "inputs": { "report": { "body": { "paid": 2, "failed": 3, "totals": { "paid_kobo": 60000000, "bank_fees_kobo": 5350 } } } },
        "steps": { "watch[0].watch_lane[0].watch_ends": "completed", "watch[1]": "not_run" },
        "calls": { "reversal_notice": 0 }
      }
    },
    {
      "name": "a refused payment does not stop the others and is reported",
      "trigger": { "body": {
        "payroll_id": "pr_2026_02", "period": "2026-02", "funding_wallet_id": "w_company", "total_kobo": 50000000,
        "employees": [
          { "employee_id": "e1", "net_pay_kobo": 30000000, "wallet_id": "w_e1" },
          { "employee_id": "e2", "net_pay_kobo": 20000000, "wallet_id": "w_e2" }
        ] } },
      "mocks": {
        "check_balance": { "output": { "balances": [ { "currency": "NGN", "available": 90000000 } ] } },
        "pay_all[0].to_wallet": { "error": { "kind": "fatal", "message": "destination wallet is frozen" } },
        "to_wallet": { "output": { "transfer_id": "t2", "status": "completed" } },
        "report": { "output": { "status": 200 } }
      },
      "approvals": { "approve": { "decision": "approved" } },
      "expect": {
        "status": "completed",
        "steps": { "pay_all[0].to_wallet": "failed", "pay_all[0].wallet_failed": "completed", "pay_all[1].to_wallet": "completed",
                   "watch": "completed", "watch[0]": "not_run" },
        "outputs": {
          "pay_all[0].wallet_failed": { "employee_id": "e1", "rail": "wallet", "error": { "kind": "fatal" } },
          "summary": { "paid": 1, "failed": 1, "totals": { "paid_kobo": 20000000, "bank_fees_kobo": 0, "paid_to_wallet": 1, "refused": 1 } },
          "watching_for_reversals": { "payouts": 0, "outflow_ids": [] }
        },
        "calls": { "pay_all[0].to_wallet": 1 }
      }
    },
    {
      "name": "a lost response is retried under the same key and pays once",
      "trigger": { "body": {
        "payroll_id": "pr_2026_03", "period": "2026-03", "funding_wallet_id": "w_company", "total_kobo": 30000000,
        "employees": [ { "employee_id": "e1", "net_pay_kobo": 30000000, "wallet_id": "w_e1" } ] } },
      "mocks": {
        "check_balance": { "output": { "balances": [ { "currency": "NGN", "available": 90000000 } ] } },
        "to_wallet": [
          { "error": { "kind": "unknown_outcome", "message": "500 after the transfer posted" } },
          { "output": { "transfer_id": "t1", "status": "completed" } }
        ],
        "report": { "output": { "status": 200 } }
      },
      "approvals": { "approve": { "decision": "approved" } },
      "expect": { "status": "completed", "outputs": { "summary": { "paid": 1, "failed": 0 } }, "calls": { "to_wallet": 2 } }
    },
    {
      "name": "a bank payout that is never confirmed counts as failed",
      "trigger": { "body": {
        "payroll_id": "pr_2026_04", "period": "2026-04", "funding_wallet_id": "w_company", "total_kobo": 20000000,
        "employees": [ { "employee_id": "e2", "net_pay_kobo": 20000000, "bank_code": "000", "account_number": "0123456789", "account_name": "Ada Obi" } ] } },
      "mocks": {
        "check_balance": { "output": { "balances": [ { "currency": "NGN", "available": 90000000 } ] } },
        "to_bank": { "output": { "outflow_id": "o2", "status": "pending" } },
        "report": { "output": { "status": 200 } }
      },
      "signals": { "settle": { "timeout": true } },
      "approvals": { "approve": { "decision": "approved" } },
      "expect": {
        "status": "completed",
        "steps": { "pay_all[0].settle": "failed", "pay_all[0].bank_unconfirmed": "completed" },
        "outputs": { "summary": { "paid": 0, "failed": 1 } }
      }
    },
    {
      "name": "a rejected payroll pays no one and is reported",
      "trigger": { "body": {
        "payroll_id": "pr_2026_05", "period": "2026-05", "funding_wallet_id": "w_company", "total_kobo": 30000000,
        "employees": [ { "employee_id": "e1", "net_pay_kobo": 30000000, "wallet_id": "w_e1" } ] } },
      "mocks": {
        "check_balance": { "output": { "balances": [ { "currency": "NGN", "available": 90000000 } ] } },
        "report_rejected": { "output": { "status": 200 } }
      },
      "approvals": { "approve": { "decision": "rejected" } },
      "expect": {
        "status": "completed",
        "steps": { "pay_all": "skipped", "report": "skipped", "report_rejected": "completed", "watching_for_reversals": "skipped", "watch": "skipped" },
        "inputs": { "report_rejected": { "body": { "status": "rejected", "reason": "rejected_by_approver",
                                                   "totals": { "paid_kobo": 0, "bank_fees_kobo": 0, "paid_to_wallet": 0, "paid_to_bank": 0, "refused": 0, "failed_at_bank": 0, "unconfirmed": 0 } } } },
        "calls": { "to_wallet": 0 }
      }
    },
    {
      "name": "an approval nobody answers expires after 24 hours and is reported",
      "trigger": { "body": {
        "payroll_id": "pr_2026_06", "period": "2026-06", "funding_wallet_id": "w_company", "total_kobo": 30000000,
        "employees": [ { "employee_id": "e1", "net_pay_kobo": 30000000, "wallet_id": "w_e1" } ] } },
      "mocks": {
        "check_balance": { "output": { "balances": [ { "currency": "NGN", "available": 90000000 } ] } },
        "report_rejected": { "output": { "status": 200 } }
      },
      "approvals": { "approve": { "timeout": true } },
      "expect": {
        "status": "completed",
        "inputs": { "report_rejected": { "body": { "status": "rejected", "reason": "approval_timed_out" } } }
      }
    }
  ]
}
