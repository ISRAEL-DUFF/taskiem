{
  "schema": "wd/v1",
  "id": "wf_payrollaSalaryDisbursement",
  "version": 1,
  "name": "Payrolla: disburse approved payroll",
  "description": "Pays every employee in an approved Payrolla payroll from the company's iswallet wallet, after maker-checker approval: by wallet transfer to employees with an iswallet wallet, by bank payout otherwise. Reports each outcome to Payrolla.",
  "trigger": {
    "type": "webhook",
    "config": { "path": "/payrolla/payroll-approved", "auth": "hmac", "dedup": "=trigger.body.payroll_id" }
  },
  "inputs": { "schema": { "$ref": "#/types/PayrollApproved" } },
  "steps": [
    {
      "id": "summarise",
      "type": "transform",
      "config": {
        "output": {
          "payroll_id": "=trigger.body.payroll_id",
          "employees": "=size(trigger.body.employees)",
          "to_bank": "=size(trigger.body.employees.filter(e, !has(e.wallet_id)))",
          "total_kobo": "=trigger.body.total_kobo"
        }
      }
    },
    {
      "id": "check_balance",
      "type": "connector",
      "connector": "iswallet@1",
      "action": "get_balance",
      "input": { "wallet_id": "=trigger.body.funding_wallet_id" },
      "retry": { "max": 3, "backoff": "exponential", "initial": "2s" }
    },
    {
      "id": "approve",
      "type": "approval",
      "needs": ["summarise", "check_balance"],
      "config": {
        "policy": "maker_checker",
        "role": "payroll_approver",
        "timeout": "24h",
        "on_timeout": "reject",
        "subject": {
          "payroll_id": "=steps.summarise.output.payroll_id",
          "period": "=trigger.body.period",
          "employees": "=steps.summarise.output.employees",
          "paid_to_bank": "=steps.summarise.output.to_bank",
          "total_kobo": "=steps.summarise.output.total_kobo",
          "available_kobo": "=steps.check_balance.output.balances.filter(b, b.currency == 'NGN').map(b, b.available)[0]"
        }
      }
    },
    {
      "id": "pay_all",
      "type": "foreach",
      "needs": ["approve"],
      "when": "=steps.approve.output.decision == 'approved'",
      "config": {
        "items": "=trigger.body.employees",
        "max_concurrency": 5,
        "max_items": 5000,
        "steps": [
          {
            "id": "to_wallet",
            "type": "connector",
            "connector": "iswallet@1",
            "action": "transfer",
            "when": "=has(item.wallet_id)",
            "input": {
              "from_wallet_id": "=trigger.body.funding_wallet_id",
              "to_wallet_id": "=item.wallet_id",
              "amount": "=item.net_pay_kobo",
              "narration": "='Salary ' + trigger.body.period + ' ' + trigger.body.payroll_id + ' ' + item.employee_id"
            },
            "effect": { "idempotency_seed": "=trigger.body.payroll_id + ':' + item.employee_id" },
            "retry": { "max": 8, "backoff": "exponential", "initial": "5s", "max_delay": "10m", "max_duration": "6h" }
          },
          {
            "id": "to_bank",
            "type": "connector",
            "connector": "iswallet@1",
            "action": "payout",
            "when": "=!has(item.wallet_id)",
            "input": {
              "wallet_id": "=trigger.body.funding_wallet_id",
              "amount": "=item.net_pay_kobo",
              "bank_code": "=item.bank_code",
              "account_number": "=item.account_number",
              "account_name": "=item.account_name",
              "narration": "='Salary ' + trigger.body.period",
              "metadata": { "payroll_id": "=trigger.body.payroll_id", "employee_id": "=item.employee_id" }
            },
            "effect": { "idempotency_seed": "=trigger.body.payroll_id + ':' + item.employee_id" },
            "retry": { "max": 8, "backoff": "exponential", "initial": "5s", "max_delay": "10m", "max_duration": "6h" }
          },
          {
            "id": "settle",
            "type": "signal",
            "needs": ["to_bank"],
            "when": "=steps.to_bank.output.status == 'pending'",
            "config": {
              "event": "iswallet@1:outflow_event",
              "correlation": "=steps.to_bank.output.outflow_id",
              "timeout": "72h"
            }
          }
        ]
      }
    },
    {
      "id": "report",
      "type": "http",
      "needs": ["pay_all"],
      "when": "=steps.approve.output.decision == 'approved'",
      "config": {
        "method": "POST",
        "url": "=env.payrolla_api_url + '/payrolls/' + trigger.body.payroll_id + '/disbursement-report'",
        "headers": { "Authorization": "='Bearer ' + secrets.payrolla_api_token" },
        "body": { "payroll_id": "=trigger.body.payroll_id", "results": "=steps.pay_all.output" },
        "class": "idempotent_write",
        "idempotency_header": "Idempotency-Key"
      },
      "retry": { "max": 5, "backoff": "exponential", "initial": "2s" }
    }
  ],
  "types": {
    "PayrollApproved": {
      "type": "object",
      "required": ["payroll_id", "period", "funding_wallet_id", "total_kobo", "employees"],
      "properties": {
        "payroll_id": { "type": "string" },
        "period": { "type": "string" },
        "funding_wallet_id": { "type": "string", "description": "Payrolla's company wallet on iswallet" },
        "total_kobo": { "type": "integer", "minimum": 0 },
        "employees": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["employee_id", "net_pay_kobo"],
            "properties": {
              "employee_id": { "type": "string" },
              "net_pay_kobo": { "type": "integer", "minimum": 100 },
              "wallet_id": { "type": "string", "description": "The employee's iswallet wallet under the Payrolla client; omit to pay to a bank account" },
              "bank_code": { "type": "string" },
              "account_number": { "type": "string", "x-pii": "account_number" },
              "account_name": { "type": "string", "x-pii": "name" }
            },
            "oneOf": [
              { "required": ["wallet_id"] },
              { "required": ["bank_code", "account_number", "account_name"] }
            ]
          }
        }
      }
    }
  },
  "settings": { "timeout": "96h", "concurrency_key": "=trigger.body.payroll_id" }
}
