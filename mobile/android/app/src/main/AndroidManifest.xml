<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The app lock opens with the phone's own fingerprint, face or PIN. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- A voice note to a business (lib/chat/composer.dart). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Reaching Taskiem at all: only the debug and profile builds had it,
         so a release build could not sign in. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Notifications on this phone (lib/app/notify.dart): Android 13 and
         later asks the person when they turn them on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Finding friends from the phone's contacts (lib/chat/people_contacts.dart),
         asked only after the person agrees in the app; read, hashed, never kept. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <!-- Sending a place in a chat with a person (lib/chat/people_place.dart),
         asked only when the person taps A place; read once, never followed. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Scanning a person's QR code in the app (lib/chat/people_scan.dart),
         asked only when the person taps Scan a QR code. Declared, it makes
         the image picker ask for the camera before each photo taken too;
         refused, every place that takes a photo says so with the way to
         the phone's settings (lib/chat/pick_problem.dart). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- open_filex asks to read the phone's photos, videos and music; the app
         opens only its own kept copy of a chat's document (lib/chat/file_card.dart),
         through the plugin's file provider, so none of these is needed. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>
    <application
        android:label="Taskiem"
        android:name=".TaskiemApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Links to the server's pages open the app (lib/app/applinks.dart),
                 verified against its /.well-known/assetlinks.json; the rest
                 of its site stays in the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="${taskiemHost}"/>
                <data android:path="/chat"/>
                <data android:path="/approvals"/>
                <data android:pathPrefix="/invoices/"/>
                <data android:pathPrefix="/trade-orders/"/>
                <data android:pathPrefix="/storefront/orders/"/>
                <data android:pathPrefix="/bills/"/>
                <data android:pathPrefix="/purchases/"/>
                <!-- Payments, a payment and a batch to confirm (the chat's links). -->
                <data android:path="/payments"/>
                <data android:pathPrefix="/payments/"/>
                <!-- A person's link and its QR code (people-chatting §5.2). -->
                <data android:pathPrefix="/p/"/>
                <!-- A group's invite link and its QR code (people-chatting §9). -->
                <data android:pathPrefix="/g/"/>
                <!-- A password reset's link (lib/screens/forgot_password.dart). -->
                <data android:path="/reset-password"/>
                <!-- One of the business's pages (/pages/<name>, a Tell me
                     message's page button's link: pages H5), and never a page's
                     editor (/pages/<name>/edit), which stays on the web. Android
                     12 and later read this pattern; earlier ones open the link in
                     the browser, as before. -->
                <data android:pathAdvancedPattern="/pages/[a-z][a-z0-9-]+"/>
            </intent-filter>
            <!-- The links go to app_links, not Flutter's own router. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
        </activity>
        <!-- A notification sent without a kind goes to Business chats. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="business" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- A page in the phone's browser tab (lib/app/links.dart): a
             connect link's sign-in must run in Custom Tabs, never a web
             view inside the app, which providers refuse. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
