{
  "id": "weekly-balance-email",
  "title": "Weekly balances email to the owner",
  "summary": "Every week, email the owner the balance of the payments account you connected.",
  "description": "Once a week at the day and time you choose, checks your payments account's naira balance and emails it to the owner, so cash on hand is never a surprise. Works with Paystack, Moniepoint, iswallet, Flutterwave or Anchor.",
  "category": "reporting",
  "tags": [
    "reporting",
    "balance",
    "email",
    "weekly"
  ],
  "keywords": [
    "balance",
    "balances",
    "cash",
    "cashflow",
    "flow",
    "weekly",
    "email",
    "summary",
    "report",
    "monday",
    "accounts",
    "money"
  ],
  "connectors": [
    "gmail@1",
    "capability:balance"
  ],
  "variables": [
    {
      "name": "owner_email",
      "why": "The owner's email address."
    }
  ],
  "params": [
    {
      "name": "business_name",
      "type": "string",
      "title": "Business name",
      "description": "Named in the email's subject.",
      "required": true,
      "example": "Kemi's Bakery",
      "max_length": 60
    },
    {
      "name": "day",
      "type": "weekday",
      "title": "Day",
      "description": "The day of the week the email goes out.",
      "required": true,
      "default": "monday",
      "example": "monday"
    },
    {
      "name": "send_time",
      "type": "time",
      "title": "Time",
      "description": "When the email goes out, Lagos time.",
      "required": false,
      "default": "08:00",
      "example": "08:00"
    },
    {
      "name": "gmail_connection",
      "type": "connection",
      "connector": "gmail",
      "title": "Gmail connection",
      "description": "The mailbox the email is sent from.",
      "required": false,
      "default": "main",
      "example": "main"
    },
    {
      "name": "rail_connection",
      "type": "connection",
      "capability": [
        "balance"
      ],
      "title": "Payments account",
      "description": "The account whose balance is emailed: any you connected that reports one.",
      "required": false,
      "default": "",
      "example": ""
    },
    {
      "name": "funding_account",
      "type": "string",
      "title": "Wallet to check",
      "description": "Only for iswallet and Anchor, which hold several wallets: the one to check. Leave it blank otherwise.",
      "required": false,
      "default": "",
      "example": "",
      "max_length": 100
    }
  ],
  "definition": {
    "schema": "wd/v1",
    "id": "wf_weeklyBalanceEmail",
    "version": 1,
    "name": "Weekly balances email",
    "trigger": {
      "type": "schedule",
      "config": {
        "cron": "{{send_time:minute}} {{send_time:hour}} * * {{day:cron}}",
        "timezone": "Africa/Lagos"
      }
    },
    "steps": [
      {
        "id": "settings",
        "type": "transform",
        "name": "Use your business name",
        "config": {
          "output": {
            "business_name": "{{business_name}}"
          }
        }
      },
      {
        "id": "balance",
        "type": "capability",
        "uses": "balance",
        "name": "Check the balance",
        "connection": "{{rail_connection}}",
        "input": {
          "account": "{{funding_account}}"
        }
      },
      {
        "id": "email_owner",
        "type": "connector",
        "name": "Email the owner both balances",
        "connector": "gmail@1",
        "action": "send_message",
        "connection": "{{gmail_connection}}",
        "needs": [
          "settings",
          "balance"
        ],
        "input": {
          "to": [
            "=env.owner_email"
          ],
          "subject": "=steps.settings.output.business_name + ': balances this week'",
          "text": "='Balance this week (NGN): ' + string(steps.balance.output.available_kobo / 100)"
        }
      }
    ],
    "settings": {
      "timeout": "15m"
    }
  }
}
