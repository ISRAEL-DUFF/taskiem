{
  "id": "ticket-answer",
  "title": "Answer a customer's ticket",
  "summary": "Send a customer the answer to their ticket the way they wrote to you, and record it on the ticket.",
  "description": "Sends the answer to the customer of a ticket the way the ticket came: by email in the same conversation (through your Taskiem helpdesk address), from your own Zoho Mail or Gmail mailbox or WhatsApp number (its sending workflow sends it), to a member of your business who asked (IT and HR requests), or on WhatsApp, Telegram or by text. The answer is saved with the ticket's messages, and the ticket is marked waiting on the customer or resolved. The ticket reply form and the follow-up workflow use it. An HR request's reference (HR-1042, or HC-1042 for a confidential one) finds it in the HR tables instead.",
  "category": "customers",
  "tags": [
    "support",
    "tickets",
    "helpdesk"
  ],
  "keywords": [
    "ticket",
    "tickets",
    "support",
    "helpdesk",
    "answer",
    "reply",
    "customer service"
  ],
  "requires": [
    "ticket",
    "tickets",
    "helpdesk",
    "support desk"
  ],
  "connectors": [
    "xenibase@1",
    "email@1",
    "notify@1"
  ],
  "params": [],
  "tables": [
    {
      "known": "tickets"
    },
    {
      "known": "ticket_messages"
    }
  ],
  "callable": true,
  "outputs": [
    {
      "name": "found",
      "type": "boolean",
      "title": "Ticket found",
      "description": "Whether the ticket is in its tickets table (the HR ones for HR- and HC- references).",
      "value": "=steps.how.output.found"
    },
    {
      "name": "sent_by",
      "type": "string",
      "title": "How it went",
      "description": "email (in the conversation), mailbox (left for the business's own mailbox or WhatsApp number to send), member (told as a member of the business), message (WhatsApp, Telegram, text or email), none (no way to reach the customer) or missing (no such ticket).",
      "value": "=steps.how.output.how"
    }
  ],
  "definition": {
    "schema": "wd/v1",
    "id": "wf_ticketAnswer",
    "version": 1,
    "name": "Answer a ticket",
    "trigger": {
      "type": "manual"
    },
    "inputs": {
      "schema": {
        "type": "object",
        "required": [
          "reference",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "title": "Ticket",
            "description": "T-1042 is a customer's ticket (the tickets tables); HR-1042 an HR request (hr_tickets and hr_ticket_messages) and HC-1042 a confidential one (hr_confidential_tickets and hr_confidential_messages)"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "title": "The answer",
            "x-pii": "other"
          },
          "author": {
            "type": "string",
            "maxLength": 120,
            "title": "Who answers",
            "x-pii": "name"
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting_on_customer",
              "resolved",
              "open"
            ],
            "title": "The ticket is then"
          },
          "assign_to": {
            "type": "string",
            "maxLength": 200,
            "title": "Assign it to (a member's sign-in email), if no one has it",
            "x-pii": "email"
          }
        }
      }
    },
    "steps": [
      {
        "id": "tables",
        "type": "transform",
        "name": "Choose the tables by the reference",
        "config": {
          "output": {
            "tickets": "=trigger.body.reference.upperAscii().startsWith('HR-') ? 'hr_tickets' : trigger.body.reference.upperAscii().startsWith('HC-') ? 'hr_confidential_tickets' : 'tickets'",
            "messages": "=trigger.body.reference.upperAscii().startsWith('HR-') ? 'hr_ticket_messages' : trigger.body.reference.upperAscii().startsWith('HC-') ? 'hr_confidential_messages' : 'ticket_messages'"
          }
        }
      },
      {
        "id": "find",
        "type": "connector",
        "name": "Find the ticket",
        "connector": "xenibase@1",
        "action": "read_rows",
        "connection": "data_tables",
        "input": {
          "table": "=steps.tables.output.tickets",
          "filters": [
            {
              "column": "reference",
              "op": "eq",
              "value": "=trigger.body.reference.upperAscii()"
            }
          ],
          "limit": 1
        },
        "needs": [
          "tables"
        ]
      },
      {
        "id": "how",
        "type": "transform",
        "name": "Choose how the customer hears it",
        "needs": [
          "find"
        ],
        "config": {
          "output": {
            "found": "=steps.find.output.rows.size() > 0 && steps.find.output.rows[0].?reference.orValue('') != ''",
            "how": "=steps.find.output.rows.size() == 0 || steps.find.output.rows[0].?reference.orValue('') == '' ? 'missing' : steps.find.output.rows[0].?mail.orValue('') in ['zoho', 'gmail'] && steps.find.output.rows[0].?customer_email.orValue('') != '' ? 'mailbox' : steps.find.output.rows[0].?mail.orValue('') == 'whatsapp' && steps.find.output.rows[0].?customer_phone.orValue('') != '' ? 'mailbox' : steps.find.output.rows[0].?mail.orValue('') == 'member' && steps.find.output.rows[0].?customer_email.orValue('') != '' ? 'member' : steps.find.output.rows[0].?mail.orValue('') == 'taskiem' && steps.find.output.rows[0].?customer_email.orValue('') != '' && steps.find.output.rows[0].?mailbox.orValue('') != '' ? 'email' : steps.find.output.rows[0].?customer_phone.orValue('') != '' || steps.find.output.rows[0].?customer_email.orValue('') != '' ? 'message' : 'none'"
          }
        }
      },
      {
        "id": "send",
        "type": "branch",
        "name": "Send the answer",
        "needs": [
          "how"
        ],
        "config": {
          "paths": [
            {
              "name": "email",
              "when": "=steps.how.output.how == 'email'",
              "steps": [
                {
                  "id": "email",
                  "type": "connector",
                  "name": "Email the customer in the conversation",
                  "connector": "email@1",
                  "action": "send_in_thread",
                  "input": {
                    "to": "=steps.find.output.rows[0].customer_email",
                    "subject": "=steps.find.output.rows[0].?subject.orValue('') != '' ? steps.find.output.rows[0].subject : 'Your ticket ' + steps.find.output.rows[0].reference",
                    "message": "=trigger.body.message",
                    "thread": "=steps.find.output.rows[0].?thread.orValue('') != '' ? steps.find.output.rows[0].thread : steps.find.output.rows[0].reference",
                    "address": "=steps.find.output.rows[0].mailbox"
                  }
                }
              ]
            },
            {
              "name": "message",
              "when": "=steps.how.output.how == 'message'",
              "steps": [
                {
                  "id": "message",
                  "type": "connector",
                  "name": "Message the customer",
                  "connector": "notify@1",
                  "action": "message",
                  "input": {
                    "phone": "=steps.find.output.rows[0].?customer_phone.orValue('')",
                    "email": "=steps.find.output.rows[0].?customer_email.orValue('')",
                    "about": "='your ticket ' + steps.find.output.rows[0].reference",
                    "title": "='Your ticket ' + steps.find.output.rows[0].reference",
                    "message": "=trigger.body.message"
                  }
                }
              ]
            },
            {
              "name": "member",
              "when": "=steps.how.output.how == 'member'",
              "steps": [
                {
                  "id": "member",
                  "type": "connector",
                  "name": "Tell the member",
                  "connector": "notify@1",
                  "action": "tell",
                  "input": {
                    "to": "members",
                    "members": "=[steps.find.output.rows[0].customer_email]",
                    "title": "='Your request ' + steps.find.output.rows[0].reference",
                    "message": "=steps.find.output.rows[0].reference + (steps.find.output.rows[0].?subject.orValue('') != '' ? ' (' + steps.find.output.rows[0].subject + ')' : '') + ':\\n' + trigger.body.message"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "record",
        "type": "connector",
        "name": "Save the answer with the ticket's messages",
        "connector": "xenibase@1",
        "action": "insert_rows",
        "connection": "data_tables",
        "needs": [
          "send"
        ],
        "when": "=steps.how.output.found",
        "input": {
          "table": "=steps.tables.output.messages",
          "row": {
            "reference": "=steps.find.output.rows[0].reference",
            "direction": "out",
            "author": "=trigger.body.?author.orValue('') != '' ? trigger.body.author : 'Taskiem'",
            "body": "=trigger.body.message",
            "at": "=run.started_at",
            "channel": "=steps.how.output.how == 'message' ? steps.find.output.rows[0].?channel.orValue('') : steps.how.output.how == 'member' ? steps.find.output.rows[0].?channel.orValue('staff') : steps.how.output.how == 'mailbox' && steps.find.output.rows[0].?mail.orValue('') == 'whatsapp' ? 'whatsapp' : 'email'",
            "mail": "=steps.how.output.how in ['email', 'mailbox', 'member'] ? steps.find.output.rows[0].mail : ''",
            "message_id": "=steps.how.output.how == 'email' ? steps.send.output.steps.email.message_id : ''",
            "sent_at": "=steps.how.output.how in ['mailbox', 'none'] ? null : run.started_at"
          }
        }
      },
      {
        "id": "update",
        "type": "connector",
        "name": "Mark the ticket",
        "connector": "xenibase@1",
        "action": "update_rows",
        "connection": "data_tables",
        "needs": [
          "send"
        ],
        "when": "=steps.how.output.found",
        "input": {
          "table": "=steps.tables.output.tickets",
          "key": "=steps.find.output.rows[0].id",
          "set": {
            "status": "=trigger.body.?status.orValue(steps.find.output.rows[0].?status.orValue(''))",
            "last_reply_at": "=run.started_at",
            "resolved_at": "=trigger.body.?status.orValue('') == 'resolved' ? run.started_at : steps.find.output.rows[0].?resolved_at.orValue(null)",
            "assigned_to": "=steps.find.output.rows[0].?assigned_to.orValue('') == '' ? trigger.body.?assign_to.orValue('') : steps.find.output.rows[0].assigned_to"
          }
        }
      }
    ],
    "settings": {
      "timeout": "30m"
    }
  }
}
