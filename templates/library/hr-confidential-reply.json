{
  "id": "hr-confidential-reply",
  "title": "Answer confidential HR requests",
  "summary": "A form for your HR lead alone: answer a confidential request, and the member who raised it gets the answer.",
  "description": "The form for answering the confidential matters your staff raise with the HR help desk (a complaint, a concern or a personal matter), open only to members with the hr_lead role when they are signed in to Taskiem: other HR people cannot open it, nor read those requests. hr_lead types the request's number (HC-1042; the message telling them of a new one has a link that fills it in), writes the answer and chooses: answer and wait for the member, answer and mark it resolved, or a note only hr_lead sees. The member gets the answer on WhatsApp, Telegram or by email, and it is saved with the request in your confidential HR tables. Put this form's link in the setting hr_confidential_reply_form so every new confidential request's message carries it.",
  "category": "approvals",
  "tags": [
    "support",
    "tickets",
    "helpdesk",
    "hr",
    "form"
  ],
  "keywords": [
    "hr",
    "human resources",
    "hr desk",
    "request",
    "requests",
    "answer",
    "reply",
    "respond",
    "staff",
    "form",
    "confidential"
  ],
  "requires": [
    "confidential hr requests",
    "hr confidential",
    "confidential complaints",
    "answer confidential hr requests"
  ],
  "connectors": [
    "xenibase@1",
    "notify@1"
  ],
  "params": [],
  "tables": [
    {
      "known": "hr_confidential_tickets"
    },
    {
      "known": "hr_confidential_messages"
    }
  ],
  "definition": {
    "schema": "wd/v1",
    "id": "wf_hrConfidentialReply",
    "version": 1,
    "name": "Answer confidential HR requests",
    "description": "A form for hr_lead that answers a member's confidential HR request, resolves it, or adds a note for HR.",
    "trigger": {
      "type": "form",
      "config": {
        "title": "Answer a confidential HR request",
        "access": "members",
        "roles": [
          "hr_lead"
        ],
        "description": "The member gets your answer on WhatsApp, Telegram or by email.",
        "after": {
          "mode": "message",
          "message": "Done. If the request number was wrong, you will be told."
        }
      }
    },
    "inputs": {
      "schema": {
        "type": "object",
        "required": [
          "ticket",
          "what",
          "message"
        ],
        "properties": {
          "ticket": {
            "type": "string",
            "title": "Request number",
            "maxLength": 24,
            "pattern": "^([Hh][Cc])?-? ?[0-9]{1,9}$",
            "x-form": {
              "prefill": true,
              "placeholder": "HC-1042"
            }
          },
          "what": {
            "type": "string",
            "title": "What you are doing",
            "enum": [
              "Answer and wait for the member",
              "Answer, and the request is resolved",
              "A note for HR (the member does not see it)"
            ]
          },
          "message": {
            "type": "string",
            "title": "Your answer or note",
            "maxLength": 5000,
            "x-pii": "other",
            "x-form": {
              "widget": "textarea"
            }
          },
          "agent": {
            "type": "string",
            "title": "Your name",
            "maxLength": 120,
            "x-pii": "name",
            "x-form": {
              "from": "member.name"
            }
          },
          "agent_email": {
            "type": "string",
            "title": "Your email",
            "maxLength": 200,
            "x-pii": "email",
            "x-form": {
              "from": "member.email"
            }
          }
        }
      }
    },
    "steps": [
      {
        "id": "ref",
        "type": "transform",
        "name": "Read the request number",
        "config": {
          "output": {
            "reference": "='HC-' + trigger.body.ticket.upperAscii().replace('HC', '').replace('-', '').replace(' ', '')"
          }
        }
      },
      {
        "id": "find",
        "type": "connector",
        "name": "Find the request",
        "connector": "xenibase@1",
        "action": "read_rows",
        "connection": "data_tables",
        "needs": [
          "ref"
        ],
        "input": {
          "table": "hr_confidential_tickets",
          "filters": [
            {
              "column": "reference",
              "op": "eq",
              "value": "=steps.ref.output.reference"
            }
          ],
          "limit": 1
        }
      },
      {
        "id": "act",
        "type": "branch",
        "name": "Answer the member, or note it for HR",
        "needs": [
          "find"
        ],
        "config": {
          "paths": [
            {
              "name": "note",
              "when": "=steps.find.output.rows.size() > 0 && steps.find.output.rows[0].?reference.orValue('') != '' && trigger.body.what == 'A note for HR (the member does not see it)'",
              "steps": [
                {
                  "id": "note",
                  "type": "connector",
                  "name": "Save the note with the request",
                  "connector": "xenibase@1",
                  "action": "insert_rows",
                  "connection": "data_tables",
                  "input": {
                    "table": "hr_confidential_messages",
                    "row": {
                      "reference": "=steps.ref.output.reference",
                      "direction": "note",
                      "author": "=trigger.body.?agent.orValue('')",
                      "body": "=trigger.body.message",
                      "at": "=run.started_at",
                      "channel": "note"
                    }
                  }
                }
              ]
            },
            {
              "name": "answer",
              "when": "=steps.find.output.rows.size() > 0 && steps.find.output.rows[0].?reference.orValue('') != ''",
              "steps": [
                {
                  "id": "answer",
                  "type": "template",
                  "template": "ticket-answer",
                  "name": "Answer the member",
                  "params": {},
                  "input": {
                    "reference": "=steps.ref.output.reference",
                    "message": "=trigger.body.message",
                    "author": "=trigger.body.?agent.orValue('')",
                    "status": "=trigger.body.what == 'Answer, and the request is resolved' ? 'resolved' : 'waiting_on_customer'",
                    "assign_to": "=trigger.body.?agent_email.orValue('')"
                  }
                }
              ]
            }
          ],
          "default": {
            "steps": [
              {
                "id": "missing",
                "type": "connector",
                "name": "Tell you there is no such request",
                "connector": "notify@1",
                "action": "tell",
                "input": {
                  "to": "=trigger.body.?agent_email.orValue('') != '' ? 'members' : 'owner'",
                  "members": "=trigger.body.?agent_email.orValue('') != '' ? [trigger.body.agent_email] : []",
                  "title": "='No request ' + steps.ref.output.reference",
                  "message": "='There is no request ' + steps.ref.output.reference + ', so your answer was not sent. Check the number and send the form again.'"
                }
              }
            ]
          }
        }
      }
    ],
    "settings": {
      "timeout": "30m"
    }
  }
}
