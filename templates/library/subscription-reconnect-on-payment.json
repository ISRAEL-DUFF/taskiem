{
  "id": "subscription-reconnect-on-payment",
  "title": "Switch a subscriber back on when they pay",
  "summary": "When an invoice that covers a month is paid in full, find the subscriber by phone, switch them back on if they were off, move their renewal date on, and thank them.",
  "description": "Starts the moment one of your invoices is paid in full. Looks the customer up in your subscribers table by their phone number (the last ten digits, so +234 and 0 numbers match). If they are there, their renewal date moves on by the days you choose (from today, or from their current date if it is later), they are marked active, and, if they had been switched off, they are switched back on by calling the address your system gives for that. Then they get a text saying they are back. A payment smaller than the subscriber's monthly price (an equipment sale, a part-payment that finished an old invoice) renews no one. Invoices for people who are not subscribers do nothing, and neither does a switched-off subscriber with no account on your system filled in. Put the key your system gives you in Settings as a secret named billing_system_key, and allow your system's address there first (both are under Settings: turn Advanced on to see the list of allowed addresses).",
  "category": "subscriptions",
  "tags": [
    "subscriptions",
    "reconnect",
    "invoices",
    "customers",
    "payment"
  ],
  "keywords": [
    "reconnect",
    "switch on",
    "restore",
    "back on",
    "paid",
    "payment",
    "subscription",
    "subscriber",
    "renew",
    "internet",
    "isp",
    "broadband",
    "activate"
  ],
  "requires": [
    "subscribers",
    "reconnect",
    "switch back on"
  ],
  "connectors": [
    "xenibase@1",
    "notify@1"
  ],
  "params": [
    {
      "name": "business_name",
      "type": "string",
      "title": "Business name",
      "description": "How your customers know you; it starts every message.",
      "required": true,
      "example": "Fibre Link",
      "max_length": 60
    },
    {
      "name": "extend_days",
      "type": "integer",
      "title": "Days to add",
      "description": "How many days a payment adds to the renewal date.",
      "required": true,
      "default": 30,
      "example": 30,
      "minimum": 1,
      "maximum": 366
    },
    {
      "name": "reconnect_address",
      "type": "string",
      "title": "Address on your system",
      "description": "The address your system gives for switching one customer back on. Taskiem sends it the customer's account.",
      "required": true,
      "example": "https://billing.example.com/api/reconnect",
      "max_length": 200
    },
    {
      "name": "subscribers_table",
      "type": "string",
      "title": "Subscribers table",
      "description": "Your subscribers: name, phone, plan, price each month, when it renews and whether they are active. Taskiem makes it for you if it does not exist.",
      "required": false,
      "default": "subscribers",
      "example": "subscribers",
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "picker": "table"
    }
  ],
  "tables": [
    {
      "known": "subscribers",
      "name": "{{subscribers_table}}"
    }
  ],
  "definition": {
    "schema": "wd/v1",
    "id": "wf_subscriptionReconnectOnPayment",
    "version": 1,
    "name": "Switch a subscriber back on when they pay",
    "description": "Renews the subscriber who paid, and switches them back on if they were off.",
    "trigger": {
      "type": "invoice",
      "config": {
        "event": "paid"
      }
    },
    "steps": [
      {
        "id": "settings",
        "type": "transform",
        "name": "Use your business name",
        "config": {
          "output": {
            "business_name": "{{business_name}}"
          }
        }
      },
      {
        "id": "find",
        "type": "connector",
        "name": "Find the subscriber by phone",
        "connector": "xenibase@1",
        "action": "read_rows",
        "connection": "data_tables",
        "when": "=has(trigger.body.customer.phone) && trigger.body.customer.phone != null && size(string(trigger.body.customer.phone)) >= 10",
        "input": {
          "table": "{{subscribers_table}}",
          "filters": [
            {
              "column": "phone",
              "op": "like",
              "value": "='%' + string(trigger.body.customer.phone).substring(size(string(trigger.body.customer.phone)) - 10)"
            }
          ],
          "limit": 1
        }
      },
      {
        "id": "renewal",
        "type": "transform",
        "name": "Work out the new renewal date",
        "needs": [
          "find"
        ],
        "when": "=has(steps.find.output.rows) && size(steps.find.output.rows) > 0 && has(steps.find.output.rows[0].monthly_naira) && steps.find.output.rows[0].monthly_naira != null && int(trigger.body.amount_kobo) >= int(double(steps.find.output.rows[0].monthly_naira) * 100.0)",
        "config": {
          "output": {
            "renews_on": "=string((has(steps.find.output.rows[0].renews_on) && steps.find.output.rows[0].renews_on != null && timestamp(string(steps.find.output.rows[0].renews_on).substring(0, 10) + 'T00:00:00Z') > timestamp(run.started_at) ? timestamp(string(steps.find.output.rows[0].renews_on).substring(0, 10) + 'T00:00:00Z') : timestamp(run.started_at)) + duration(string({{extend_days}} * 24) + 'h')).substring(0, 10)"
          }
        }
      },
      {
        "id": "restore",
        "type": "branch",
        "name": "Was the subscriber switched off?",
        "needs": [
          "settings",
          "renewal"
        ],
        "config": {
          "paths": [
            {
              "name": "was_off",
              "when": "=has(steps.find.output.rows) && size(steps.find.output.rows) > 0 && has(steps.find.output.rows[0].status) && steps.find.output.rows[0].status == 'suspended' && has(steps.find.output.rows[0].account_ref) && steps.find.output.rows[0].account_ref != null && string(steps.find.output.rows[0].account_ref) != ''",
              "steps": [
                {
                  "id": "switch_on",
                  "type": "http",
                  "name": "Switch them back on on your system",
                  "config": {
                    "method": "POST",
                    "url": "{{reconnect_address}}",
                    "headers": {
                      "Authorization": "='Bearer ' + secrets.billing_system_key"
                    },
                    "body": {
                      "account": "=string(steps.find.output.rows[0].account_ref)",
                      "action": "reconnect"
                    },
                    "class": "idempotent_write",
                    "idempotency_header": "Idempotency-Key"
                  },
                  "effect": {
                    "idempotency_seed": "='reconnect:' + trigger.body.number"
                  }
                },
                {
                  "id": "renew_off",
                  "type": "connector",
                  "name": "Mark them active and move their renewal date on",
                  "connector": "xenibase@1",
                  "action": "update_rows",
                  "connection": "data_tables",
                  "input": {
                    "table": "{{subscribers_table}}",
                    "filters": [
                      {
                        "column": "phone",
                        "op": "eq",
                        "value": "=string(steps.find.output.rows[0].phone)"
                      }
                    ],
                    "max_affected": 1,
                    "set": {
                      "status": "active",
                      "renews_on": "=steps.renewal.output.renews_on"
                    }
                  },
                  "effect": {
                    "idempotency_seed": "='renew:' + trigger.body.number"
                  },
                  "needs": [
                    "switch_on"
                  ]
                },
                {
                  "id": "thank_off",
                  "type": "connector",
                  "name": "Text them they are back",
                  "connector": "notify@1",
                  "action": "text",
                  "needs": [
                    "renew_off"
                  ],
                  "input": {
                    "to": "=string(trigger.body.customer.phone)",
                    "message": "=steps.settings.output.business_name + ': Thank you, we received your payment and your service is active until ' + steps.renewal.output.renews_on.substring(0, 10) + '.'"
                  },
                  "effect": {
                    "idempotency_seed": "='reconnect-text:' + trigger.body.number"
                  }
                }
              ]
            },
            {
              "name": "was_on",
              "when": "=has(steps.find.output.rows) && size(steps.find.output.rows) > 0 && !(has(steps.find.output.rows[0].status) && steps.find.output.rows[0].status == 'suspended')",
              "steps": [
                {
                  "id": "renew_on",
                  "type": "connector",
                  "name": "Mark them active and move their renewal date on",
                  "connector": "xenibase@1",
                  "action": "update_rows",
                  "connection": "data_tables",
                  "input": {
                    "table": "{{subscribers_table}}",
                    "filters": [
                      {
                        "column": "phone",
                        "op": "eq",
                        "value": "=string(steps.find.output.rows[0].phone)"
                      }
                    ],
                    "max_affected": 1,
                    "set": {
                      "status": "active",
                      "renews_on": "=steps.renewal.output.renews_on"
                    }
                  },
                  "effect": {
                    "idempotency_seed": "='renew:' + trigger.body.number"
                  }
                },
                {
                  "id": "thank_on",
                  "type": "connector",
                  "name": "Text them they are back",
                  "connector": "notify@1",
                  "action": "text",
                  "needs": [
                    "renew_on"
                  ],
                  "input": {
                    "to": "=string(trigger.body.customer.phone)",
                    "message": "=steps.settings.output.business_name + ': Thank you, we received your payment and your service is active until ' + steps.renewal.output.renews_on.substring(0, 10) + '.'"
                  },
                  "effect": {
                    "idempotency_seed": "='reconnect-text:' + trigger.body.number"
                  }
                }
              ]
            }
          ],
          "default": {
            "steps": [
              {
                "id": "nothing_to_do",
                "type": "transform",
                "name": "Nothing to do: not a subscriber, or no account to switch back on",
                "config": {
                  "output": {
                    "changed": false
                  }
                }
              }
            ]
          }
        }
      }
    ],
    "settings": {
      "timeout": "30m"
    }
  }
}
