{
  "id": "helpdesk-whatsapp-send",
  "title": "Send ticket answers from your WhatsApp number",
  "summary": "Answers to tickets that came to your WhatsApp number go to the customer from that number.",
  "description": "The partner of A helpdesk on your WhatsApp number: whenever an answer to a ticket that came to your WhatsApp number is saved (the first answer with the ticket's number, your team's answers from the ticket reply form, and the closing message when a customer stops answering), it is sent to the customer from your own WhatsApp number, and marked as sent. WhatsApp lets a business write freely only within 24 hours of the customer's last message; after that, the answer goes the way you choose: by Taskiem's messages (WhatsApp or Telegram where the customer asked for updates, else a text message), by email when the ticket has the customer's email, or both. With your helpdesk's Taskiem email address, that email comes from it and the customer's reply joins their ticket. Answers to tickets that came another way are left alone.",
  "category": "customers",
  "tags": [
    "support",
    "tickets",
    "helpdesk",
    "whatsapp"
  ],
  "keywords": [
    "ticket",
    "tickets",
    "support",
    "helpdesk",
    "whatsapp",
    "answer",
    "reply",
    "chat",
    "email"
  ],
  "requires": [
    "ticket",
    "tickets",
    "helpdesk",
    "help desk",
    "support desk"
  ],
  "connectors": [
    "xenibase@1",
    "whatsapp@1",
    "notify@1",
    "email@1"
  ],
  "params": [
    {
      "name": "whatsapp_connection",
      "type": "connection",
      "connector": "whatsapp",
      "title": "WhatsApp connection",
      "description": "Your business's WhatsApp number your customers write to: the same as your helpdesk's.",
      "required": false,
      "default": "main",
      "example": "main"
    },
    {
      "name": "late_answers",
      "type": "string",
      "title": "Answers after WhatsApp's 24 hours",
      "description": "sms: by Taskiem's messages (WhatsApp or Telegram where the customer asked for updates, else a text message). email: by email when the ticket has the customer's email, else by Taskiem's messages. sms_and_email: both, the email only when the ticket has one.",
      "required": false,
      "default": "sms",
      "example": "sms",
      "enum": [
        "sms",
        "email",
        "sms_and_email"
      ]
    },
    {
      "name": "helpdesk_address",
      "type": "string",
      "title": "Your helpdesk's Taskiem email address (optional)",
      "description": "The email address of your A helpdesk on your Taskiem email address workflow. With it, late answers by email come from that address and the customer's reply joins their ticket. Without it, they go as a plain email from Taskiem's messages.",
      "required": false,
      "default": "",
      "example": "k3x9q2m7a1bz@in.taskiem.app",
      "max_length": 200
    }
  ],
  "tables": [
    {
      "known": "tickets"
    },
    {
      "known": "ticket_messages"
    }
  ],
  "definition": {
    "schema": "wd/v1",
    "id": "wf_helpdeskWhatsappSend",
    "version": 1,
    "name": "Send ticket answers from WhatsApp",
    "description": "Sends each ticket answer left for the WhatsApp number, and marks it sent.",
    "trigger": {
      "type": "connector_event",
      "config": {
        "connector": "xenibase@1",
        "trigger": "row_changed",
        "connection": "data_tables",
        "events": [
          "INSERT"
        ],
        "options": {
          "tables": [
            "ticket_messages"
          ]
        }
      }
    },
    "inputs": {
      "schema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "record": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "reference": {
                "type": "string"
              },
              "direction": {
                "type": "string"
              },
              "mail": {
                "type": "string"
              },
              "author": {
                "type": "string",
                "x-pii": "name"
              },
              "body": {
                "type": "string",
                "x-pii": "other"
              },
              "sent_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "channel": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "steps": [
      {
        "id": "ticket",
        "type": "connector",
        "name": "Find the answer's ticket",
        "connector": "xenibase@1",
        "action": "read_rows",
        "connection": "data_tables",
        "when": "=has(trigger.body.record.direction) && trigger.body.record.direction == 'out' && trigger.body.record.?mail.orValue('') == 'whatsapp' && trigger.body.record.?sent_at.orValue(null) == null && trigger.body.record.?body.orValue('') != ''",
        "input": {
          "table": "tickets",
          "filters": [
            {
              "column": "reference",
              "op": "eq",
              "value": "=trigger.body.record.reference"
            }
          ],
          "limit": 1
        }
      },
      {
        "id": "how",
        "type": "transform",
        "name": "Within WhatsApp's 24 hours, and how late answers go",
        "needs": [
          "ticket"
        ],
        "config": {
          "output": {
            "how": "=steps.ticket.output.rows.size() == 0 || steps.ticket.output.rows[0].?customer_phone.orValue('') == '' ? 'none' : steps.ticket.output.rows[0].?last_customer_at.orValue(null) != null && timestamp(run.started_at) - timestamp(steps.ticket.output.rows[0].last_customer_at) < duration('23h30m') ? 'whatsapp' : 'message'",
            "email": "=steps.ticket.output.rows.size() > 0 && steps.ticket.output.rows[0].?customer_email.orValue('') != '' && {{late_answers}} in ['email', 'sms_and_email']",
            "mode": "{{late_answers}}",
            "address": "{{helpdesk_address}}"
          }
        }
      },
      {
        "id": "send",
        "type": "branch",
        "name": "Send the answer",
        "needs": [
          "how"
        ],
        "config": {
          "paths": [
            {
              "name": "whatsapp",
              "when": "=steps.how.output.how == 'whatsapp'",
              "steps": [
                {
                  "id": "chat",
                  "type": "connector",
                  "name": "Answer the customer from your WhatsApp number",
                  "connector": "whatsapp@1",
                  "action": "send_text",
                  "connection": "{{whatsapp_connection}}",
                  "input": {
                    "to": "=steps.ticket.output.rows[0].customer_phone",
                    "body": "=(trigger.body.record.body.size() > 4096 ? trigger.body.record.body.substring(0, 4096) : trigger.body.record.body)"
                  }
                }
              ]
            },
            {
              "name": "message",
              "when": "=steps.how.output.how == 'message' && (!steps.how.output.email || steps.how.output.mode == 'sms_and_email')",
              "steps": [
                {
                  "id": "message",
                  "type": "connector",
                  "name": "Message the customer (past WhatsApp's 24 hours)",
                  "connector": "notify@1",
                  "action": "message",
                  "input": {
                    "phone": "=steps.ticket.output.rows[0].customer_phone",
                    "about": "='your ticket ' + steps.ticket.output.rows[0].reference",
                    "title": "='Your ticket ' + steps.ticket.output.rows[0].reference",
                    "message": "=(trigger.body.record.body.size() > 1500 ? trigger.body.record.body.substring(0, 1500) : trigger.body.record.body)"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "late_email",
        "type": "branch",
        "name": "Email the customer (past WhatsApp's 24 hours)",
        "needs": [
          "how"
        ],
        "config": {
          "paths": [
            {
              "name": "thread",
              "when": "=steps.how.output.how == 'message' && steps.how.output.email && steps.how.output.address != ''",
              "steps": [
                {
                  "id": "thread_email",
                  "type": "connector",
                  "name": "Email the customer from your helpdesk's address",
                  "connector": "email@1",
                  "action": "send_in_thread",
                  "input": {
                    "to": "=steps.ticket.output.rows[0].customer_email",
                    "subject": "='Your ticket ' + steps.ticket.output.rows[0].reference",
                    "message": "=trigger.body.record.body",
                    "thread": "=steps.ticket.output.rows[0].?thread.orValue('') != '' ? steps.ticket.output.rows[0].thread : steps.ticket.output.rows[0].reference",
                    "address": "=steps.how.output.address"
                  }
                }
              ]
            },
            {
              "name": "plain",
              "when": "=steps.how.output.how == 'message' && steps.how.output.email",
              "steps": [
                {
                  "id": "plain_email",
                  "type": "connector",
                  "name": "Email the customer",
                  "connector": "notify@1",
                  "action": "message",
                  "input": {
                    "email": "=steps.ticket.output.rows[0].customer_email",
                    "about": "='your ticket ' + steps.ticket.output.rows[0].reference",
                    "title": "='Your ticket ' + steps.ticket.output.rows[0].reference",
                    "message": "=(trigger.body.record.body.size() > 1500 ? trigger.body.record.body.substring(0, 1500) : trigger.body.record.body)"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "mark",
        "type": "connector",
        "name": "Mark the answer sent",
        "connector": "xenibase@1",
        "action": "update_rows",
        "connection": "data_tables",
        "needs": [
          "send",
          "late_email"
        ],
        "when": "=steps.how.output.how != 'none'",
        "input": {
          "table": "ticket_messages",
          "key": "=trigger.body.record.id",
          "set": {
            "sent_at": "=run.started_at",
            "message_id": "=steps.how.output.how == 'whatsapp' ? steps.send.output.steps.chat.?message_id.orValue('') : ''"
          }
        }
      }
    ],
    "settings": {
      "timeout": "15m"
    }
  }
}
