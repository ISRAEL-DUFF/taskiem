{
  "schema": "wd-test/v1",
  "template": "failed-transfer-alert",
  "params": {
    "gmail_connection": "main"
  },
  "cases": [
    {
      "name": "a failed payment from any rail tells the owner and the accountant",
      "trigger": {
        "event": "payout.failed",
        "fields": {
          "payout_id": "tsk_po_9",
          "reason": "Account closed"
        }
      },
      "mocks": {
        "text_owner": {
          "output": {
            "people": 1
          }
        },
        "email_accountant": {
          "output": {
            "id": "m1"
          }
        }
      },
      "expect": {
        "status": "completed",
        "outputs": {
          "message": {
            "text": "A payment you sent (tsk_po_9) failed: Account closed."
          }
        },
        "inputs": {
          "email_accountant": {
            "subject": "A payment failed"
          }
        }
      }
    },
    {
      "name": "a payment that came back says so, with or without a reason",
      "trigger": {
        "event": "payout.reversed",
        "fields": {
          "payout_id": "tsk_po_9"
        }
      },
      "mocks": {
        "text_owner": {
          "output": {
            "people": 1
          }
        },
        "email_accountant": {
          "output": {
            "id": "m1"
          }
        }
      },
      "expect": {
        "status": "completed",
        "outputs": {
          "message": {
            "text": "A payment you sent (tsk_po_9) came back from the bank."
          }
        },
        "inputs": {
          "email_accountant": {
            "subject": "A payment came back"
          }
        }
      }
    }
  ],
  "env": {
    "accountant_email": "accounts@example.com"
  }
}
