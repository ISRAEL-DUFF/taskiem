            }
          }
        ]
      },
      "approvals": {
        "approve": {
          "decision": "approved",
          "by": "finance"
        }
      },
      "expect": {
        "status": "completed",
        "calls": {
          "pay_all[0].pay": 2,
          "pay_all[1].pay": 2
        }
      }
    }
  ]
}
