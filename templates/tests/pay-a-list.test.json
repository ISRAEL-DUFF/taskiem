                "name": "Ada Obi",
                "amount_naira": 25000,
                "bank_code": "044",
                "account_number": "0690000031",
                "account_name": "Ada Obi"
              },
              {
                "id": 2,
                "batch": "OCT-COMMS",
                "name": "Bola Ade",
                "amount_naira": 15000.5,
                "bank_code": "058",
                "account_number": "0123456789",
                "account_name": "Bola Ade"
              },
              {
                "id": 3,
                "batch": "OCT-COMMS",
                "name": "Chidi Eze",
                "amount_naira": 9000,
                "bank_code": "058",
                "account_number": "12345",
                "account_name": "Chidi Eze"
              }
            ]
          }
        },
        "balance": {
          "output": {
            "available_kobo": 10000000,
            "currency": "NGN"
          }
        },
        "record": {
          "output": {
            "affected": 2
          }
        },
        "tell_owner": {
          "output": {
            "people": 1
          }
        },
        "tell_rejected": {
          "output": {
            "people": 1
          }
        },
        "pay": [
          {
            "error": {
