{
  "schema": "wd-test/v1",
  "template": "helpdesk-whatsapp-send",
  "params": {},
  "cases": [
    {
      "name": "an answer within 24 hours of the customer's message goes from the WhatsApp number and is marked sent",
      "mocks": {
        "chat": {
          "output": {
            "message_id": "wamid.R1",
            "wa_id": "2348030000001"
          }
        },
        "message": {
          "output": {
            "via": "sms"
          }
        },
        "mark": {
          "output": {
            "affected": 1
          }
        },
        "ticket": {
          "output": {
            "rows": [
              {
                "id": 42,
                "reference": "T-1042",
                "customer_phone": "+2348030000001",
                "channel": "whatsapp",
                "mail": "whatsapp",
                "last_customer_at": "2099-01-01T00:00:00Z"
              }
            ]
          }
        }
      },
      "trigger": {
        "event": "INSERT",
        "body": {
          "type": "INSERT",
          "record": {
            "id": 501,
            "reference": "T-1042",
            "direction": "out",
            "author": "Bola",
            "body": "Your rider is 10 minutes away.",
            "channel": "whatsapp",
            "mail": "whatsapp",
            "sent_at": null
          }
        }
      },
      "expect": {
        "status": "completed",
        "inputs": {
          "ticket": {
            "filters": [
              {
                "column": "reference",
                "op": "eq",
                "value": "T-1042"
              }
            ]
          },
          "chat": {
            "to": "+2348030000001",
            "body": "Your rider is 10 minutes away."
          },
          "mark": {
            "table": "ticket_messages",
            "key": 501,
            "set": {
              "message_id": "wamid.R1"
            }
          }
        },
        "steps": {
          "message": "not_run"
        }
      }
    },
