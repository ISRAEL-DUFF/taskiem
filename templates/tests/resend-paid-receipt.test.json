{
  "schema": "wd-test/v1",
  "template": "resend-paid-receipt",
  "params": {
    "from": "Ada Cakes <orders@adacakes.ng>",
    "business_name": "Ada Cakes"
  },
  "cases": [
    {
      "name": "the customer gets one receipt from the business's domain",
      "trigger": {
        "event": "paid",
        "body": {
          "event": "paid",
          "id": "0192f0aa-0000-7000-8000-000000000042",
          "number": "INV-0042",
          "status": "paid",
          "amount_kobo": 5375000,
          "amount": "₦53,750",
          "paid_kobo": 5375000,
          "currency": "NGN",
          "customer": {
            "name": "Adaeze Okafor",
            "email": "ada@example.com"
          },
          "paid_at": "2026-10-26T14:05:00+01:00",
          "link": "https://pay.example/i/x"
        }
      },
      "mocks": {
        "receipt": {
          "output": {
            "email_id": "49a3999c"
          }
        }
      },
      "expect": {
        "status": "completed",
        "inputs": {
          "receipt": {
            "from": "Ada Cakes <orders@adacakes.ng>",
            "to": [
              "ada@example.com"
            ],
            "subject": "Receipt for invoice INV-0042",
            "text": "Dear Adaeze Okafor,\n\nThank you: we have received ₦53,750 for invoice INV-0042, which is now paid in full.\n\nAda Cakes"
          }
        }
      }
    },
    {
      "name": "no email, no receipt",
      "trigger": {
        "event": "paid",
        "body": {
          "event": "paid",
          "id": "0192f0aa-0000-7000-8000-000000000042",
          "number": "INV-0042",
          "status": "paid",
          "amount_kobo": 5375000,
          "amount": "₦53,750",
          "paid_kobo": 5375000,
          "currency": "NGN",
          "customer": {
            "name": "Bola Ade"
          },
          "paid_at": "2026-10-26T14:05:00+01:00",
          "link": "https://pay.example/i/x"
        }
      },
      "expect": {
        "status": "completed",
        "steps": {
          "receipt": "skipped"
        }
      }
    }
  ]
}
