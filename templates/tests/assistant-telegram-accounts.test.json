  "cases": [
    {
      "name": "a balance question is answered from the customer's own account, read for them",
      "trigger": {
        "event": "message",
        "guard": {
          "outcome": "answer",
          "reason": "",
          "reply": "",
          "notice": "",
          "language": "en",
          "first": false,
          "kind": "text",
          "text": "How much is in my wallet?",
          "channel": "telegram@1/main/prod",
          "sender": "55501"
        },
        "body": {
          "update_id": 1,
          "message": {
            "message_id": 7,
            "chat": {
              "id": 55501,
              "type": "private"
            }
          }
        }
      },
      "mocks": {
        "typing": {
          "output": {
            "ok": true
          }
        },
        "gather": {
          "output": {
            "latest": true,
            "earlier": [],
            "earlier_text": ""
          }
        },
        "look_t__acct": {
          "output": {
            "rows": [
              {
                "id": 1,
                "sender": "55501",
                "account": "c-ada"
              }
            ]
          }
        },
        "look_t__classify": {
          "output": {
            "intent": "balance"
          }
        },
        "look_t__bal": {
          "output": {
            "available_kobo": 4930000,
            "currency": "NGN"
          }
        },
        "answer_t__memory": {
          "output": {
            "rows": []
          }
        },
        "answer_t__know": {
          "output": {
            "found": false,
            "material": "",
            "passages": []
          }
        },
        "answer_t__reply": {
          "output": {
            "reply": "You have ₦49,300 in your wallet.",
            "needs_person": false
          }
        },
        "answer_t__check": {
          "output": {
            "ok": true,
            "text": "You have ₦49,300 in your wallet.",
            "problems": []
          }
        },
        "answer_t__keep": {
          "output": {
            "affected": 2,
            "rows": []
          }
        },
        "send_t": {
          "output": {
            "message_id": 8
          }
        }
      },
      "expect": {
        "status": "completed",
        "steps": {
          "look_t__bal": "completed",
          "send_t": "completed"
        },
        "inputs": {
          "look_t__acct": {
            "filters": [
              {
                "column": "channel",
                "op": "eq",
                "value": "telegram"
              },
              {
                "column": "sender",
                "op": "in",
                "values": [
                  "55501"
                ]
              }
            ]
          },
          "answer_t__reply": {
            "input": {
              "account": "This customer asked about their balance. Their balance, read just now from their own account: 49300.00 naira."
            }
          },
          "answer_t__check": {
            "material": "\n\nThis customer asked about their balance. Their balance, read just now from their own account: 49300.00 naira."
          },
          "send_t": {
            "chat_id": "55501",
            "text": "You have ₦49,300 in your wallet."
          }
        }
      }
    },
