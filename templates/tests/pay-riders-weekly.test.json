        },
        "inputs": {
          "prepare": {
            "batch_id": "0193a6f0-0000-7000-8000-000000000001"
          },
          "release_unchecked": {
            "results": [
              {
                "payout_id": "p3",
                "status": "failed"
              }
            ]
          },
          "tell_unchecked": {
            "to": "owner",
            "title": "Riders' payout",
            "message": "No rider was paid: their banks did not find the account of 1 rider. Check the account numbers under Riders > Pay riders; they are paid next time."
          }
        }
