    {
      "name": "no account found: those riders wait for next time",
      "trigger": {
        "body": {
          "batch_id": "0193a6f0-0000-7000-8000-000000000001"
        }
      },
      "mocks": {
        "prepare": {
          "output": {
            "batch_id": "0193a6f0-0000-7000-8000-000000000001",
            "payouts": [
              {
                "payout_id": "p3",
                "rider": "Ngozi",
                "amount_kobo": 50000,
