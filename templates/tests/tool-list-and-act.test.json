{
  "schema": "wd-test/v1",
  "template": "tool-list-and-act",
  "params": {},
  "cases": [
    {
      "name": "lists the open rows, each with its button",
      "trigger": {"body": {}},
      "mocks": {"mark": {"output": {"affected": 0, "rows": []}}, "find": {"output": {"rows": [{"id": 3, "title": "Printer jam", "status": "open"}, {"id": 4, "title": "No Wi-Fi", "status": "open"}]}}},
      "expect": {"status": "completed", "answer": {"title": "Still open", "rows": [{"title": "Printer jam"}, {"title": "No Wi-Fi"}]}}
    },
    {
      "name": "a row's button marks it and lists the rest",
      "trigger": {"body": {"done": 3}},
      "mocks": {"mark": {"output": {"affected": 1, "rows": [{"id": 3}]}}, "find": {"output": {"rows": [{"id": 4, "title": "No Wi-Fi", "status": "open"}]}}},
      "expect": {"status": "completed", "steps": {"mark": "completed"}, "answer": {"rows": [{"title": "No Wi-Fi"}]}}
    }
  ]
}
