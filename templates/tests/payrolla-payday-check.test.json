        "inputs": {
          "runs": {
            "status": "COMPUTED,APPROVED,LOCKED"
          },
          "warn": {
            "message": "Payroll due soon needs NGN 420000, but the account holds NGN 300000. Top up NGN 120000 before payday."
          }
        }
      }
