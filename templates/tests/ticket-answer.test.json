              "status": "resolved"
            }
          }
        },
        "steps": {
          "email": "not_run",
          "message": "not_run"
        }
      }
    },
    {
      "name": "a WhatsApp ticket is answered on the customer's phone",
      "trigger": {
        "body": {
          "reference": "T-1042",
          "message": "We will call you today."
        }
      },
      "mocks": {
        "record": {
          "output": {
            "affected": 1
          }
        },
        "update": {
          "output": {
            "affected": 1
          }
        },
        "find": {
          "output": {
            "rows": [
              {
                "id": 42,
                "reference": "T-1042",
                "subject": "Order 42 is late",
                "customer_name": "Ada Obi",
                "customer_email": "",
                "customer_phone": "+2348030000001",
                "channel": "whatsapp",
                "status": "new",
                "assigned_to": "",
                "thread": "T-1042",
                "mail": "",
                "mailbox": ""
              }
            ]
          }
        },
        "message": {
          "output": {
