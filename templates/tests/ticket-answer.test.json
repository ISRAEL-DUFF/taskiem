            "thread": "T-1042",
            "address": "k3x9q2m7a1bz@in.taskiem.app"
          },
          "record": {
            "table": "ticket_messages",
            "row": {
              "reference": "T-1042",
              "direction": "out",
              "author": "Bola",
              "body": "Your order left this morning.",
              "channel": "email",
              "mail": "taskiem",
              "message_id": "tk-2@in.taskiem.app"
