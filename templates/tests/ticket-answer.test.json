      "trigger": {
        "body": {
          "reference": "T-1042",
          "message": "Refunded. Thank you!",
          "status": "resolved"
        }
      },
      "mocks": {
        "record": {
          "output": {
            "affected": 1
          }
        },
        "update": {
          "output": {
            "affected": 1
          }
        },
        "find": {
          "output": {
            "rows": [
              {
                "id": 42,
                "reference": "T-1042",
                "subject": "Order 42 is late",
                "customer_name": "Ada Obi",
                "customer_email": "ada@example.com",
                "customer_phone": "",
                "channel": "email",
                "status": "open",
                "assigned_to": "bola@adacakes.ng",
                "thread": "18c2f0e1a2b3c4d5",
                "mail": "gmail",
                "mailbox": ""
              }
            ]
          }
        }
      },
      "expect": {
        "status": "completed",
        "inputs": {
          "record": {
            "row": {
              "author": "Taskiem",
              "mail": "gmail",
              "channel": "email",
              "message_id": ""
