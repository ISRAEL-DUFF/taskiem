          "email": "ada@example.com",
          "phone": "+2348030000001",
          "external_id": "msg_981"
        },
        "headers": {},
        "query": {}
      },
      "mocks": {
        "open__ticket": {
          "output": {
            "affected": 1,
            "rows": [
              {
                "id": 42
