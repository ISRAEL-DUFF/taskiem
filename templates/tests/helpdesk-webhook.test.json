        "open__ack_sent": {
          "output": {
            "affected": 1
          }
        },
        "open__ack_message": {
          "output": {
            "via": "sms"
          }
        },
        "open__ack_noted": {
          "output": {
            "affected": 1
          }
        },
        "open__ack_queued": {
          "output": {
            "affected": 1
          }
        },
        "open__ack_member": {
          "output": {
            "people": 1
          }
