              "priority": "urgent"
            }
          },
          "open__ack_email": {
            "to": "ada@example.com",
            "thread": "T-1042",
            "address": "k3x9q2m7a1bz@in.taskiem.app"
          }
        },
        "outputs": {
          "answer": {
            "status": 201,
            "body": {
              "reference": "T-1042",
              "department": "Billing",
              "priority": "urgent",
              "told_by": "email",
              "external_id": "msg_981"
            }
          }
        },
        "steps": {
          "open__ack_message": "not_run"
        }
      }
    },
