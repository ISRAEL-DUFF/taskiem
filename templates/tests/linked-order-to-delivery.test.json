{
  "schema": "wd-test/v1",
  "template": "linked-order-to-delivery",
  "params": {},
  "cases": [
    {
      "name": "within the amount and the limit: accepted and dispatched",
      "trigger": {
        "type": "link",
        "event": "order.received",
        "body": {
          "event": "order.received",
          "link": "l1",
          "business": "Ada's Kitchen",
          "reference": "P-7QX4KD",
          "total_kobo": 45000000,
          "note": "",
          "lines": [
            {
              "item": "Rice 50kg",
              "unit": "bag",
              "quantity": 10,
              "price_kobo": 4500000
            }
          ]
        }
      },
      "mocks": {
        "order": {
          "output": {
            "reference": "P-7QX4KD",
            "side": "seller",
            "business": "Ada's Kitchen",
            "link": "l1",
            "status": "received",
            "total_kobo": 45000000,
            "lines": [],
            "over_limit": false
          }
        },
        "accept": {
          "output": {
            "reference": "P-7QX4KD",
            "status": "accepted"
          }
        },
        "dispatch": {
          "output": {
            "reference": "P-7QX4KD",
            "status": "dispatched"
          }
        }
      },
      "expect": {
        "status": "completed",
        "steps": {
          "held": "skipped"
        },
        "inputs": {
          "accept": {
            "reference": "P-7QX4KD",
            "step": "accept"
          },
          "dispatch": {
            "reference": "P-7QX4KD",
            "step": "dispatched"
          }
        }
      }
    },
    {
