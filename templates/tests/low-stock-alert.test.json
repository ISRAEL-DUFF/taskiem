{
  "schema": "wd-test/v1",
  "template": "low-stock-alert",
  "params": {},
  "cases": [
    {
      "name": "tells the owner the low items with how many to order",
      "trigger": {
        "scheduled_time": "2026-10-29T06:30:00Z"
      },
      "mocks": {
        "low": {
          "output": {
            "count": 2,
            "items": [
              {
                "id": "1",
                "name": "Indomie",
                "stock": 4,
                "suggest": 46,
                "low": true
              },
              {
                "id": "2",
                "name": "Garri",
                "low": true
              }
            ]
          }
        },
        "text_owner": {
          "output": {
            "sent": true
          }
        }
      },
      "expect": {
        "status": "completed",
        "steps": {
          "text_owner": "completed"
        },
        "inputs": {
          "text_owner": {
            "message": "Low on stock: Indomie (4 left, order 46); Garri"
          }
        }
      }
    },
    {
      "name": "says nothing when nothing is low",
      "trigger": {
        "scheduled_time": "2026-10-30T06:30:00Z"
      },
      "mocks": {
        "low": {
          "output": {
            "count": 0,
            "items": []
          }
        }
      },
      "expect": {
        "status": "completed",
        "steps": {
          "text_owner": "skipped"
        }
      }
    }
  ]
}
