{
  "schema": "wd-test/v1",
  "template": "payrolla-approve-by-chat",
  "params": {
    "business_name": "Chuks Electronics"
  },
  "cases": [
    {
      "name": "approvers get the total and the link, and a reminder when still not approved",
      "trigger": {
        "event": "run.computed",
        "body": {
          "id": "01J9Z0000000000000000000E1",
          "type": "run.computed",
          "api_version": "2026-11-01",
          "created_at": "2026-10-28T10:00:00Z",
          "company_id": "co",
          "data": {
            "run": {
              "run_id": "run-10",
              "period_start": "2026-10-01",
              "period_end": "2026-10-31",
              "pay_date": "2026-01-09",
              "run_type": "REGULAR",
              "status": "COMPUTED",
              "employee_count": 2,
              "total_gross_kobo": 50000000,
              "total_net_kobo": 42000000
            },
            "approval_url": "https://payroller.surge.sh/runs/run-10/review"
          }
        }
      },
      "mocks": {
        "ask": {
          "output": {
            "people": 1
          }
        },
        "check": {
          "output": {
            "run": {
              "run_id": "run-10",
              "period_start": "2026-10-01",
              "period_end": "2026-10-31",
              "pay_date": "2026-01-09",
              "run_type": "REGULAR",
              "status": "COMPUTED",
              "employee_count": 2,
              "total_gross_kobo": 50000000,
              "total_net_kobo": 42000000
            }
          }
        },
        "remind": {
          "output": {
            "people": 1
          }
        }
      },
      "expect": {
        "status": "completed",
        "inputs": {
          "ask": {
            "to": "role",
            "role": "approver",
            "message": "Chuks Electronics payroll to 2026-10-31 is ready: NGN 420000 for 2 people, paid on 2026-01-09. Review and approve it in Payrolla: https://payroller.surge.sh/runs/run-10/review"
          },
          "check": {
            "run_id": "run-10"
          }
        },
        "steps": {
          "remind": "completed"
        }
      }
    },
    {
      "name": "an approved payroll gets no reminder, and nothing is approved by Taskiem",
      "trigger": {
        "event": "run.computed",
        "body": {
          "id": "01J9Z0000000000000000000E1",
          "type": "run.computed",
          "api_version": "2026-11-01",
          "created_at": "2026-10-28T10:00:00Z",
          "company_id": "co",
          "data": {
            "run": {
              "run_id": "run-10",
              "period_start": "2026-10-01",
              "period_end": "2026-10-31",
              "pay_date": "2026-01-09",
              "run_type": "REGULAR",
              "status": "COMPUTED",
              "employee_count": 2,
              "total_gross_kobo": 50000000,
              "total_net_kobo": 42000000
            },
            "approval_url": "https://payroller.surge.sh/runs/run-10/review"
          }
        }
      },
      "mocks": {
        "ask": {
          "output": {
            "people": 1
          }
        },
        "check": {
          "output": {
            "run": {
              "run_id": "run-10",
              "period_start": "2026-10-01",
              "period_end": "2026-10-31",
              "pay_date": "2026-01-09",
              "run_type": "REGULAR",
              "status": "APPROVED",
              "employee_count": 2,
              "total_gross_kobo": 50000000,
              "total_net_kobo": 42000000
            }
          }
        }
      },
      "expect": {
        "status": "completed",
        "steps": {
          "remind": "skipped"
        },
        "calls": {
          "ask": 1
        }
      }
    }
  ]
}
