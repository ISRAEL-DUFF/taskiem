            "table": "payroll_lines",
            "filters": [
              {
                "column": "payout_id",
                "op": "eq",
                "value": "po_x"
              }
            ],
            "set": {
              "status": "reversed",
              "reason": "Beneficiary account closed"
            }
          }
        },
        "calls": {
          "pay": 2,
          "mark_reversed": 1,
          "tell_reversal": 1
        }
      }
