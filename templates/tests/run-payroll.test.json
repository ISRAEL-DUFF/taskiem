{
  "schema": "wd-test/v1",
  "template": "run-payroll",
  "params": {
    "business_name": "Adunni Bakes",
    "pay_day": 25
  },
  "cases": [
    {
      "name": "pays everyone once, records each payment and tells the owner",
      "trigger": {
        "body": {
          "period": "2026-10"
        }
      },
      "mocks": {
        "read_staff": {
          "output": {
            "rows": [
              {
                "id": 1,
                "name": "Ada Obi",
                "phone": "+2348030000001",
                "net_pay": 300000,
                "bank_code": "044",
                "account_number": "0690000031",
                "account_name": "Ada Obi",
                "active": true
              },
              {
                "id": 2,
                "name": "Bola Ade",
                "phone": "+2348030000002",
                "net_pay": 200000,
                "bank_code": "058",
                "account_number": "0123456789",
                "account_name": "Bola Ade",
                "active": true
              }
            ]
          }
        },
        "names[0].lookup": {
          "output": {
            "account_name": "ADA OBI"
          }
        },
        "names[1].lookup": {
          "output": {
            "account_name": "BOLA ADE"
          }
        },
        "balance": {
          "output": {
            "available_kobo": 90000000,
            "currency": "NGN"
          }
        },
        "record_lines": {
          "output": {
            "affected": 2
          }
        },
        "record_run": {
          "output": {
            "affected": 1
          }
        },
        "tell_now": {
          "output": {
            "via": "whatsapp"
          }
        },
        "tell_later": {
          "output": {
            "via": "sms"
          }
        },
        "tell_owner": {
          "output": {
            "people": 1
          }
        },
        "back": {
          "output": {
            "status": "none"
          }
        },
        "pay_all[0].pay": {
          "output": {
            "payout_id": "po_ada",
            "status": "settled",
            "fee_kobo": 1075
          }
        },
        "pay_all[1].pay": {
          "output": {
            "payout_id": "po_bola",
            "status": "pending",
            "fee_kobo": 1075
          }
        },
        "pay_all[1].settle": {
          "output": {
            "status": "settled",
            "settled_at": "2026-10-25T09:00:00Z"
          }
        }
      },
      "approvals": {
        "approve": {
          "decision": "approved",
          "by": "checker"
        }
      },
      "expect": {
        "status": "completed",
        "steps": {
          "pay_all[0].settle": "skipped",
          "pay_all[1].settle": "completed",
          "pay_all[0].tell_now": "completed",
          "pay_all[1].tell_later": "completed",
          "record_rejected": "skipped",
          "tell_rejected": "skipped",
          "watch[0].mark_reversed": "skipped",
          "watch[1].mark_reversed": "skipped"
        },
        "inputs": {
          "pay_all[0].pay": {
            "amount_kobo": 30000000,
            "bank_code": "044",
            "account_number": "0690000031",
            "account_name": "Ada Obi",
            "narration": "Salary 2026-10"
          },
          "pay_all[1].pay": {
            "amount_kobo": 20000000,
            "account_name": "Bola Ade"
          },
          "pay_all[0].tell_now": {
            "phone": "+2348030000001",
            "message": "Adunni Bakes: your salary for 2026-10, NGN 300000, has been paid. Thank you for your work."
          },
          "record_run": {
            "table": "payroll_runs",
            "row": {
              "period": "2026-10",
              "status": "paid",
              "staff_count": 2,
              "paid": 2,
              "failed": 0,
              "total_naira": 500000.0,
              "fees_naira": 21.5,
              "approved_by": "checker"
            }
          }
        },
        "outputs": {
          "summary": {
            "paid": 2,
            "failed": 0,
            "unconfirmed": 0,
            "paid_naira": 500000.0
          },
          "approve": {
            "decision": "approved",
            "decided_by": "checker"
          }
        },
        "calls": {
          "pay": 2,
          "back": 2,
          "mark_reversed": 0,
          "tell_reversal": 0
        }
      }
    },
