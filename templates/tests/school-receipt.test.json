{
  "schema": "wd-test/v1",
  "template": "school-receipt",
  "params": {
    "about": "school fees receipt"
  },
  "cases": [
    {
      "name": "a payment counted towards a term invoice sends the family the receipt, its check link and the fees page",
      "trigger": {
        "type": "invoice",
        "event": "payment",
        "body": {"event": "payment", "id": "0192f0a8-0000-7000-8000-000000000007", "number": "INV-0007", "status": "part_paid", "amount_kobo": 11800000, "amount": "₦118,000",
                 "paid_kobo": 4000000, "due_kobo": 7800000, "currency": "NGN", "customer": {"name": "Ngozi Eze", "phone": "+2348031234567", "email": "ngozi@example.com"},
                 "link": "https://forms.example/i/abc",
                 "payment": {"id": "0192f0a8-0000-7000-8000-0000000000p1", "amount_kobo": 4000000, "amount": "₦40,000", "how": "manual", "paid_at": "2026-10-23T08:10:00Z"},
                 "receipt": {"id": "0192f0a8-0000-7000-8000-0000000000r1", "number": "RCT-2026T1-0007", "link": "https://forms.example/r/tok"},
                 "family_link": "https://forms.example/s/fam"}
      },
      "mocks": {
        "send": {"output": {"via": "whatsapp", "over_allowance": false}}
      },
      "expect": {
        "status": "completed",
        "inputs": {
          "send": {
            "phone": "+2348031234567",
            "email": "ngozi@example.com",
            "title": "Receipt RCT-2026T1-0007",
            "about": "school fees receipt",
            "message": "Receipt RCT-2026T1-0007: we received ₦40,000 towards INV-0007 (school fees). A balance is still left on it. Check the receipt: https://forms.example/r/tok Your fees page, with the receipt and its PDF: https://forms.example/s/fam"
          }
        },
        "steps": {
          "send": "completed"
        },
        "calls": {
          "send": 1
        }
      }
    },
    {
      "name": "a payment on an invoice that is not a school's term invoice sends nothing",
      "trigger": {
        "type": "invoice",
        "event": "payment",
        "body": {"event": "payment", "id": "0192f0a8-0000-7000-8000-000000000008", "number": "INV-0008", "status": "paid", "amount_kobo": 2500050, "amount": "₦25,000.50",
                 "paid_kobo": 2500050, "due_kobo": 0, "currency": "NGN", "customer": {"name": "Ada Obi", "phone": "+2348031234567"}, "link": "https://forms.example/i/def",
                 "payment": {"id": "0192f0a8-0000-7000-8000-0000000000p2", "amount_kobo": 2500050, "amount": "₦25,000.50", "how": "exact", "paid_at": "2026-10-23T08:10:00Z"}}
      },
      "expect": {
        "status": "completed",
        "steps": {
          "send": "skipped"
        },
        "calls": {
          "send": 0
        }
      }
    }
  ]
}
