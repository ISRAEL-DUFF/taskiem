{
  "schema": "wd-test/v1",
  "template": "school-receipt",
  "params": {},
  "cases": [
    {
      "name": "a payment counted towards a term invoice sends the family the receipt, once per receipt",
      "trigger": {
        "type": "invoice",
        "event": "payment",
        "body": {"event": "payment", "id": "0192f0a8-0000-7000-8000-000000000007", "number": "INV-0007", "status": "part_paid", "amount_kobo": 11800000, "amount": "₦118,000",
                 "paid_kobo": 4000000, "due_kobo": 7800000, "currency": "NGN", "customer": {"name": "Ngozi Eze", "phone": "+2348031234567", "email": "ngozi@example.com"},
                 "link": "https://forms.example/i/abc",
                 "payment": {"id": "0192f0a8-0000-7000-8000-0000000000p1", "amount_kobo": 4000000, "amount": "₦40,000", "how": "manual", "paid_at": "2026-10-23T08:10:00Z"},
                 "receipt": {"id": "0192f0a8-0000-7000-8000-0000000000r1", "number": "RCT-2026T1-0007", "link": "https://forms.example/r/tok"},
                 "family_link": "https://forms.example/s/fam"}
      },
      "mocks": {
        "send": {"output": {"receipt_id": "0192f0a8-0000-7000-8000-0000000000r1", "number": "RCT-2026T1-0007", "student_id": "0192e2e0-0000-7000-8000-0000000000a1", "admission_number": "GCA/001",
                            "invoice_number": "INV-0007", "amount_kobo": 4000000, "channels": {"whatsapp": 1}, "nobody": false}}
      },
      "expect": {
        "status": "completed",
        "inputs": {
          "send": {
            "receipt": "0192f0a8-0000-7000-8000-0000000000r1"
          }
        },
        "steps": {
          "send": "completed"
        },
        "calls": {
          "send": 1
        }
      }
    },
    {
      "name": "a receipt that cannot be sent is noted with the reason",
      "trigger": {
        "type": "invoice",
        "event": "payment",
        "body": {"event": "payment", "id": "0192f0a8-0000-7000-8000-000000000009", "number": "INV-0009", "status": "part_paid", "amount_kobo": 11800000, "amount": "₦118,000",
                 "paid_kobo": 4000000, "due_kobo": 7800000, "currency": "NGN", "customer": {"name": "Ngozi Eze", "phone": "+2348031234567"},
                 "link": "https://forms.example/i/ghi",
                 "payment": {"id": "0192f0a8-0000-7000-8000-0000000000p3", "amount_kobo": 4000000, "amount": "₦40,000", "how": "manual", "paid_at": "2026-10-23T08:10:00Z"},
                 "receipt": {"id": "0192f0a8-0000-7000-8000-0000000000r3", "number": "RCT-2026T1-0009", "link": "https://forms.example/r/tok3"},
                 "family_link": "https://forms.example/s/fam"}
      },
      "mocks": {
        "send": {"error": {"kind": "fatal", "message": "receipt RCT-2026T1-0009 is voided: the payment was undone"}}
      },
      "expect": {
        "status": "completed",
        "steps": {
          "send": "failed",
          "not_sent": "completed"
        },
        "outputs": {
          "not_sent": {"receipt": "RCT-2026T1-0009", "reason": "receipt RCT-2026T1-0009 is voided: the payment was undone"}
        }
      }
    },
    {
      "name": "a payment on an invoice that is not a school's term invoice sends nothing",
      "trigger": {
        "type": "invoice",
        "event": "payment",
        "body": {"event": "payment", "id": "0192f0a8-0000-7000-8000-000000000008", "number": "INV-0008", "status": "paid", "amount_kobo": 2500050, "amount": "₦25,000.50",
                 "paid_kobo": 2500050, "due_kobo": 0, "currency": "NGN", "customer": {"name": "Ada Obi", "phone": "+2348031234567"}, "link": "https://forms.example/i/def",
                 "payment": {"id": "0192f0a8-0000-7000-8000-0000000000p2", "amount_kobo": 2500050, "amount": "₦25,000.50", "how": "exact", "paid_at": "2026-10-23T08:10:00Z"}}
      },
      "expect": {
        "status": "completed",
        "steps": {
          "send": "skipped"
        },
        "calls": {
          "send": 0
        }
      }
    }
  ]
}
