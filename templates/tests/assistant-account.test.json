    {
      "name": "what they owe says the credit they have",
      "trigger": {
        "body": {
          "via": "whatsapp",
          "sender": "2348031234567",
          "text": "What do I owe?",
          "language": "en"
        }
      },
      "mocks": {
        "acct": {
          "output": {
            "rows": []
          }
        },
        "classify": {
          "output": {
            "intent": "payment_status"
          }
        },
        "owed": {
          "output": {
            "found": true,
            "customer_name": "Ada",
            "due_kobo": 500000,
            "due": "₦5,000",
            "credit_kobo": 200000,
            "credit": "₦2,000",
            "open": [
              {
                "number": "INV-0002",
                "status": "sent",
                "due_kobo": 500000,
                "due": "₦5,000"
              }
            ]
          }
        }
      },
      "expect": {
        "status": "completed",
        "outputs": {
          "facts": {
            "text": "This customer asked about what they owe or their payments. Their invoices with the business, under their number: they owe ₦5,000 on 1 open invoice(s): INV-0002 ₦5,000. They also have ₦2,000 paid in that no invoice has taken yet."
          }
        }
      }
    }
