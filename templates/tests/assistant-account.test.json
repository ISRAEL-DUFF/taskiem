        "acct": {
          "output": {
            "rows": [
              {
                "id": 1,
                "channel": "whatsapp",
                "sender": "2348031234567",
                "account": "c-ada"
              }
            ]
          }
        },
        "classify": {
          "output": {
            "intent": "balance"
          }
        },
        "bal": {
          "output": {
            "available_kobo": -15050,
            "currency": "NGN"
          }
        }
      },
      "expect": {
        "status": "completed",
        "outputs": {
          "facts": {
            "text": "This customer asked about their balance. Their balance, read just now from their own account: -150.50 naira."
          }
        }
      }
    },
