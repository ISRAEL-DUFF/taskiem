        "event": "paid",
        "body": {
          "event": "paid",
          "number": "INV-0011",
          "status": "paid",
          "amount_kobo": 50000,
          "customer": {
            "name": "Chidi Eze",
            "phone": "+2348030000003"
          }
        }
      },
      "mocks": {
        "find": {
          "output": {
            "rows": [
              {
                "name": "Chidi Eze",
                "phone": "+2348030000003",
                "plan": "Home 5Mbps",
                "monthly_naira": 8000,
                "renews_on": "2025-12-20T00:00:00Z",
