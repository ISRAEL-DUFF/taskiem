{
  "schema": "wd-test/v1",
  "template": "chase-overdue-invoices",
  "params": {
    "send_time": "09:00",
    "every_days": 3,
    "reminders": 3,
    "per_customer": false
  },
  "cases": [
    {
      "name": "customers are reminded every three days, and the owner once after the last reminder",
      "mocks": {
        "overdue": {
          "output": {
            "count": 3,
            "invoices": [
              {"number": "INV-0003", "status": "overdue", "total": "₦25,000", "total_kobo": 2500000, "due": "₦25,000", "due_kobo": 2500000, "due_on": "2026-10-22", "days_overdue": 1},
              {"number": "INV-0002", "status": "overdue", "total": "₦10,000", "total_kobo": 1000000, "due": "₦4,000", "due_kobo": 400000, "due_on": "2026-10-18", "days_overdue": 5},
              {"number": "INV-0001", "status": "overdue", "total": "₦8,000", "total_kobo": 800000, "due": "₦8,000", "due_kobo": 800000, "due_on": "2026-10-13", "days_overdue": 10}
            ]
          }
        },
        "chase_each[0].remind": {"output": {"number": "INV-0003", "queued": ["sms"]}},
        "chase_each[1].remind": {"output": {"number": "INV-0002", "queued": ["sms", "email"]}},
        "chase_each[2].tell_owner": {"output": {"people": 1, "chat": 1, "email": 0, "nobody": false}}
      },
      "expect": {
        "status": "completed",
        "inputs": {
          "overdue": {"status": "overdue", "limit": 200},
          "chase_each[0].remind": {
            "number": "INV-0003",
            "text": "A reminder that invoice {number} is overdue: {due} is still due. See it and pay: {link}",
            "subject": "INV-0003 is overdue"
          },
          "chase_each[1].remind": {"number": "INV-0002"},
          "chase_each[2].tell_owner": {
            "title": "Invoice still unpaid",
            "message": "Invoice INV-0001 is 10 days overdue after 3 reminders: ₦8,000 still due."
          }
        },
        "steps": {
          "chase_each[0].remind": "completed",
          "chase_each[0].tell_owner": "skipped",
          "chase_each[1].remind": "completed",
          "chase_each[1].tell_owner": "skipped",
          "chase_each[2].remind": "skipped",
          "chase_each[2].tell_owner": "completed"
        },
        "calls": {
          "remind": 2,
          "tell_owner": 1
        }
      }
    },
    {
      "name": "a reminder that cannot go does not stop the others",
      "mocks": {
        "overdue": {
          "output": {
            "count": 2,
            "invoices": [
              {"number": "INV-0005", "status": "overdue", "total": "₦5,000", "total_kobo": 500000, "due": "₦5,000", "due_kobo": 500000, "due_on": "2026-10-20", "days_overdue": 3},
              {"number": "INV-0006", "status": "overdue", "total": "₦6,000", "total_kobo": 600000, "due": "₦6,000", "due_kobo": 600000, "due_on": "2026-10-19", "days_overdue": 4}
            ]
          }
        },
        "chase_each[0].remind": {"error": {"kind": "fatal", "message": "invoice INV-0005 is void"}},
        "chase_each[1].remind": {"output": {"number": "INV-0006", "queued": ["sms"]}}
      },
      "expect": {
        "status": "completed",
        "steps": {
          "chase_each[0].remind_failed": "completed",
          "chase_each[1].remind": "completed"
        },
        "outputs": {
          "chase_each[0].remind_failed": {"number": "INV-0005", "reason": "invoice INV-0005 is void"}
        }
      }
    },
    {
      "name": "one message per customer: what they owe on everything overdue, and the owner once after the last reminder",
      "params": {"per_customer": true},
      "mocks": {
        "overdue_customers": {
          "output": {
            "count": 2,
            "customers": [
              {"customer": "key:book:1", "number": "INV-0004", "lines": 2, "due_kobo": 800000, "due": "₦8,000", "due_on": "2026-10-22", "days_overdue": 1},
              {"customer": "subj_x", "number": "INV-0001", "lines": 1, "due_kobo": 500000, "due": "₦5,000", "due_on": "2026-10-13", "days_overdue": 10}
            ]
          }
        },
        "chase_customers[0].remind_customer": {"output": {"number": "INV-0004", "queued": ["sms"], "sent": true}},
        "chase_customers[1].tell_owner_customer": {"output": {"people": 1, "chat": 1, "email": 0, "nobody": false}}
      },
      "expect": {
        "status": "completed",
        "inputs": {
          "overdue_customers": {"status": "overdue", "group": "customer", "limit": 200},
          "chase_customers[0].remind_customer": {
            "number": "INV-0004",
            "text": "A reminder: {customer_due} is overdue on {customer_lines} item(s). See what you owe and pay: {customer_link}",
            "subject": "Overdue: {customer_due}"
          },
          "chase_customers[1].tell_owner_customer": {
            "title": "A customer still owes you",
            "message": "A customer still owes ₦5,000 on 1 item(s), the oldest INV-0001, 10 days overdue after 3 reminders."
          }
        },
        "steps": {
          "overdue": "skipped",
          "chase_each": "skipped",
          "chase_customers[0].remind_customer": "completed",
          "chase_customers[0].tell_owner_customer": "skipped",
          "chase_customers[1].remind_customer": "skipped",
          "chase_customers[1].tell_owner_customer": "completed"
        },
        "calls": {
          "remind": 0,
          "remind_customer": 1,
          "tell_owner_customer": 1
        }
      }
    },
    {
      "name": "one message per customer: a customer with no phone yet is not a failure",
      "params": {"per_customer": true},
      "mocks": {
        "overdue_customers": {"output": {"count": 1, "customers": [
          {"customer": "key:book:2", "number": "INV-0009", "lines": 1, "due_kobo": 300000, "due": "₦3,000", "due_on": "2026-10-20", "days_overdue": 3}
        ]}},
        "chase_customers[0].remind_customer": {"output": {"number": "INV-0009", "queued": [], "sent": false, "reason": "no_address"}}
      },
      "expect": {
        "status": "completed",
        "steps": {
          "chase_customers[0].remind_customer": "completed"
        }
      }
    },
    {
      "name": "no overdue invoices: nothing is sent",
      "mocks": {
        "overdue": {"output": {"count": 0, "invoices": []}}
      },
      "expect": {
        "status": "completed",
        "calls": {
          "remind": 0,
          "tell_owner": 0
        }
      }
    }
  ]
}
